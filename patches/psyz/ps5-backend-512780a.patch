+        Pe2BackgroundPresent(source.stripHash,16,240,0,source.cropY,source.generation,rect))return;
+    Pe2BackgroundPresent(source.sourceHash,source.sourceWidth,source.sourceHeight,
+                        source.cropX,source.cropY,source.generation,rect);
+}
+static void Pe2BackgroundQuit(void)
+{
+    /* Terminal deferred releases before device destruction. */
+    Pe2WideRelease();
+    for(unsigned i=0;i<pe2_bg_count;i++)if(pe2_bg_records[i].texture)SDL_ReleaseGPUTexture(device,pe2_bg_records[i].texture);
+    if(pe2_bg_pipeline)SDL_ReleaseGPUGraphicsPipeline(device,pe2_bg_pipeline);
