+    if(!metrics||!count||count>CAP_METRIC_CELLS||foreground>15||style<PSYZ_FONT_RETRO||style>PSYZ_FONT_ATKINSON||
+       !device||UseSoftwareBackend()||Psyz_VideoGetInternalResolution()<=1||
+       !Psyz_FontIdentityRegion(token,&region)||!Psyz_FontIdentityAcquire(&region,&identity,&current))return 0;
+    for(unsigned i=0;i<count;++i){const PsyzCapFontMetric *m=&metrics[i];
+        if(m->cell>=1024||(i&&m->cell<=metrics[i-1].cell)||m->character<32||m->character>126||
+           !m->width||!m->height||m->width>64||m->height>64||m->u<region.u||m->v<region.v||
+           m->u+m->width>=256||m->v+m->height>=256||m->u+m->width>region.u+region.w||m->v+m->height>region.v+region.h||
+           m->baseline!=m->height||m->advance!=m->width-1)return 0;
+    }
