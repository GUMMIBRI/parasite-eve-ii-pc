+    if(image.bytes>PE2_BG_BYTES-pe2_bg_bytes){Pe2BackgroundFree(&image);return r;}
+    SDL_GPUTextureCreateInfo tex={0};
+    tex.type=SDL_GPU_TEXTURETYPE_2D;tex.format=SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+    tex.usage=SDL_GPU_TEXTUREUSAGE_SAMPLER;tex.width=image.width;tex.height=image.height;
+    tex.layer_count_or_depth=tex.num_levels=1;
+    SDL_GPUTexture *texture=SDL_CreateGPUTexture(device,&tex);
+    SDL_GPUTransferBufferCreateInfo transfer={.usage=SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,.size=(Uint32)image.bytes};
+    SDL_GPUTransferBuffer *upload=texture?SDL_CreateGPUTransferBuffer(device,&transfer):NULL;
+    void *mapped=upload?SDL_MapGPUTransferBuffer(device,upload,false):NULL;
+    if(!mapped){if(upload)SDL_ReleaseGPUTransferBuffer(device,upload);if(texture)SDL_ReleaseGPUTexture(device,texture);Pe2BackgroundFree(&image);pe2_bg_failed=1;return r;}
+    memcpy(mapped,image.rgba,image.bytes);SDL_UnmapGPUTransferBuffer(device,upload);
+    SDL_GPUCommandBuffer *cmd=AcquireCmd();SDL_GPUCopyPass *copy=cmd?SDL_BeginGPUCopyPass(cmd):NULL;
+    if(!copy){SDL_ReleaseGPUTransferBuffer(device,upload);SDL_ReleaseGPUTexture(device,texture);Pe2BackgroundFree(&image);pe2_bg_failed=1;return r;}
+    SDL_GPUTextureTransferInfo from={.transfer_buffer=upload,.pixels_per_row=image.width,.rows_per_layer=image.height};
+    SDL_GPUTextureRegion to={.texture=texture,.w=image.width,.h=image.height,.d=1};
+    SDL_UploadToGPUTexture(copy,&from,&to,false);SDL_EndGPUCopyPass(copy);
