diff --git a/psyz/include/psyz/cap_font.h b/psyz/include/psyz/cap_font.h
new file mode 100644
index 0000000000000000000000000000000000000000..47285be1bdf6ed34f4116a2c1c4406290a017547
--- /dev/null
+++ b/psyz/include/psyz/cap_font.h
@@ -0,0 +1,55 @@
+/* MPL-2.0. Source-bound native CAP font presentation interfaces. */
+#ifndef PSYZ_CAP_FONT_H
+#define PSYZ_CAP_FONT_H
+#include <stdint.h>
+#include <stddef.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    unsigned page, clut, u, v, w, h;
+} PsyzFontRegion;
+typedef struct {
+    uint64_t texture[2], palette[2]; /* XXH3-128 low64/high64; canonical LE rows. */
+} PsyzFontIdentity;
+typedef struct {
+    uint64_t serial;
+    uint32_t slot, reserved;
+} PsyzFontToken;
+/* Hash utility has no renderer/init dependency. Never hashes inferred pixels. */
+void Psyz_FontHash128(const void *data, size_t bytes, uint64_t output[2]);
+/* Acquire succeeds only for known, backend-accepted original words/palette. */
+int Psyz_FontIdentityAcquire(const PsyzFontRegion *region,
+                            PsyzFontIdentity *identity, PsyzFontToken *token);
+int Psyz_FontIdentityValidate(const PsyzFontToken *token);
+/* Copies registered metadata only while its slot/serial is still valid. */
+int Psyz_FontIdentityRegion(const PsyzFontToken *token, PsyzFontRegion *region);
+int Psyz_FontIdentityForeground(const PsyzFontToken *token, unsigned index,
+                                uint16_t *word);
+#ifdef PE2_PS5_HOST
+/* Actual horizontal CAP producer: crop bottom is baseline; advance width-1.
+ * Sparse authenticated mapping records are copied by value, never inferred. */
+typedef struct {
+    unsigned cell, character, u, v, width, height, baseline, advance;
+} PsyzCapFontMetric;
+uint64_t Psyz_GpuPreparePlexCapMetrics(const PsyzCapFontMetric* metrics,unsigned count,
+                                     unsigned foreground,const PsyzFontToken* token);
+int Psyz_GpuPlexCapMetricSupports(uint64_t key,unsigned cell);
+int Psyz_GpuPreparePlexCapMetricRun(uint64_t key,unsigned glyphPairs);
+void Psyz_GpuMarkPlexCapMetricPair(const void* addPayload,const void* subPayload,
+                                 uint64_t key,unsigned cell,const PsyzFontToken* token);
+#endif
+/* Payload starts at packet r0, same ownership seam as the existing UI API.
+ * The implementation copies token by value; character0 explicitly clears tags.
+ * CAP supports P4 foreground indices0..15, printable ASCII, and semantic mode7. */
+void Psyz_GpuMarkPlexCap(const void *payload, unsigned character,
+                       unsigned foregroundIndex, const PsyzFontToken *token);
+/* Preflight the complete run before emitting either glyph in any pair. */
+int Psyz_GpuPreparePlexCapRun(unsigned glyphPairs);
+void Psyz_GpuMarkPlexCapPair(const void *addPayload, const void *subPayload,
+                           unsigned character, unsigned foregroundIndex,
+                           const PsyzFontToken *token);
+#ifdef __cplusplus
+}
+#endif
+#endif
