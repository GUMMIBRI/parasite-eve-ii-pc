+/* MPL-2.0. Optional authenticated CAP per-resource metric presentation.
+ * All source pixels/semantic mappings are runtime private inputs, never exports. */
+#ifndef PE2_CAP_METRICS_H
+#define PE2_CAP_METRICS_H
+#include <limits.h>
+enum { CAP_METRIC_RECORDS=24, CAP_METRIC_CELLS=1024 };
+typedef struct {
+    unsigned style,count,foreground;
+    uint64_t key;
+    PsyzCapFontMetric *metrics;
+    unsigned char *supported;
+    PsyzFontRegion region;
+    PsyzFontIdentity identity;
+    PsyzFontToken token;
+} PlexCapMetric;
+static PlexCapMetric plex_cap_metrics[CAP_METRIC_RECORDS];
+static unsigned plex_cap_metric_count;
+static uint64_t plex_cap_metric_serial=1;
+static int PlexCapMetricSame(const PlexCapMetric *f,const PsyzCapFontMetric *m,unsigned count)
+{
+    if(f->count!=count)return 0;
+    for(unsigned i=0;i<count;++i){const PsyzCapFontMetric *a=&f->metrics[i],*b=&m[i];
+        if(a->cell!=b->cell||a->character!=b->character||a->u!=b->u||a->v!=b->v||a->width!=b->width||
+           a->height!=b->height||a->baseline!=b->baseline||a->advance!=b->advance)return 0;
+    }return 1;
+}
+static PlexCapMetric *PlexCapMetricFind(uint64_t key)
+{
+    if(!key)return NULL;
+    for(unsigned i=0;i<plex_cap_metric_count;++i)if(plex_cap_metrics[i].key==key)return &plex_cap_metrics[i];
+    return NULL;
+}
+/* -1: unknown or non-monochrome original; 0: empty; 1: exact selected ink.
+ * Palette aliases with identical original words have identical visible ink;
+ * no guessed nibble/foreground or OCR decision is made. */
+static int PlexCapMetricInk(const PlexCapMetric *f,const PsyzCapFontMetric *m,int bounds[4])
+{
+    uint16_t foreground;
+    if(!Psyz_FontIdentityForeground(&f->token,f->foreground,&foreground)||!foreground)return -1;
+    bounds[0]=m->width;bounds[1]=m->height;bounds[2]=bounds[3]=-1;
+    for(unsigned y=0;y<m->height;++y)for(unsigned x=0;x<m->width;++x){uint16_t word;
+        if(!Psyz_FontIdentitySample(f->region.page,f->region.clut,m->u+x,m->v+y,&word))return -1;
+        if(!word)continue;if(word!=foreground)return -1;
+        bounds[0]=SDL_min(bounds[0],(int)x);bounds[1]=SDL_min(bounds[1],(int)y);
+        bounds[2]=SDL_max(bounds[2],(int)x);bounds[3]=SDL_max(bounds[3],(int)y);
+    }return bounds[2]>=bounds[0]&&bounds[3]>=bounds[1];
+}
+static int PlexCapMetricRaster(SDL_Surface *surface,const stbtt_fontinfo *font,const PlexCapMetric *f,
+                               unsigned index,float scaleY)
+{
+    const PsyzCapFontMetric *m=&f->metrics[index];int ink[4];int known=PlexCapMetricInk(f,m,ink);
+    if(m->character==32)return known==0;
+    if(known!=1||!stbtt_FindGlyphIndex(font,m->character))return 0;
+    int fx0,fy0,fx1,fy1;
+    if(!stbtt_GetCodepointBox(font,m->character,&fx0,&fy0,&fx1,&fy1)||fx1<=fx0)return 0;
+    float sx=(ink[2]-ink[0]+0.5f)/(fx1-fx0)*64.0f/m->width;
+    float sy=scaleY*64.0f/m->height;
+    int x0,y0,x1,y1;
+    /* Font bearing cannot change the original CAP advance. Fit actual visible
+     * ink horizontally; one shared Y scale and literal source bottom baseline. */
+    for(unsigned attempt=0;attempt<3;++attempt){
+        stbtt_GetCodepointBitmapBox(font,m->character,sx,sy,&x0,&y0,&x1,&y1);
+        float room=(ink[2]-ink[0]+0.5f)*64.0f/m->width;
