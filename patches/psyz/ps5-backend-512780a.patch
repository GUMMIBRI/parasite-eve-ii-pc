+}
+static int Pe2BackgroundPass(SDL_GPUCommandBuffer *cmd,SDL_GPUTexture *target,
+                            Pe2BackgroundRecord *image,const PS1_RECT *rect,unsigned source_x,unsigned source_y)
+{
+    SDL_GPUColorTargetInfo color={.texture=target,.load_op=SDL_GPU_LOADOP_LOAD,.store_op=SDL_GPU_STOREOP_STORE};
+    SDL_GPURenderPass *pass=SDL_BeginGPURenderPass(cmd,&color,1,NULL);if(!pass)return 0;
+    SDL_BindGPUGraphicsPipeline(pass,pe2_bg_pipeline);
+    SDL_GPUTextureSamplerBinding bindings[2]={{image->texture,pe2_bg_sampler},{vram_render,pe2_bg_sampler}};
+    SDL_BindGPUFragmentSamplers(pass,0,bindings,2);
+    SDL_GPUViewport viewport={(float)(rect->x*internal_res),(float)(rect->y*internal_res),(float)(rect->w*internal_res),(float)(rect->h*internal_res),0,1};
+    SDL_SetGPUViewport(pass,&viewport);
+    const float params[12]={viewport.x,viewport.y,viewport.w,viewport.h,
+        (float)source_x/image->source_w,(float)source_y/image->source_h,
+        (float)rect->w/image->source_w,(float)rect->h/image->source_h,(float)internal_res,0,0,0};
+    SDL_PushGPUFragmentUniformData(cmd,0,params,sizeof params);
+    SDL_DrawGPUPrimitives(pass,3,1,0,0);SDL_EndGPURenderPass(pass);return 1;
+}
+static int Pe2BackgroundPresent(const uint64_t hash[2],unsigned source_w,unsigned source_h,
+                                 unsigned source_x,unsigned source_y,uint64_t generation,const PS1_RECT *rect)
+{
+    if(!pe2_bg_enabled||!pe2_bg_root[0]||!device||UseSoftwareBackend()||internal_res<=1||!scaled_vram_render)return 0;
+    if(!generation||!rect||source_x>source_w||source_y>source_h||rect->w<=0||rect->h<=0||
+        (unsigned)rect->w>source_w-source_x||(unsigned)rect->h>source_h-source_y)return 0;
+    if(pe2_bg_generation!=generation){
+        int retired=Pe2BackgroundRetire();pe2_bg_generation=generation;
+        if(!retired)return 0;
+    }
+    if(pe2_bg_failed)return 0;
+    Pe2BackgroundRecord *image=Pe2BackgroundImage(hash,source_w,source_h);
+    if(!image||!image->texture)return 0;
+    if(!Pe2BackgroundPipeline()){pe2_bg_failed=1;return 0;}
+    SDL_GPUCommandBuffer *cmd=ReserveDrawDescriptors(2);
+    if(!cmd||pe2_bg_failed){pe2_bg_failed=1;return 0;}
+    if(!Pe2BackgroundPass(cmd,scaled_vram_render,image,rect,source_x,source_y)){pe2_bg_failed=1;return 0;}
+    if(interpolated_vram&&interpolated_scale==internal_res&&
+        !Pe2BackgroundPass(cmd,interpolated_vram,image,rect,source_x,source_y)){pe2_bg_failed=1;return 0;}
+    pe2_bg_hits++;
+    return 1;
+}
+static void Pe2BackgroundAccept(const PS1_RECT *rect,const uint16_t *pixels,int derivedSync)
+{
+    /* Exactly one owner lookup, independent of ordinary HD preference.
+     * Caller has recorded original raw upload and Sync without failure. */
+    PsyzHdBackgroundUpload source={0};
+    int known=pe2_bg_lookup && pe2_bg_lookup(pixels,rect->x,rect->y,rect->w,rect->h,&source) &&
+        source.cropWidth==(unsigned)rect->w && source.cropHeight==(unsigned)rect->h;
+    if(pe2_bg_frame.active || (rect->x<320 && rect->x+rect->w>0 &&
+       ((rect->y<240 && rect->y+rect->h>0) ||
+        (rect->y<512 && rect->y+rect->h>272)))){
+        if(pe2_wide_touched)pe2_wide_native_fallback=1;
+        memset(pe2_bg_complete,0,sizeof pe2_bg_complete);
+        Pe2BackgroundDrawLayoutClear();
+    }
+    int accepted=Pe2BackgroundFrameAccept(&pe2_bg_frame,known?&source:NULL,
+        rect->x,rect->y,rect->w,rect->h,pe2_bg_native_epoch,pe2_bg_failure_serial);
+    if(accepted){
+        SDL_GPUTexture *mid=interpolated_scale==internal_res?interpolated_vram:NULL;
+        if(!derivedSync||!vram_render||!scaled_vram_render||internal_res<=1)
+            pe2_bg_clean_sync.failed=1;
+        if(!pe2_bg_clean_sync.mask){
+            pe2_bg_clean_sync.native=vram_render;pe2_bg_clean_sync.target=scaled_vram_render;
+            pe2_bg_clean_sync.interpolated=mid;pe2_bg_clean_sync.scale=internal_res;
+        }else if(pe2_bg_clean_sync.native!=vram_render||pe2_bg_clean_sync.target!=scaled_vram_render||
+                 pe2_bg_clean_sync.interpolated!=mid||pe2_bg_clean_sync.scale!=internal_res)
+            pe2_bg_clean_sync.failed=1;
+        pe2_bg_clean_sync.mask|=rect->w==320?PE2_BACKGROUND_FRAME_COLUMNS:1u<<(source.cropX/16);
+    }
+    /* Ordinary HD retains its original lookup result and setting semantics. */
+    if(!known||!pe2_bg_enabled||!pe2_bg_root[0]||internal_res<=1)return;
