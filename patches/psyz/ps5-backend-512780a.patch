+    pending.region=region;pending.identity=identity;pending.token=current;
+    pending.metrics=malloc(count*sizeof(*metrics));pending.supported=calloc(count,1);
+    if(!pending.metrics||!pending.supported){free(pending.metrics);free(pending.supported);return 0;}
+    memcpy(pending.metrics,metrics,count*sizeof(*metrics));
+    unsigned anchor=UINT_MAX;
+    for(unsigned i=0;i<count;++i)if(metrics[i].character=='H'){
+        if(anchor!=UINT_MAX)goto reject;anchor=i;
+    }
+    /* No mapped H or ambiguous H => no source-owned common cap-height. */
+    if(anchor==UINT_MAX)goto reject;
+    int ink[4];const unsigned char *data=PlexProfileData(style);stbtt_fontinfo font;
+    if(!data)goto reject;int offset=stbtt_GetFontOffsetForIndex(data,0);
+    if(offset<0||!stbtt_InitFont(&font,data,offset)||PlexCapMetricInk(&pending,&metrics[anchor],ink)!=1)goto reject;
+    int x0,y0,x1,y1;
+    if(!stbtt_GetCodepointBox(&font,'H',&x0,&y0,&x1,&y1)||y1<=y0)goto reject;
+    float scale=(ink[3]-ink[1]+0.5f)/(y1-y0);
+    unsigned rows=(count+15)/16;
+    SDL_Surface *surface=SDL_CreateSurface(16*68,rows*68*2,SDL_PIXELFORMAT_RGBA32);
+    if(!surface)goto reject;
+    SDL_memset(surface->pixels,0,(size_t)surface->pitch*surface->h);
+    for(unsigned i=0;i<count;++i)pending.supported[i]=(unsigned char)PlexCapMetricRaster(surface,&font,&pending,i,scale);
+    if(!Psyz_FontIdentityValidate(&current)){SDL_DestroySurface(surface);goto reject;}
+    pending.key=UINT64_C(0x5045324341500000)|plex_cap_metric_serial++;
+    if(LoadSpriteAtlasSurface(pending.key,surface)!=1)goto reject;
+    plex_cap_metrics[plex_cap_metric_count++]=pending;return pending.key;
+reject:
+    free(pending.metrics);free(pending.supported);return 0;
+}
+int Psyz_GpuPlexCapMetricSupports(uint64_t key,unsigned cell)
+{
+    PlexCapMetric *f=PlexCapMetricFind(key);
+    if(!f||f->style!=plex_font_styles[PSYZ_FONT_DIALOGUE]||Psyz_VideoGetInternalResolution()<=1||!Psyz_FontIdentityValidate(&f->token))return 0;
+    for(unsigned i=0;i<f->count;++i)if(f->metrics[i].cell==cell)return f->supported[i];return 0;
+}
+int Psyz_GpuPreparePlexCapMetricRun(uint64_t key,unsigned glyphPairs)
+{
+    plex_cap_reserved=0;PlexCapMetric *f=PlexCapMetricFind(key);
+    if(!f||!glyphPairs||glyphPairs>4096||!Psyz_FontIdentityValidate(&f->token)||!PlexCapacity(glyphPairs*2))return 0;
+    plex_cap_reserved=glyphPairs*2;return 1;
+}
+void Psyz_GpuMarkPlexCapMetricPair(const void *addPayload,const void *subPayload,
+                                 uint64_t key,unsigned cell,const PsyzFontToken *token)
+{
