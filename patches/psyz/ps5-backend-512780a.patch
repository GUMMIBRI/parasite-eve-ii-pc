diff --git a/psyz/src/platform/pe2_background_render.h b/psyz/src/platform/pe2_background_render.h
new file mode 100644
index 0000000000000000000000000000000000000000..ba6e99ee8ae658d077997114e2dcdf675d2e8117
--- /dev/null
+++ b/psyz/src/platform/pe2_background_render.h
@@ -0,0 +1,318 @@
+#include <errno.h>
+#include <stdio.h>
+/* SPDX-License-Identifier: MPL-2.0
+ * Native PE2 exact-source still presentation. Included after movie shader and
+ * original VRAM helpers. The original VRAM and character atlas are untouched. */
+#include "shaders/pe2_background_spv.h"
+#include "pe2_background_cpu.h"
+#include <psyz/hd_background.h>
+#include <psyz/gpu.h>
+#define PE2_BG_RECORDS 64u
+#define PE2_BG_BYTES (32u*1024u*1024u)
+typedef struct {
+    uint64_t hash[2];
+    unsigned source_w,source_h,width,height;
+    SDL_GPUTexture *texture;
+} Pe2BackgroundRecord;
+static Pe2BackgroundRecord pe2_bg_records[PE2_BG_RECORDS];
+static unsigned pe2_bg_count,pe2_bg_bytes,pe2_bg_hits;
+static uint64_t pe2_bg_generation;
+static char pe2_bg_root[1024];
+static int pe2_bg_enabled=1,pe2_bg_failed;
+static SDL_GPUSampler *pe2_bg_sampler;
+static SDL_GPUGraphicsPipeline *pe2_bg_pipeline;
+static PsyzHdBackgroundLookup pe2_bg_lookup;
+/* Real accepted-native-copy frame bridge. No scene/art admission yet. */
+static Pe2BackgroundFrameCollector pe2_bg_frame;
+static Pe2BackgroundFrameReceipt pe2_bg_complete[2];
+static uint64_t pe2_bg_native_epoch=1;
+/* Only populated after the real ORIGINAL-copy path records every currently
+ * used derived target. A CPU-owned source descriptor alone cannot grant it. */
+static struct {
+    SDL_GPUTexture *native,*target,*interpolated;
+    unsigned scale,mask;
+    int failed;
+} pe2_bg_clean_sync;
+static void Pe2WideRelease(void);
+static int Pe2WideCommit(const Pe2BackgroundFrameReceipt *frame);
+static void Pe2BackgroundUploadRejected(void)
+{
+    if(pe2_wide_touched)pe2_wide_native_fallback=1;
+    Pe2BackgroundFrameInvalidate(&pe2_bg_frame);
+    memset(&pe2_bg_clean_sync,0,sizeof pe2_bg_clean_sync);
+    memset(pe2_bg_complete,0,sizeof pe2_bg_complete);
+    Pe2BackgroundDrawLayoutClear();
+}
+static void Pe2BackgroundFrameReset(int newEpoch)
+{
+    Pe2BackgroundUploadRejected();
+    if(newEpoch && pe2_bg_native_epoch!=UINT64_MAX)++pe2_bg_native_epoch;
+}
+void Psyz_GpuBackgroundFrameBegin(const PsyzHdBackgroundFrame *frame)
+{
+    /* Drain previous GP0/parsed drawing while its admission is still valid. */
+    uint64_t failureBefore=pe2_bg_failure_serial;
+    Draw_FlushBuffer();
+    if(Psyz_GpuExeque()!=0){Pe2BackgroundFailure();return;}
+    if(failureBefore!=pe2_bg_failure_serial)return;
+    if(pe2_wide_touched)pe2_wide_native_fallback=1;
+    memset(&pe2_bg_clean_sync,0,sizeof pe2_bg_clean_sync);
+    memset(pe2_bg_complete,0,sizeof pe2_bg_complete);
+    Pe2BackgroundDrawLayoutClear();
+    if(pe2_bg_native_epoch==UINT64_MAX || pe2_bg_failure_serial==UINT64_MAX)return;
+    Pe2BackgroundFrameBegin(&pe2_bg_frame,frame,pe2_bg_native_epoch,pe2_bg_failure_serial);
+}
+void Psyz_GpuBackgroundFrameEnd(uint64_t serial)
+{
+    Pe2BackgroundFrameReceipt complete={0};
+    if(!Pe2BackgroundFrameFinish(&pe2_bg_frame,serial,pe2_bg_native_epoch,pe2_bg_failure_serial,&complete))return;
+    unsigned bank=complete.nativeY==PE2_BACKGROUND_SECOND_BANK_Y;
+    pe2_bg_complete[bank]=complete;
+    int wide=Pe2WideCommit(&complete);
+    /* Return0 means no live wide target was touched. -1 means attempted live
+     * commit and MUST NOT fall back to the pre-commit clean overwrite proof. */
+    if(wide==0&&!pe2_bg_clean_sync.failed&&
+       pe2_bg_clean_sync.mask==PE2_BACKGROUND_FRAME_COLUMNS&&
+       complete.nativeEpoch==pe2_bg_native_epoch&&complete.failureSerial==pe2_bg_failure_serial)
+        Pe2BackgroundCleanBankAdmit(&complete,pe2_bg_native_epoch,pe2_bg_failure_serial,
+            pe2_bg_clean_sync.native,pe2_bg_clean_sync.target,
+            pe2_bg_clean_sync.interpolated,pe2_bg_clean_sync.scale);
+}
+static void Pe2BackgroundFailure(void)
+{
+    Pe2BackgroundUploadRejected();
+    pe2_bg_failed=1;
+    Pe2Fsr1Failure();
+    Psyz_MoviePolicySubmissionFailed(&pe2_movie_policy);
+    Psyz_GpuResetInterpolation();
+    if(pe2_bg_failure_serial!=UINT64_MAX)++pe2_bg_failure_serial;
+}
+void Psyz_GpuSetHdBackgroundLookup(PsyzHdBackgroundLookup lookup)
+{
+    /* No draw descriptor survives this synchronous source owner. Cached GPU
+     * images are immutable and can stay allocated until the next safe epoch. */
+    Pe2BackgroundUploadRejected();
+    pe2_bg_lookup=lookup;
+    if(!lookup)pe2_bg_hits=0;
+}
+
+/* Only called at settings/source-upload boundaries, never inside primitive
+ * assembly. A failed retirement preserves all old readers and allocations. */
+static int Pe2BackgroundRetire(void)
+{
+    if(device){
+        Draw_FlushBuffer();
+        if(pending_cmd && !SubmitCmd()){Pe2BackgroundFailure();return 0;}
+        if(!SDL_WaitForGPUIdle(device)){Pe2BackgroundFailure();return 0;}
+        Pe2WideRelease();
+        for(unsigned i=0;i<pe2_bg_count;i++)if(pe2_bg_records[i].texture)
+            SDL_ReleaseGPUTexture(device,pe2_bg_records[i].texture);
+    }
+    memset(pe2_bg_records,0,sizeof pe2_bg_records);
+    pe2_bg_count=pe2_bg_bytes=pe2_bg_hits=0;
+    pe2_bg_failed=0;
+    return 1;
+}
+int Psyz_GpuSetHdBackgrounds(int enabled,const char *root)
+{
+    /* Root selection is independent of ordinary HD enablement. A failed
+     * new-disc selection must never leave prior-disc wide art selectable. */
+    Draw_FlushBuffer();
+    if(Psyz_GpuExeque()!=0){Pe2BackgroundFailure();return -1;}
+    pe2_bg_root_selected=0;
+    if(root && *root && strcmp(root,pe2_bg_root)){
+        if(strlen(root)>=sizeof pe2_bg_root)return -1;
+        char index[1200];
+        if(SDL_snprintf(index,sizeof index,"%s/upload-index.txt",root)>=(int)sizeof index)return -1;
+        FILE *f=fopen(index,"rb");if(!f)return -1;fclose(f);
+        if(!Pe2BackgroundRetire())return -1;
+        SDL_strlcpy(pe2_bg_root,root,sizeof pe2_bg_root);
+        pe2_bg_generation=0;
+    }
+    if(enabled && !pe2_bg_root[0])return -1;
+    pe2_bg_root_selected=root && *root && pe2_bg_root[0];
+    pe2_bg_enabled=!!enabled;
+    return 0;
+}
+int Psyz_GpuGetHdBackgrounds(void){return pe2_bg_enabled;}
+const char *Psyz_GpuHdBackgroundsStatus(void)
+{
+    if(!pe2_bg_enabled)return "Off";
+    if(!pe2_bg_root[0])return "Pack unavailable";
+    if(UseSoftwareBackend())return "Hardware renderer required";
+    if(!scaled_vram_render||internal_res<=1)return "Needs render scale above 1x";
+    if(pe2_bg_failed)return "Original fallback (GPU resource failure)";
+    return pe2_bg_hits?"Exact still replacements queued":"Waiting for exact still replacement";
