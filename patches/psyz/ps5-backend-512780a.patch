diff --git a/psyz/src/platform/shaders/pe2_wide_background.frag.glsl b/psyz/src/platform/shaders/pe2_wide_background.frag.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..db74491cc5038d48e522e9607ce49b4da5231682
--- /dev/null
+++ b/psyz/src/platform/shaders/pe2_wide_background.frag.glsl
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: MPL-2.0
+// Source-bound outpaint only. Centre uses ORIGINAL unsqueezed source mask;
+// extra art cannot fabricate game mask bits. No native VRAM render target.
+#version 450
+layout(set=2,binding=0) uniform sampler2D outpaint;
+layout(set=2,binding=1) uniform sampler2D native_vram;
+layout(set=3,binding=0,std140) uniform WideParameters {
+    vec4 destination;
+    vec4 nativeSource;
+    vec4 art;        // canvas native width,height; canonical centre x,y
+    vec4 mapping;    // internal scale,squeeze,pivot,asset integer scale
+    vec4 dimensions;// actual immutable art width,height; native width,height
+} p;
+layout(location=0) out vec4 output_color;
+void main() {
+    // Metadata and bindings must agree; root owns corresponding CPU admission.
+    if (any(notEqual(textureSize(outpaint,0),ivec2(p.dimensions.xy))) ||
+        any(notEqual(textureSize(native_vram,0),ivec2(p.dimensions.zw)))) discard;
+    vec2 local=(gl_FragCoord.xy-p.destination.xy)/p.mapping.x;
+    float native_x=(local.x-p.mapping.z)/p.mapping.y+p.mapping.z;
+    vec2 native_local=vec2(native_x,local.y);
+    vec2 uv=(p.art.zw+native_local)/p.art.xy;
+    vec3 rgb=texture(outpaint,uv).rgb;
+    float mask=0.0;
+    if (native_x>=0.0 && native_x<p.nativeSource.z && local.y>=0.0 && local.y<p.nativeSource.w) {
+        ivec2 coordinate=ivec2(p.nativeSource.xy)+ivec2(floor(native_local));
+        mask=texelFetch(native_vram,coordinate,0).a;
+    }
+    output_color=vec4(rgb,mask);
+}
