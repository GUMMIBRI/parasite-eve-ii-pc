+    if(!f||!addPayload||!subPayload||addPayload==subPayload||plex_cap_reserved<2||!token||
+       token->slot!=f->token.slot||token->serial!=f->token.serial||!Psyz_GpuPlexCapMetricSupports(key,cell))return;
