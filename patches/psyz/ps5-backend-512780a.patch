new file mode 100644
index 0000000000000000000000000000000000000000..8d7c18ecbcfcff26fd1cf86f23331defd189ba37
--- /dev/null
+++ b/psyz/src/platform/sprite_atlas_index.h
@@ -0,0 +1,60 @@
+/* Exact-key CPU index adapted from the accepted PE1 Build17 SDL_GPU source.
+ * Existing PsyZ platform notices apply; same-project additions are not
+ * represented as independently MIT licensed. No GPU/native VRAM ownership.
+ * Include after SpriteAtlas, sprite_atlases and sprite_atlas_count.
+ * The ordered atlas table remains authoritative. */
+#ifndef PSYZ_SPRITE_ATLAS_INDEX_H
+#define PSYZ_SPRITE_ATLAS_INDEX_H
+#ifndef PSYZ_SPRITE_ATLAS_INDEX_DISABLE
+/* Zero is empty; stored values are atlas table indices plus one. */
+static uint16_t sprite_atlas_index[1024];
+_Static_assert(sizeof(sprite_atlas_index)==2048,"Atlas index must stay 2KiB");
+static unsigned SpriteAtlasIndexSlot(uint64_t key) {
+    key^=key>>33;
+    key*=UINT64_C(0xff51afd7ed558ccd);
+    key^=key>>33;
+    return (unsigned)key&1023u;
+}
+static void SpriteAtlasIndexReset(void) {
+    memset(sprite_atlas_index,0,sizeof(sprite_atlas_index));
+}
+static void IndexSpriteAtlas(unsigned index) {
+    if(index>=sprite_atlas_count || index>=65535u) return;
+    unsigned slot=SpriteAtlasIndexSlot(sprite_atlases[index].key);
+    for(unsigned probe=0;probe<1024;++probe,slot=(slot+1)&1023u) {
+        if(!sprite_atlas_index[slot]) {
+            sprite_atlas_index[slot]=(uint16_t)(index+1);
+            return;
+        }
+    }
+    /* A full index never changes registration or original table semantics. */
+}
+#else
+static void SpriteAtlasIndexReset(void) { }
+static void IndexSpriteAtlas(unsigned index) { (void)index; }
+#endif
+
+/* Duplicate keys retain insertion order and the original per-cell test:
+ * a later same-key atlas may have enough cells when its predecessor did not.
+ * Both hash lookup and fallback compare all 64 bits, including a zero key. */
+static SpriteAtlas *FindSpriteAtlasIndexed(uint64_t key,unsigned cell,int check_cell) {
+#ifndef PSYZ_SPRITE_ATLAS_INDEX_DISABLE
+    unsigned slot=SpriteAtlasIndexSlot(key);
+    for(unsigned probe=0;probe<1024;++probe,slot=(slot+1)&1023u) {
+        unsigned entry=sprite_atlas_index[slot];
+        if(!entry || entry>sprite_atlas_count) break;
+        SpriteAtlas *atlas=&sprite_atlases[entry-1];
+        if(atlas->key==key && (!check_cell || cell<atlas->columns*atlas->rows))
+            return atlas;
+    }
+#endif
+    /* Miss/overflow/invalid metadata falls back to the exact old ordered scan.
+     * Index storage cannot make an existing atlas invisible. */
+    for(unsigned i=0;i<sprite_atlas_count;++i) {
+        SpriteAtlas *atlas=&sprite_atlases[i];
+        if(atlas->key==key && (!check_cell || cell<atlas->columns*atlas->rows))
+            return atlas;
+    }
+    return NULL;
+}
+#endif
