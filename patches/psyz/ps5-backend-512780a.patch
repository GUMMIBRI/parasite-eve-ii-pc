index 0000000000000000000000000000000000000000..05fa272aa33de163f6c922ee13fd9ae6289f6189
--- /dev/null
+++ b/psyz/src/platform/pe2_background_cpu.c
@@ -0,0 +1,307 @@
+/* Bounded original-write PNG input. No GPU/state/cache ownership lives here. */
+#include "pe2_background_cpu.h"
+#include <SDL3/SDL.h>
+#include <limits.h>
+#include <string.h>
+
+/* This retained miniz copy cannot allocate. Only its fixed-output low-level
+ * inflater and CRC are called; no SDL/stb image decoder is invoked. */
+#if defined(__clang__)
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wunused-function"
+#pragma clang diagnostic ignored "-Wunused-but-set-variable"
+#endif
+#include "pe2_background_miniz.h"
+#if defined(__clang__)
+#pragma clang diagnostic pop
+#endif
+
+enum {
+    PE2_BG_ENCODED_LIMIT=16*1024*1024,
+    PE2_BG_DECODED_LIMIT=32*1024*1024,
+    PE2_BG_CHUNK_LIMIT=4096,
+    PE2_BG_INITIAL_READ=64*1024
+};
+
+typedef struct {
+    unsigned width,height,scale;
+    size_t row,filtered,rgba,compressed;
+} BackgroundPng;
+
+static uint32_t backgroundU32(const unsigned char *p)
+{
+    return (uint32_t)p[0]<<24 | (uint32_t)p[1]<<16 |
+           (uint32_t)p[2]<<8 | p[3];
+}
+
+static int backgroundHeader(const unsigned char *png, size_t bytes,
+                            const Pe2RgbaPngContract *contract,
+                            BackgroundPng *out)
+{
+    if (!png || !out || !contract || bytes<33 ||
+        !contract->sourceW || !contract->sourceH ||
+        !contract->maximumW || !contract->maximumH ||
+        !contract->maximumScale || contract->maximumScale>8 ||
+        memcmp(png,"\x89PNG\r\n\x1a\n",8) || backgroundU32(png+8)!=13 ||
+        memcmp(png+12,"IHDR",4)) return 0;
+    unsigned sourceW=contract->sourceW,sourceH=contract->sourceH;
+    unsigned width=backgroundU32(png+16),height=backgroundU32(png+20);
+    /* Only supported modes are admitted BEFORE any decoder/output allocation.
+     * Actual indexed player and selected background headers are RGBA8. */
+    if (!width || !height || width>contract->maximumW || height>contract->maximumH ||
+        png[24]!=8 || png[25]!=6 ||
+        png[26] || png[27] || png[28] ||
+        width%sourceW || height%sourceH) return 0;
+    unsigned scale=width/sourceW;
+    if (!scale || scale>contract->maximumScale || height/sourceH!=scale) return 0;
+    uint64_t row=(uint64_t)width*4;
+    /* Validate before products so the shared API remains bounded even when
+     * callers provide UINT_MAX-sized limits, not just native small contracts. */
+    if (row>PE2_BG_DECODED_LIMIT ||
+        height>PE2_BG_DECODED_LIMIT/(row+1)) return 0;
+    uint64_t rgba=row*height,filtered=(row+1)*height;
+    if (!rgba || rgba>PE2_BG_DECODED_LIMIT ||
+        filtered>PE2_BG_DECODED_LIMIT || row>UINT_MAX ||
+        (uint32_t)mz_crc32(0,png+12,17)!=backgroundU32(png+29)) return 0;
+    *out=(BackgroundPng){width,height,scale,(size_t)row,(size_t)filtered,(size_t)rgba,0};
+    return 1;
+}
+
+static int backgroundReadExact(SDL_IOStream *io, unsigned char *data, size_t bytes)
+{
+    size_t at=0;
+    while (at<bytes) {
+        size_t got=SDL_ReadIO(io,data+at,bytes-at);
+        if (!got) return 0;
+        at+=got;
+    }
+    return 1;
+}
+
+static unsigned char *backgroundRead(const char *path,
+                                    const Pe2RgbaPngContract *contract, size_t *bytes,
+                                    BackgroundPng *header)
+{
+    SDL_IOStream *io=SDL_IOFromFile(path,"rb");
+    if (!io) return NULL;
+    unsigned char first[33];
+    if (!backgroundReadExact(io,first,sizeof first) ||
+        !backgroundHeader(first,sizeof first,contract,header)) {
+        SDL_CloseIO(io);
+        return NULL;
+    }
+    size_t cap=PE2_BG_INITIAL_READ,used=sizeof first;
+    unsigned char *data=SDL_malloc(cap);
+    if (!data) { SDL_CloseIO(io);return NULL; }
+    memcpy(data,first,sizeof first);
+    int valid=1;
+    for (;;) {
+        if (used==cap) {
+            if (cap==PE2_BG_ENCODED_LIMIT) {
+                unsigned char extra;
+                size_t got=SDL_ReadIO(io,&extra,1);
+                valid=!got && SDL_GetIOStatus(io)==SDL_IO_STATUS_EOF;
+                break;
+            }
+            size_t next=cap*2;
+            if (next>PE2_BG_ENCODED_LIMIT) next=PE2_BG_ENCODED_LIMIT;
+            void *grown=SDL_realloc(data,next);
+            if (!grown) { valid=0;break; }
+            data=grown;cap=next;
+        }
+        size_t got=SDL_ReadIO(io,data+used,cap-used);
+        used+=got;
+        if (!got) {
+            valid=SDL_GetIOStatus(io)==SDL_IO_STATUS_EOF;
+            break;
+        }
+    }
+    if (!SDL_CloseIO(io)) valid=0;
+    if (!valid) { SDL_free(data);return NULL; }
+    *bytes=used;
+    return data;
+}
+
+static int backgroundTypeValid(const unsigned char *type)
+{
+    for (unsigned i=0;i<4;++i)
+        if (!((type[i]>='A' && type[i]<='Z') ||
+              (type[i]>='a' && type[i]<='z'))) return 0;
+    return type[2]>='A' && type[2]<='Z';
+}
+
+/* Full chunk/CRC/order validation precedes inflate allocation. IDAT data is
+ * retained in the bounded encoded file, never concatenated into another heap. */
+static int backgroundChunks(const unsigned char *png, size_t bytes,
+                             BackgroundPng *header)
+{
+    size_t at=8,compressed=0;
+    unsigned chunks=0;
+    int seenHeader=0,seenPalette=0,seenData=0,dataClosed=0;
+    while (at<bytes) {
+        if (++chunks>PE2_BG_CHUNK_LIMIT || bytes-at<12) return 0;
+        size_t length=backgroundU32(png+at);
+        const unsigned char *type=png+at+4;
+        if (length>bytes-at-12 || !backgroundTypeValid(type) ||
+            (uint32_t)mz_crc32(0,type,length+4)!=backgroundU32(png+at+8+length))
+            return 0;
+        if (!memcmp(type,"IHDR",4)) {
+            if (seenHeader || at!=8 || length!=13) return 0;
+            seenHeader=1;
+        } else if (!seenHeader) {
+            return 0;
+        } else if (!memcmp(type,"IDAT",4)) {
+            if (dataClosed || length>PE2_BG_ENCODED_LIMIT-compressed) return 0;
+            seenData=1;
+            compressed+=length;
+        } else if (!memcmp(type,"IEND",4)) {
+            if (length || !seenData || compressed<6 || at+12!=bytes) return 0;
+            header->compressed=compressed;
+            return 1;
+        } else {
+            if (seenData) dataClosed=1;
+            if (!memcmp(type,"PLTE",4)) {
+                if (seenPalette || seenData || !length || length>768 || length%3)
+                    return 0;
+                seenPalette=1;
+            } else if (!memcmp(type,"tRNS",4) || !memcmp(type,"acTL",4) ||
+                       !memcmp(type,"fcTL",4) || !memcmp(type,"fdAT",4)) {
+                /* Transparency is already explicit RGBA; animated PNG is not
+                 * a static original-write replacement supported by this API. */
+                return 0;
+            } else if (!(type[0]&0x20)) {
+                return 0; /* Unknown critical chunk. */
+            }
+        }
+        at+=length+12;
+    }
+    return 0;
+}
+
+static int backgroundInflate(const unsigned char *png, size_t bytes,
+                             const BackgroundPng *header, unsigned char *raw)
+{
+    tinfl_decompressor state;
+    tinfl_init(&state);
+    size_t at=8,remaining=header->compressed,written=0;
+    int done=0;
+    while (at<bytes) {
+        size_t length=backgroundU32(png+at);
+        if (!memcmp(png+at+4,"IDAT",4) && length) {
+            if (done || length>remaining) return 0;
+            size_t input=length,output=header->filtered-written;
+            unsigned flags=TINFL_FLAG_PARSE_ZLIB_HEADER |
+                           TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF |
+                           TINFL_FLAG_COMPUTE_ADLER32;
+            if (remaining>length) flags|=TINFL_FLAG_HAS_MORE_INPUT;
+            tinfl_status status=tinfl_decompress(&state,png+at+8,&input,
+                                                 raw,raw+written,&output,flags);
+            if (input!=length || output>header->filtered-written) return 0;
+            written+=output;
+            remaining-=length;
+            if (status==TINFL_STATUS_DONE) {
+                if (remaining || written!=header->filtered) return 0;
+                done=1;
+            } else if (status!=TINFL_STATUS_NEEDS_MORE_INPUT || !remaining) {
+                /* HAS_MORE_OUTPUT fails here: the exact IHDR-derived filtered
+                 * output capacity is immutable and can NEVER grow/reallocate. */
+                return 0;
+            }
+        }
+        at+=length+12;
+    }
+    return done && !remaining && written==header->filtered;
+}
+
+static unsigned backgroundPaeth(unsigned left, unsigned up, unsigned upperLeft)
+{
+    int prediction=(int)left+(int)up-(int)upperLeft;
+    int a=prediction-(int)left,b=prediction-(int)up,c=prediction-(int)upperLeft;
+    if (a<0) a=-a;
+    if (b<0) b=-b;
+    if (c<0) c=-c;
+    return a<=b && a<=c ? left : b<=c ? up : upperLeft;
+}
+
+static int backgroundUnfilter(unsigned char *raw, const BackgroundPng *header)
+{
+    size_t stride=header->row+1;
+    for (unsigned y=0;y<header->height;++y) {
+        unsigned char *row=raw+(size_t)y*stride+1;
+        const unsigned char *previous=y ? row-stride : NULL;
+        unsigned filter=row[-1];
+        if (filter>4) return 0;
+        for (size_t x=0;x<header->row;++x) {
+            unsigned left=x>=4 ? row[x-4] : 0;
+            unsigned up=previous ? previous[x] : 0;
+            unsigned upperLeft=previous && x>=4 ? previous[x-4] : 0;
+            unsigned prediction=0;
+            if (filter==1) prediction=left;
+            else if (filter==2) prediction=up;
+            else if (filter==3) prediction=(left+up)>>1;
+            else if (filter==4) prediction=backgroundPaeth(left,up,upperLeft);
+            row[x]=(unsigned char)(row[x]+prediction);
+        }
+    }
+    /* Remove filter bytes in place after every predecessor row is consumed.
+     * This avoids a second decoded-pixel allocation or SDL conversion copy. */
+    for (unsigned y=0;y<header->height;++y)
+        memmove(raw+(size_t)y*header->row,
+                raw+(size_t)y*stride+1,header->row);
+    return 1;
+}
+
+int Pe2RgbaPngLoad(const char *path,const Pe2RgbaPngContract *contract,
+                   Pe2RgbaPngPixels *out)
+{
+    if (!out) return 0;
+    *out=(Pe2RgbaPngPixels){0};
+    if (!path || !path[0] || !contract) return 0;
+    BackgroundPng header={0};
+    size_t encodedBytes=0;
+    unsigned char *encoded=backgroundRead(path,contract,&encodedBytes,&header);
+    if (!encoded) return 0;
+    unsigned char *raw=NULL;
+    int valid=backgroundChunks(encoded,encodedBytes,&header);
+    if (valid) {
+        /* This is the sole inflate/output allocation. tinfl cannot allocate
+         * and receives this exact fixed capacity, bounded before allocation. */
+        raw=SDL_malloc(header.filtered);
+        valid=raw && backgroundInflate(encoded,encodedBytes,&header,raw) &&
+                     backgroundUnfilter(raw,&header);
+    }
+    SDL_free(encoded);
+    if (!valid) { SDL_free(raw);return 0; }
+    *out=(Pe2RgbaPngPixels){raw,header.width,header.height,
+                              (unsigned)header.row,header.scale,header.rgba};
+    return 1;
+}
+
+void Pe2RgbaPngFree(Pe2RgbaPngPixels *pixels)
+{
+    if (!pixels) return;
+    SDL_free(pixels->rgba);
+    *pixels=(Pe2RgbaPngPixels){0};
+}
+
+int Pe2BackgroundLoad(const char *root, const uint64_t hash[2],
+                     unsigned sourceW, unsigned sourceH,
+                     Pe2BackgroundPixels *out)
+{
+    if (!out) return 0;
+    *out=(Pe2BackgroundPixels){0};
+    if (!root || !root[0] || !hash || strlen(root)>1024 ||
+        sourceH!=240 || (sourceW!=16 && sourceW!=320)) return 0;
+    char file[1100];
+    int length=SDL_snprintf(file,sizeof file,"%s/vram-write-%016llX%016llX.png",
+                           root,(unsigned long long)hash[1],
+                           (unsigned long long)hash[0]);
+    if (length<0 || length>=(int)sizeof file) return 0;
+    const Pe2RgbaPngContract contract={sourceW,sourceH,sourceW*8,sourceH*8,8};
+    return Pe2RgbaPngLoad(file,&contract,out);
+}
+
+void Pe2BackgroundFree(Pe2BackgroundPixels *pixels)
+{
+    Pe2RgbaPngFree(pixels);
+}
diff --git a/psyz/src/platform/pe2_background_cpu.h b/psyz/src/platform/pe2_background_cpu.h
new file mode 100644
index 0000000000000000000000000000000000000000..3f7a3ca5c17325a19d390bf33f16ab43f248ed7c
--- /dev/null
+++ b/psyz/src/platform/pe2_background_cpu.h
@@ -0,0 +1,39 @@
+/* Bounded, optional CPU loading of an exact original-write replacement. */
+#ifndef PE2_BACKGROUND_CPU_H
+#define PE2_BACKGROUND_CPU_H
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+    unsigned char *rgba;
+    unsigned width, height, pitch, scale;
+    size_t bytes;
+} Pe2RgbaPngPixels;
+typedef Pe2RgbaPngPixels Pe2BackgroundPixels;
+
+/* All limits are checked against IHDR before encoded/output allocation.
+ * source dimensions describe the exact admitted original rectangle. */
+typedef struct {
+    unsigned sourceW, sourceH, maximumW, maximumH, maximumScale;
+} Pe2RgbaPngContract;
+
+/* RGBA8/noninterlaced static PNG only, uniform integer scale. All chunks/CRCs
+ * and zlib/Adler/filter bounds are checked. At most16MiB encoded and32MiB
+ * fixed filtered output. No SDL/stb image decoder or second pixel copy.
+ * Failure zeroes out. Caller releases previous allocations before reuse. */
+int Pe2RgbaPngLoad(const char *path, const Pe2RgbaPngContract *contract,
+                   Pe2RgbaPngPixels *out);
+void Pe2RgbaPngFree(Pe2RgbaPngPixels *pixels);
+
+/* root is the selected disc's unchanged replacements directory. hash[0] is
+ * low64, hash[1] high64; the exact uppercase legacy name is high64 thenlow64.
+ * Only original16x240 strips or320x240 frames, uniformly scaled1..8, are
+ * admitted. Currently supports only8-bit noninterlaced RGBA PNGs. Missing,
+ * malformed, unsupported, over-budget or failed data returns0, out zeroed.
+ * Caller owns any previous out allocation and must release it before reuse.
+ * No GPU, cache, original VRAM, ownership hash or game state is modified. */
+int Pe2BackgroundLoad(const char *root, const uint64_t hash[2],
+                     unsigned sourceW, unsigned sourceH,
+                     Pe2BackgroundPixels *out);
+void Pe2BackgroundFree(Pe2BackgroundPixels *pixels);
+#endif
diff --git a/psyz/src/platform/pe2_background_frame.c b/psyz/src/platform/pe2_background_frame.c
new file mode 100644
index 0000000000000000000000000000000000000000..11d2e44df0381f78572166f50705b0dac2e80237
--- /dev/null
+++ b/psyz/src/platform/pe2_background_frame.c
@@ -0,0 +1,50 @@
+/* MPL-2.0. CPU proof of one original native background upload invocation.
+ * No GPU, callback storage, image decode/hash, game state or pixel access. */
+#include "pe2_background_frame.h"
+#include <string.h>
+static int token(uint64_t value){return value!=0&&value!=UINT64_MAX;}
+void Pe2BackgroundFrameInvalidate(Pe2BackgroundFrameCollector *c){
+    if(!c)return;c->active=0;c->failed=1;c->columnMask=0;c->haveDestination=0;
+    memset(&c->source,0,sizeof c->source);
+}
+int Pe2BackgroundFrameBegin(Pe2BackgroundFrameCollector *c,const PsyzHdBackgroundFrame *source,uint64_t nativeEpoch,uint64_t failureSerial){
+    if(!c)return 0;
+    int wasActive=c->active;uint64_t high=c->highWater;
+    Pe2BackgroundFrameInvalidate(c);c->nativeEpoch=nativeEpoch;c->failureSerial=failureSerial;
+    if(!source||!token(source->uploadFrameSerial)||source->uploadFrameSerial<=high)return 0;
+    c->highWater=source->uploadFrameSerial;
+    /* A nested/missing-End producer cannot upgrade an old/partial invocation. */
+    if(wasActive||!token(nativeEpoch)||failureSerial==UINT64_MAX)return 0;
+    c->source=*source;c->active=1;c->failed=0;
+    if(source->known!=1||!token(source->generation)||!(source->sourceHash[0]|source->sourceHash[1])||source->sourceWidth!=320||source->sourceHeight!=240){c->failed=1;return 0;}
+    return 1;
+}
+static int poison(Pe2BackgroundFrameCollector *c){if(c){c->failed=1;c->columnMask=0;}return 0;}
+int Pe2BackgroundFrameAccept(Pe2BackgroundFrameCollector *c,const PsyzHdBackgroundUpload *upload,int x,int y,int w,int h,uint64_t nativeEpoch,uint64_t failureSerial){
+    if(!c||!c->active)return 0;
+    if(c->failed||nativeEpoch!=c->nativeEpoch||failureSerial!=c->failureSerial||failureSerial==UINT64_MAX||!upload)return poison(c);
+    if(upload->uploadFrameSerial!=c->source.uploadFrameSerial||upload->generation!=c->source.generation||
+       memcmp(upload->sourceHash,c->source.sourceHash,sizeof upload->sourceHash)||upload->sourceWidth!=320||upload->sourceHeight!=240||
+       upload->cropY!=0||upload->cropHeight!=240||h!=240||(y!=0&&y!=PE2_BACKGROUND_SECOND_BANK_Y)||x<0||w<=0||
+       (unsigned)x!=upload->cropX||(unsigned)w!=upload->cropWidth)return poison(c);
+    if(c->haveDestination&&c->destinationY!=y)return poison(c);
+    unsigned mask;
+    if(w==16&&upload->stripWidth==16&&upload->cropX<=304&&(upload->cropX%16)==0){mask=1u<<(upload->cropX/16);}
+    else if(w==320&&upload->stripWidth==0&&upload->cropX==0&&c->columnMask==0){mask=PE2_BACKGROUND_FRAME_COLUMNS;}
+    else return poison(c);
+    if(c->columnMask&mask)return poison(c);
+    c->destinationY=y;c->haveDestination=1;c->columnMask|=mask;return 1;
+}
+int Pe2BackgroundFrameFinish(Pe2BackgroundFrameCollector *c,uint64_t uploadFrameSerial,uint64_t nativeEpoch,uint64_t failureSerial,Pe2BackgroundFrameReceipt *out){
+    if(out)memset(out,0,sizeof *out);
+    if(!c)return 0;
+    int good=out&&c->active&&!c->failed&&token(uploadFrameSerial)&&uploadFrameSerial==c->source.uploadFrameSerial&&
+        nativeEpoch==c->nativeEpoch&&failureSerial==c->failureSerial&&failureSerial!=UINT64_MAX&&
+        c->haveDestination&&c->columnMask==PE2_BACKGROUND_FRAME_COLUMNS;
+    Pe2BackgroundFrameReceipt receipt={0};
+    if(good){receipt.uploadFrameSerial=uploadFrameSerial;receipt.generation=c->source.generation;
+        receipt.sourceHash[0]=c->source.sourceHash[0];receipt.sourceHash[1]=c->source.sourceHash[1];
+        receipt.nativeEpoch=nativeEpoch;receipt.failureSerial=failureSerial;receipt.columnMask=c->columnMask;
+        receipt.nativeX=0;receipt.nativeY=(unsigned)c->destinationY;receipt.width=320;receipt.height=240;}
+    Pe2BackgroundFrameInvalidate(c);if(good)*out=receipt;return good;
+}
diff --git a/psyz/src/platform/pe2_background_frame.h b/psyz/src/platform/pe2_background_frame.h
new file mode 100644
index 0000000000000000000000000000000000000000..c3a6516d1c2b0f7ff93af0ab7186af99385b9bf4
--- /dev/null
+++ b/psyz/src/platform/pe2_background_frame.h
@@ -0,0 +1,32 @@
+/* Pure CPU ordered-native-copy completion collector. No rendering calls. */
+#ifndef PE2_BACKGROUND_FRAME_H
+#define PE2_BACKGROUND_FRAME_H
+#include <stdint.h>
+#include <psyz/hd_background.h>
+/* Actual PE2 main/display.h DISPLAY_BUFFER_STRIDE_ROWS, NOT256. */
+enum { PE2_BACKGROUND_FRAME_COLUMNS=0x000fffffu, PE2_BACKGROUND_SECOND_BANK_Y=272 };
+typedef struct Pe2BackgroundFrameReceipt {
+    uint64_t uploadFrameSerial,generation,sourceHash[2];
+    uint64_t nativeEpoch,failureSerial;
+    unsigned columnMask,nativeX,nativeY,width,height;
+} Pe2BackgroundFrameReceipt;
+typedef struct Pe2BackgroundFrameCollector {
+    PsyzHdBackgroundFrame source;
+    uint64_t highWater,nativeEpoch,failureSerial;
+    unsigned columnMask;
+    int active,failed,haveDestination,destinationY;
+} Pe2BackgroundFrameCollector;
+/* Zero-init collector once. Invalidate preserves serial high-water; recreating
+ * renderer must also pass its new nonzero nativeEpoch. All calls render thread. */
+void Pe2BackgroundFrameInvalidate(Pe2BackgroundFrameCollector *);
+int Pe2BackgroundFrameBegin(Pe2BackgroundFrameCollector *,const PsyzHdBackgroundFrame *,uint64_t nativeEpoch,uint64_t failureSerial);
+/* Root calls ONLY after successful ORIGINAL raw upload+Sync/ordered acceptance,
+ * unchanged failure serial. Call with NULL descriptor for accepted unrelated
+ * writes while frame open, so mixed/unknown data poisons whole invocation.
+ * Never call from game producer; no second lookup/hash inside this collector. */
+int Pe2BackgroundFrameAccept(Pe2BackgroundFrameCollector *,const PsyzHdBackgroundUpload *,int destinationX,int destinationY,int width,int height,uint64_t nativeEpoch,uint64_t failureSerial);
+/* Always consume End even unsupported/partial. Failure zeros receipt; never
+ * carries a successful receipt across frames. This proves ordered recording,
+ * not completed GPU execution. Native failure hooks must invalidate afterward. */
+int Pe2BackgroundFrameFinish(Pe2BackgroundFrameCollector *,uint64_t uploadFrameSerial,uint64_t nativeEpoch,uint64_t failureSerial,Pe2BackgroundFrameReceipt *);
+#endif
diff --git a/psyz/src/platform/pe2_background_miniz.h b/psyz/src/platform/pe2_background_miniz.h
