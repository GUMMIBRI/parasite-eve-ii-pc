+/* MPL-2.0. Bounded packet-local optional shadow queue admission. */
+#ifndef PSYZ_SHADOW_METADATA_H
+#define PSYZ_SHADOW_METADATA_H
+#include <stdint.h>
+enum { PSYZ_SHADOW_RUN_LIMIT=96 };
+enum { PSYZ_SHADOW_OFF=0, PSYZ_SHADOW_STRICT=1, PSYZ_SHADOW_RAW_PEAK_EXPERIMENTAL=2 };
+enum { PSYZ_SHADOW_SOURCE_CONSTANT=0, PSYZ_SHADOW_SOURCE_RAW_PEAK=1 };
+typedef struct {
+    uint64_t epoch;
+    unsigned count, shade, shadeValid;
+    unsigned sourceRaw, sourcePolicy; /* raw must match exact snapshot code2f */
+    uint32_t packet[9]; /* exact original FT4 payload, all36 bytes */
+    int16_t xy[PSYZ_SHADOW_RUN_LIMIT][8];
+} PsyzShadowBatch;
+/* Mode2 is experimental flat raw-source silhouette, not original gradient
+ * or identical PE1 styling. No mode changes the defaultOff. */
+void Psyz_GpuSetShadowMode(int mode);
+int Psyz_GpuGetShadowMode(void);
+const char *Psyz_GpuShadowStatus(void);
+/* Call at actual capture/frame epoch boundaries; epoch0 clears, never admits.
+ * The game adapter must obtain the batch from its current live capture getter.
+ * The registered payload is readable36 bytes DURING this call only. Saved
+ * pointer values are identities and are never dereferenced later. */
+void Psyz_GpuShadowBeginEpoch(uint64_t epoch);
+int Psyz_GpuShadowRegister(const void *originalPayload,const PsyzShadowBatch *batch);
+#endif
diff --git a/psyz/src/platform/display_filter/display_filter.frag.glsl b/psyz/src/platform/display_filter/display_filter.frag.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..c0dfeab6507bd3b69b23af140eff3b3197651c35
--- /dev/null
+++ b/psyz/src/platform/display_filter/display_filter.frag.glsl
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: MIT
+#version 450
+layout(set=2,binding=0) uniform sampler2D image;
+layout(set=3,binding=0,std140) uniform Parameters {
+    vec4 source;       // selected visible source rectangle in texture pixels
+    vec4 destination;  // unchanged physical output viewport
+    vec4 effect;       // logical image rows, mode; remaining components reserved
+};
+layout(location=0) out vec4 colour;
+void main() {
+    vec2 p = (gl_FragCoord.xy-destination.xy)/destination.zw;
+    // Clamp to the selected rectangle, not the whole VRAM page. Linear
+    // interpolation must never gather neighboring pages or letterbox pixels.
+    vec2 pixel = clamp(source.xy+p*source.zw,
+                       source.xy+vec2(0.5),source.xy+source.zw-vec2(0.5));
+    vec3 c = texture(image,pixel/vec2(textureSize(image,0))).rgb;
+    float rows = max(1.0,effect.x);
+    // Fade below two output pixels per original row; no single-pixel row
+    // removal or source-resolution-dependent stripes on internally scaled art.
+    float strength = smoothstep(1.0,2.0,destination.w/rows);
+    float phase = 6.28318530718*p.y*rows;
+    c *= 1.0 - 0.08*strength*(0.5-0.5*cos(phase));
+    if(effect.y>1.5) {
+        // Restrained soft RGB phosphor mask, fixed in physical output pixels.
+        // No warp, overscan, blur, bloom, temporal history or invented detail.
+        float x = 6.28318530718*(gl_FragCoord.x-destination.x)/3.0;
+        vec3 mask = 0.5+0.5*cos(vec3(x,x-2.09439510239,x-4.18879020479));
+        c *= vec3(1.0)-0.055*strength*(vec3(1.0)-mask);
+    }
+    colour=vec4(c,1.0);
+}
