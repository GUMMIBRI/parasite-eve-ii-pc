+/*! @ingroup XXH3_family */
+XXH_PUBLIC_API XXH_errorcode
+XXH3_128bits_update(XXH_NOESCAPE XXH3_state_t* state, XXH_NOESCAPE const void* input, size_t len)
+{
+    return XXH3_64bits_update(state, input, len);
+}
+
+/*! @ingroup XXH3_family */
+XXH_PUBLIC_API XXH128_hash_t XXH3_128bits_digest (XXH_NOESCAPE const XXH3_state_t* state)
+{
+    const unsigned char* const secret = (state->extSecret == NULL) ? state->customSecret : state->extSecret;
+    if (state->totalLen > XXH3_MIDSIZE_MAX) {
+        XXH_ALIGN(XXH_ACC_ALIGN) XXH64_hash_t acc[XXH_ACC_NB];
+        XXH3_digest_long(acc, state, secret);
+        XXH_ASSERT(state->secretLimit + XXH_STRIPE_LEN >= sizeof(acc) + XXH_SECRET_MERGEACCS_START);
+        return XXH3_finalizeLong_128b(acc, secret, state->secretLimit + XXH_STRIPE_LEN,  (xxh_u64)state->totalLen);
+    }
+    /* len <= XXH3_MIDSIZE_MAX : short code */
+    if (state->useSeed)
+        return XXH3_128bits_withSeed(state->buffer, (size_t)state->totalLen, state->seed);
+    return XXH3_128bits_withSecret(state->buffer, (size_t)(state->totalLen),
+                                   secret, state->secretLimit + XXH_STRIPE_LEN);
+}
+#endif /* !XXH_NO_STREAM */
+/* 128-bit utility functions */
+
+#include <string.h>   /* memcmp, memcpy */
+
+/* return : 1 is equal, 0 if different */
+/*! @ingroup XXH3_family */
+XXH_PUBLIC_API int XXH128_isEqual(XXH128_hash_t h1, XXH128_hash_t h2)
+{
+    /* note : XXH128_hash_t is compact, it has no padding byte */
+    return !(memcmp(&h1, &h2, sizeof(h1)));
+}
+
+/* This prototype is compatible with stdlib's qsort().
+ * @return : >0 if *h128_1  > *h128_2
+ *           <0 if *h128_1  < *h128_2
+ *           =0 if *h128_1 == *h128_2  */
+/*! @ingroup XXH3_family */
+XXH_PUBLIC_API int XXH128_cmp(XXH_NOESCAPE const void* h128_1, XXH_NOESCAPE const void* h128_2)
+{
+    XXH128_hash_t const h1 = *(const XXH128_hash_t*)h128_1;
+    XXH128_hash_t const h2 = *(const XXH128_hash_t*)h128_2;
+    int const hcmp = (h1.high64 > h2.high64) - (h2.high64 > h1.high64);
+    /* note : bets that, in most cases, hash values are different */
+    if (hcmp) return hcmp;
+    return (h1.low64 > h2.low64) - (h2.low64 > h1.low64);
+}
+
+
+/*======   Canonical representation   ======*/
+/*! @ingroup XXH3_family */
+XXH_PUBLIC_API void
+XXH128_canonicalFromHash(XXH_NOESCAPE XXH128_canonical_t* dst, XXH128_hash_t hash)
+{
+    XXH_STATIC_ASSERT(sizeof(XXH128_canonical_t) == sizeof(XXH128_hash_t));
+    if (XXH_CPU_LITTLE_ENDIAN) {
+        hash.high64 = XXH_swap64(hash.high64);
+        hash.low64  = XXH_swap64(hash.low64);
+    }
+    XXH_memcpy(dst, &hash.high64, sizeof(hash.high64));
+    XXH_memcpy((char*)dst + sizeof(hash.high64), &hash.low64, sizeof(hash.low64));
+}
+
+/*! @ingroup XXH3_family */
+XXH_PUBLIC_API XXH128_hash_t
+XXH128_hashFromCanonical(XXH_NOESCAPE const XXH128_canonical_t* src)
+{
+    XXH128_hash_t h;
+    h.high64 = XXH_readBE64(src);
+    h.low64  = XXH_readBE64(src->digest + 8);
+    return h;
+}
+
+
+
+/* ==========================================
+ * Secret generators
+ * ==========================================
+ */
+#define XXH_MIN(x, y) (((x) > (y)) ? (y) : (x))
+
+XXH_FORCE_INLINE void XXH3_combine16(void* dst, XXH128_hash_t h128)
+{
+    XXH_writeLE64( dst, XXH_readLE64(dst) ^ h128.low64 );
+    XXH_writeLE64( (char*)dst+8, XXH_readLE64((char*)dst+8) ^ h128.high64 );
+}
+
+/*! @ingroup XXH3_family */
+XXH_PUBLIC_API XXH_errorcode
+XXH3_generateSecret(XXH_NOESCAPE void* secretBuffer, size_t secretSize, XXH_NOESCAPE const void* customSeed, size_t customSeedSize)
+{
+#if (XXH_DEBUGLEVEL >= 1)
+    XXH_ASSERT(secretBuffer != NULL);
+    XXH_ASSERT(secretSize >= XXH3_SECRET_SIZE_MIN);
+#else
+    /* production mode, assert() are disabled */
+    if (secretBuffer == NULL) return XXH_ERROR;
+    if (secretSize < XXH3_SECRET_SIZE_MIN) return XXH_ERROR;
+#endif
+
+    if (customSeedSize == 0) {
+        customSeed = XXH3_kSecret;
+        customSeedSize = XXH_SECRET_DEFAULT_SIZE;
+    }
+#if (XXH_DEBUGLEVEL >= 1)
+    XXH_ASSERT(customSeed != NULL);
+#else
+    if (customSeed == NULL) return XXH_ERROR;
+#endif
+
+    /* Fill secretBuffer with a copy of customSeed - repeat as needed */
+    {   size_t pos = 0;
+        while (pos < secretSize) {
+            size_t const toCopy = XXH_MIN((secretSize - pos), customSeedSize);
+            memcpy((char*)secretBuffer + pos, customSeed, toCopy);
+            pos += toCopy;
+    }   }
+
+    {   size_t const nbSeg16 = secretSize / 16;
+        size_t n;
+        XXH128_canonical_t scrambler;
+        XXH128_canonicalFromHash(&scrambler, XXH128(customSeed, customSeedSize, 0));
+        for (n=0; n<nbSeg16; n++) {
+            XXH128_hash_t const h128 = XXH128(&scrambler, sizeof(scrambler), n);
+            XXH3_combine16((char*)secretBuffer + n*16, h128);
+        }
+        /* last segment */
+        XXH3_combine16((char*)secretBuffer + secretSize - 16, XXH128_hashFromCanonical(&scrambler));
+    }
+    return XXH_OK;
+}
+
+/*! @ingroup XXH3_family */
+XXH_PUBLIC_API void
+XXH3_generateSecret_fromSeed(XXH_NOESCAPE void* secretBuffer, XXH64_hash_t seed)
+{
+    XXH_ALIGN(XXH_SEC_ALIGN) xxh_u8 secret[XXH_SECRET_DEFAULT_SIZE];
+    XXH3_initCustomSecret(secret, seed);
+    XXH_ASSERT(secretBuffer != NULL);
+    memcpy(secretBuffer, secret, XXH_SECRET_DEFAULT_SIZE);
+}
+
+
+
+/* Pop our optimization override from above */
+#if XXH_VECTOR == XXH_AVX2 /* AVX2 */ \
+  && defined(__GNUC__) && !defined(__clang__) /* GCC, not Clang */ \
+  && defined(__OPTIMIZE__) && XXH_SIZE_OPT <= 0 /* respect -O0 and -Os */
+#  pragma GCC pop_options
+#endif
+
+#endif  /* XXH_NO_LONG_LONG */
+
+#endif  /* XXH_NO_XXH3 */
+
+/*!
+ * @}
+ */
+#endif  /* XXH_IMPLEMENTATION */
+
+
+#if defined (__cplusplus)
+} /* extern "C" */
+#endif
diff --git a/psyz/src/platform/font_identity.c b/psyz/src/platform/font_identity.c
new file mode 100644
index 0000000000000000000000000000000000000000..c5776d3f4e21174d96fc7c5e5a59cabfef469788
--- /dev/null
+++ b/psyz/src/platform/font_identity.c
@@ -0,0 +1,239 @@
+/* MPL-2.0. Original source-word identity and lifetime implementation.
+ * xxHash's complete BSD-2-Clause notice is retained in duck_xxhash.h.
+ * No renderer, SDL, original pixel data or private binding is needed to hash. */
+#include "font_identity.h"
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+#define XXH_STATIC_LINKING_ONLY
+#define XXH_INLINE_ALL
+#include "duck_xxhash.h"
+
+enum { FONT_VRAM_W = 1024, FONT_VRAM_H = 512, FONT_REGION_SLOTS = 128 };
+typedef struct { unsigned x, y, w, h; } FontWordRect;
+typedef struct {
+    PsyzFontRegion region;
+    PsyzFontIdentity identity;
+    FontWordRect texture, palette;
+    uint64_t serial;
+    int live;
+} FontRegionSlot;
+typedef struct {
+    uint16_t words[FONT_VRAM_W * FONT_VRAM_H];
+    unsigned char known[FONT_VRAM_W * FONT_VRAM_H];
+    FontRegionSlot slots[FONT_REGION_SLOTS];
+    unsigned cursor;
+} FontIdentityCapture;
+
+static FontIdentityCapture *font_capture;
+/* Never reset across disable/free/reinitialization; copied old handles cannot
+ * become live again at an identical slot in a later tracker allocation. */
+static uint64_t font_serial = 1;
+static int font_serial_exhausted;
+
+void Psyz_FontHash128(const void *data, size_t bytes, uint64_t output[2])
+{
+    if (!output) return;
+    if (!data && bytes) { output[0] = output[1] = 0; return; }
+    XXH128_hash_t hash = XXH3_128bits(data, bytes);
+    output[0] = hash.low64;
+    output[1] = hash.high64;
+}
+
+int Psyz_FontIdentityCaptureEnable(int enabled)
+{
+    if (!enabled) {
+        free(font_capture);
+        font_capture = NULL;
+        return 1;
+    }
+    if (font_serial_exhausted) return 0;
+    if (!font_capture) font_capture = calloc(1, sizeof(*font_capture));
+    return font_capture != NULL;
+}
+
+void Psyz_FontIdentityCaptureReset(void)
+{
+    if (font_capture) memset(font_capture, 0, sizeof(*font_capture));
+}
+
+static int FontOverlap(FontWordRect a, FontWordRect b)
+{
+    return a.x < b.x + b.w && b.x < a.x + a.w &&
+           a.y < b.y + b.h && b.y < a.y + a.h;
+}
+
+void Psyz_FontIdentityCaptureDirty(int x, int y, int w, int h)
+{
+    if (!font_capture || !w || !h) return;
+    if (w < 0 || h < 0) {
+        Psyz_FontIdentityCaptureReset();
+        return;
+    }
+    /* Avoid overflow and conservatively clip failed/unknown writes to their
+     * possible physical intersection. Disjoint framebuffer writes stay local. */
+    int64_t right = (int64_t)x + w, bottom = (int64_t)y + h;
+    int64_t left = x < 0 ? 0 : x, top = y < 0 ? 0 : y;
+    if (right > FONT_VRAM_W) right = FONT_VRAM_W;
+    if (bottom > FONT_VRAM_H) bottom = FONT_VRAM_H;
+    if (left >= right || top >= bottom) return;
+    FontWordRect dirty = {(unsigned)left, (unsigned)top,
+                         (unsigned)(right-left), (unsigned)(bottom-top)};
+    for (unsigned row = 0; row < dirty.h; ++row)
+        memset(font_capture->known + (dirty.y + row)*FONT_VRAM_W + dirty.x,
+               0, dirty.w);
+    for (unsigned i = 0; i < FONT_REGION_SLOTS; ++i) {
+        FontRegionSlot *slot = &font_capture->slots[i];
+        if (slot->live && (FontOverlap(slot->texture, dirty) ||
+                           FontOverlap(slot->palette, dirty))) slot->live = 0;
+    }
+}
+
+int Psyz_FontIdentityCaptureAccept(int x, int y, int w, int h,
+                                   const uint16_t *words)
+{
+    if (!font_capture) return 0;
+    Psyz_FontIdentityCaptureDirty(x,y,w,h);
+    if (!words || x < 0 || y < 0 || w <= 0 || h <= 0 ||
+        (int64_t)x+w > FONT_VRAM_W || (int64_t)y+h > FONT_VRAM_H) return 0;
+    for (unsigned row = 0; row < (unsigned)h; ++row) {
+        size_t at = ((size_t)y + row)*FONT_VRAM_W + (unsigned)x;
+        memcpy(font_capture->words + at, words + row*(unsigned)w,
+               (size_t)w*sizeof(*words));
+        memset(font_capture->known + at, 1, (size_t)w);
+    }
+    return 1;
+}
+
+static int FontRegionRects(const PsyzFontRegion *region,
+                           FontWordRect *texture, FontWordRect *palette)
+{
+    if (!region || region->page > 511 || region->clut > 32767 ||
+        region->u > 255 || region->v > 255 || !region->w || !region->h ||
+        region->w > 256-region->u || region->h > 256-region->v) return 0;
+    unsigned mode = (region->page >> 7) & 3;
+    if (mode > 1) return 0;
+    unsigned factor = mode ? 2 : 4;
+    unsigned left = region->u/factor;
+    unsigned right = (region->u + region->w + factor-1)/factor;
+    *texture = (FontWordRect){(region->page & 15)*64 + left,
+        ((region->page >> 4) & 1)*256 + region->v, right-left, region->h};
+    *palette = (FontWordRect){(region->clut & 63)*16, region->clut >> 6,
+                             mode ? 256u : 16u, 1};
+    return texture->x + texture->w <= FONT_VRAM_W &&
+           texture->y + texture->h <= FONT_VRAM_H &&
+           palette->x + palette->w <= FONT_VRAM_W && palette->y < FONT_VRAM_H;
+}
+
+static int FontHashKnownRect(FontWordRect rect, uint64_t output[2])
+{
+    XXH3_state_t state;
+    unsigned char canonical[FONT_VRAM_W*2];
+    XXH3_128bits_reset(&state);
+    for (unsigned row = 0; row < rect.h; ++row) {
+        size_t at = (rect.y + row)*FONT_VRAM_W + rect.x;
+        for (unsigned column = 0; column < rect.w; ++column) {
+            if (!font_capture->known[at + column]) return 0;
+            uint16_t word = font_capture->words[at + column];
+            canonical[2*column] = (unsigned char)word;
+            canonical[2*column+1] = (unsigned char)(word >> 8);
+        }
+        XXH3_128bits_update(&state, canonical, (size_t)rect.w*2);
+    }
+    XXH128_hash_t hash = XXH3_128bits_digest(&state);
+    output[0] = hash.low64;
+    output[1] = hash.high64;
+    return 1;
+}
+
+static int FontSameRegion(PsyzFontRegion a, PsyzFontRegion b)
+{
+    return a.page == b.page && a.clut == b.clut && a.u == b.u &&
+           a.v == b.v && a.w == b.w && a.h == b.h;
+}
+
+int Psyz_FontIdentityAcquire(const PsyzFontRegion *region,
+                            PsyzFontIdentity *identity, PsyzFontToken *token)
+{
+    if (identity) memset(identity, 0, sizeof(*identity));
+    if (token) memset(token, 0, sizeof(*token));
+    FontWordRect texture, palette;
+    if (!font_capture || font_serial_exhausted || !identity || !token ||
+        !FontRegionRects(region, &texture, &palette)) return 0;
+    for (unsigned i = 0; i < FONT_REGION_SLOTS; ++i) {
+        FontRegionSlot *slot = &font_capture->slots[i];
+        if (slot->live && FontSameRegion(*region, slot->region)) {
+            *identity = slot->identity;
+            *token = (PsyzFontToken){slot->serial, i, 0};
+            return 1;
+        }
+    }
+    PsyzFontIdentity current;
+    if (!FontHashKnownRect(texture,current.texture) ||
+        !FontHashKnownRect(palette,current.palette)) return 0;
+    if (font_serial == UINT64_MAX) {
+        font_serial_exhausted = 1;
+        Psyz_FontIdentityCaptureEnable(0);
+        return 0;
+    }
+    unsigned index = font_capture->cursor++ % FONT_REGION_SLOTS;
+    FontRegionSlot *slot = &font_capture->slots[index];
+    *slot = (FontRegionSlot){*region, current, texture, palette, font_serial++, 1};
+    *identity = current;
+    *token = (PsyzFontToken){slot->serial,index,0};
+    return 1;
+}
+
+int Psyz_FontIdentityValidate(const PsyzFontToken *token)
+{
+    if (!font_capture || font_serial_exhausted || !token || token->reserved ||
+        !token->serial || token->slot >= FONT_REGION_SLOTS) return 0;
+    FontRegionSlot *slot = &font_capture->slots[token->slot];
+    return slot->live && slot->serial == token->serial;
+}
+
+int Psyz_FontIdentityRegion(const PsyzFontToken *token, PsyzFontRegion *region)
+{
+    if (!region) return 0;
+    memset(region,0,sizeof(*region));
+    if (!Psyz_FontIdentityValidate(token)) return 0;
+    *region = font_capture->slots[token->slot].region;
+    return 1;
+}
+
+int Psyz_FontIdentityForeground(const PsyzFontToken *token, unsigned index,
+                                uint16_t *word)
+{
+    if (!word) return 0;
+    *word = 0;
+    if (!Psyz_FontIdentityValidate(token)) return 0;
+    FontWordRect palette = font_capture->slots[token->slot].palette;
+    if (index >= palette.w) return 0;
+    size_t at = palette.y*FONT_VRAM_W + palette.x + index;
+    if (!font_capture->known[at]) return 0;
+    *word = font_capture->words[at];
+    return 1;
+}
+
+/* No representative UV/palette/intensity is invented by this primitive. */
+int Psyz_FontIdentitySample(unsigned page,unsigned clut,unsigned u,unsigned v,uint16_t *word)
+{
+    if(word)*word=0;
+    if(!word||!font_capture||page&~0x1ffu||clut&~0x7fffu||u>255||v>255)return 0;
+    unsigned depth=(page>>7)&3;
+    if(depth>2)return 0;
+    unsigned x=(page&15)*64+(u>>(2-depth)),y=((page>>4)&1)*256+v;
+    if(x>=FONT_VRAM_W||y>=FONT_VRAM_H)return 0;
+    unsigned at=y*FONT_VRAM_W+x;
+    if(!font_capture->known[at])return 0;
+    uint16_t value=font_capture->words[at];
+    if(depth<2) {
+        unsigned index=depth?((value>>((u&1)*8))&255):((value>>((u&3)*4))&15);
+        x=(clut&63)*16+index;y=clut>>6;
+        if(x>=FONT_VRAM_W||y>=FONT_VRAM_H)return 0;
+        at=y*FONT_VRAM_W+x;
+        if(!font_capture->known[at])return 0;
+        value=font_capture->words[at];
+    }
+    *word=value;return 1;
+}
diff --git a/psyz/src/platform/font_identity.h b/psyz/src/platform/font_identity.h
new file mode 100644
index 0000000000000000000000000000000000000000..7c028d2fc1d4694aa62e66e07688f291b558fc78
--- /dev/null
+++ b/psyz/src/platform/font_identity.h
@@ -0,0 +1,18 @@
+/* MPL-2.0. Renderer-thread ownership for original accepted font words. */
+#ifndef PSYZ_FONT_IDENTITY_CAPTURE_H
+#define PSYZ_FONT_IDENTITY_CAPTURE_H
+#include <psyz/cap_font.h>
+
+/* Starts unknown on a disabled->enabled transition. Returns zero on allocation
+ * or serial exhaustion. Repeating enable on a live tracker keeps valid words. */
+int Psyz_FontIdentityCaptureEnable(int enabled);
+void Psyz_FontIdentityCaptureReset(void);
+void Psyz_FontIdentityCaptureDirty(int x, int y, int w, int h);
+/* Call only after backend acceptance. Input is copied now, never retained. */
+int Psyz_FontIdentityCaptureAccept(int x, int y, int w, int h,
+                                   const uint16_t *words);
+/* Read only an exact current upload-proven original texel. Unknown texture
+ * or palette, unsupported depth, physical wrap or invalid coordinates fail. */
+int Psyz_FontIdentitySample(unsigned page,unsigned clut,unsigned u,unsigned v,
+                            uint16_t *word);
+#endif
diff --git a/psyz/src/platform/fsr1/cpe_fsr1.c b/psyz/src/platform/fsr1/cpe_fsr1.c
new file mode 100644
index 0000000000000000000000000000000000000000..9621ab42350caf38ec4e11f8973407e1f3164835
--- /dev/null
+++ b/psyz/src/platform/fsr1/cpe_fsr1.c
@@ -0,0 +1,115 @@
+// CPE original SDL_GPU integration prototype. AMD FSR1 MIT notices retained.
+#include "cpe_fsr1.h"
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#define A_CPU 1
+#ifdef __clang__
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wignored-qualifiers"
+#pragma clang diagnostic ignored "-Wunused-function"
+#endif
+#include "third_party/fsr1/ffx_a.h"
+#include "third_party/fsr1/ffx_fsr1.h"
+#ifdef __clang__
+#pragma clang diagnostic pop
+#endif
+#include "generated/fsr1_shaders.h"
+
+struct CpeFsr1 {
+    SDL_GPUDevice *device;
+    SDL_GPUGraphicsPipeline *easu, *rcas;
+    SDL_GPUSampler *sampler;
+    SDL_GPUTexture *intermediate, *output;
+    Uint32 width,height;
+    bool enabled;
+};
+static SDL_GPUShader *shader(SDL_GPUDevice *d,const unsigned char *code,
+    size_t size,SDL_GPUShaderStage stage) {
+    SDL_GPUShaderCreateInfo i={0};
+    i.code=code;i.code_size=size;i.entrypoint="main";
+    i.format=SDL_GPU_SHADERFORMAT_SPIRV;i.stage=stage;
+    if(stage==SDL_GPU_SHADERSTAGE_FRAGMENT){i.num_samplers=1;i.num_uniform_buffers=1;}
+    return SDL_CreateGPUShader(d,&i);
+}
+static SDL_GPUGraphicsPipeline *pipeline(CpeFsr1 *s,SDL_GPUShader *vs,SDL_GPUShader *fs) {
+    SDL_GPUColorTargetDescription color={0};
+    color.format=SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT;
+    SDL_GPUGraphicsPipelineCreateInfo i={0};
+    i.vertex_shader=vs;i.fragment_shader=fs;
+    i.primitive_type=SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
+    i.rasterizer_state.fill_mode=SDL_GPU_FILLMODE_FILL;
+    i.multisample_state.sample_count=SDL_GPU_SAMPLECOUNT_1;
+    i.target_info.color_target_descriptions=&color;i.target_info.num_color_targets=1;
+    return SDL_CreateGPUGraphicsPipeline(s->device,&i);
+}
+CpeFsr1 *CpeFsr1_Create(SDL_GPUDevice *d) {
+    if(!d){SDL_SetError("FSR1 requires GPU device");return NULL;}
+    CpeFsr1 *s=SDL_calloc(1,sizeof(*s));if(!s)return NULL;s->device=d;
+    SDL_GPUShader *vs=shader(d,cpe_fullscreen_vert,sizeof(cpe_fullscreen_vert),SDL_GPU_SHADERSTAGE_VERTEX);
+    SDL_GPUShader *e=shader(d,cpe_fsr1_easu_frag,sizeof(cpe_fsr1_easu_frag),SDL_GPU_SHADERSTAGE_FRAGMENT);
+    SDL_GPUShader *r=shader(d,cpe_fsr1_rcas_frag,sizeof(cpe_fsr1_rcas_frag),SDL_GPU_SHADERSTAGE_FRAGMENT);
+    if(vs&&e&&r){s->easu=pipeline(s,vs,e);s->rcas=pipeline(s,vs,r);}
+    if(vs)SDL_ReleaseGPUShader(d,vs);if(e)SDL_ReleaseGPUShader(d,e);if(r)SDL_ReleaseGPUShader(d,r);
+    SDL_GPUSamplerCreateInfo si={0};
+    si.min_filter=si.mag_filter=SDL_GPU_FILTER_LINEAR;
+    si.mipmap_mode=SDL_GPU_SAMPLERMIPMAPMODE_NEAREST;
+    si.address_mode_u=si.address_mode_v=si.address_mode_w=SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+    s->sampler=SDL_CreateGPUSampler(d,&si);
+    if(!s->easu||!s->rcas||!s->sampler){CpeFsr1_Destroy(s);return NULL;}
+    return s; // disabled by zero initialization
+}
+void CpeFsr1_SetEnabled(CpeFsr1 *s,bool enabled){if(s)s->enabled=enabled;}
+static bool targets(CpeFsr1 *s,Uint32 w,Uint32 h) {
+    if(s->width==w&&s->height==h&&s->intermediate&&s->output)return true;
+    // Two RGBA16F textures, at most 256 MiB in total, arithmetic widened first.
+    if(!w||!h||w>8192||h>8192||(uint64_t)w*h*16>256u*1024u*1024u)
+        return SDL_SetError("FSR1 output exceeds isolated budget");
+    SDL_GPUTextureCreateInfo t={0};t.type=SDL_GPU_TEXTURETYPE_2D;
+    t.format=SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT;
+    t.usage=SDL_GPU_TEXTUREUSAGE_SAMPLER|SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;
+    t.width=w;t.height=h;t.layer_count_or_depth=1;t.num_levels=1;t.sample_count=SDL_GPU_SAMPLECOUNT_1;
+    SDL_GPUTexture *a=SDL_CreateGPUTexture(s->device,&t),*b=SDL_CreateGPUTexture(s->device,&t);
+    if(!a||!b){if(a)SDL_ReleaseGPUTexture(s->device,a);if(b)SDL_ReleaseGPUTexture(s->device,b);return false;}
+    // SDL release is deferred for referenced command resources; no raw frees.
+    if(s->intermediate)SDL_ReleaseGPUTexture(s->device,s->intermediate);
+    if(s->output)SDL_ReleaseGPUTexture(s->device,s->output);
+    s->intermediate=a;s->output=b;s->width=w;s->height=h;return true;
+}
+static bool pass(CpeFsr1 *s,SDL_GPUCommandBuffer *cmd,SDL_GPUTexture *src,
+    SDL_GPUTexture *dst,SDL_GPUGraphicsPipeline *p,const void *u,Uint32 bytes) {
+    SDL_GPUColorTargetInfo t={0};t.texture=dst;t.load_op=SDL_GPU_LOADOP_DONT_CARE;
+    t.store_op=SDL_GPU_STOREOP_STORE;t.cycle=true;
+    SDL_GPURenderPass *rp=SDL_BeginGPURenderPass(cmd,&t,1,NULL);if(!rp)return false;
+    SDL_BindGPUGraphicsPipeline(rp,p);
+    SDL_GPUTextureSamplerBinding bind={src,s->sampler};
+    SDL_BindGPUFragmentSamplers(rp,0,&bind,1);
+    SDL_PushGPUFragmentUniformData(cmd,0,u,bytes);
+    SDL_DrawGPUPrimitives(rp,3,1,0,0);SDL_EndGPURenderPass(rp);return true;
+}
+SDL_GPUTexture *CpeFsr1_Record(CpeFsr1 *s,SDL_GPUCommandBuffer *cmd,
+    SDL_GPUTexture *in,Uint32 iw,Uint32 ih,Uint32 ow,Uint32 oh,float sharp) {
+    if(!s||!s->enabled)return NULL;
+    if(!cmd||!in||!iw||!ih||iw>ow||ih>oh||!isfinite(sharp)||sharp<0||sharp>2){
+        SDL_SetError("FSR1 invalid viewport or RCAS sharpness");return NULL;
+    }
+    if(in==s->intermediate||in==s->output){SDL_SetError("FSR1 input aliases output");return NULL;}
+    if(!targets(s,ow,oh))return NULL;
+    AU1 c0[4],c1[4],c2[4],c3[4],rcas[4];Uint32 easu[16];
+    FsrEasuCon(c0,c1,c2,c3,(float)iw,(float)ih,(float)iw,(float)ih,(float)ow,(float)oh);
+    memcpy(easu,c0,16);memcpy(easu+4,c1,16);memcpy(easu+8,c2,16);memcpy(easu+12,c3,16);
+    FsrRcasCon(rcas,sharp);
+    if(!pass(s,cmd,in,s->intermediate,s->easu,easu,sizeof(easu)))return NULL;
+    if(!pass(s,cmd,s->intermediate,s->output,s->rcas,rcas,sizeof(rcas)))return NULL;
+    return s->output;
+}
+void CpeFsr1_Destroy(CpeFsr1 *s){
+    if(!s)return;
+    if(s->intermediate)SDL_ReleaseGPUTexture(s->device,s->intermediate);
+    if(s->output)SDL_ReleaseGPUTexture(s->device,s->output);
+    if(s->sampler)SDL_ReleaseGPUSampler(s->device,s->sampler);
+    if(s->easu)SDL_ReleaseGPUGraphicsPipeline(s->device,s->easu);
+    if(s->rcas)SDL_ReleaseGPUGraphicsPipeline(s->device,s->rcas);
+    SDL_free(s);
+}
diff --git a/psyz/src/platform/fsr1/cpe_fsr1.h b/psyz/src/platform/fsr1/cpe_fsr1.h
new file mode 100644
index 0000000000000000000000000000000000000000..4a5950a3573467f567843eeb3edd50dc9e2b17b5
--- /dev/null
+++ b/psyz/src/platform/fsr1/cpe_fsr1.h
@@ -0,0 +1,25 @@
+#ifndef CPE_FSR1_H
+#define CPE_FSR1_H
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_gpu.h>
+// Isolated integration prototype, not linked into the playable game.
+// Call only on the renderer thread, outside any active copy/render pass.
+// Default is disabled. Original presentation remains the caller's fallback.
+typedef struct CpeFsr1 CpeFsr1;
+CpeFsr1 *CpeFsr1_Create(SDL_GPUDevice *device);
+void CpeFsr1_SetEnabled(CpeFsr1 *state, bool enabled);
+// Input must be a dedicated, compact, single-sample SDR UNORM texture with
+// SAMPLER usage. Do NOT pass the VRAM atlas or a cropped subregion: copy the
+// exact already-composed game rectangle to its own texture first. UI is drawn
+// AFTER the returned image is composed into the aspect-preserving destination.
+// Input RGB must already be display-referred (no sRGB sampler conversion).
+// Both input dimensions <= output dimensions. No downscale or frame generation.
+// sharpness_stops: 0 strongest RCAS, 2 weak. Errors never submit/cancel cmd.
+// NULL means no FSR output: caller must choose original presentation or cancel
+// its unsubmitted frame; no raw/unfiltered image is labelled FSR by this API.
+SDL_GPUTexture *CpeFsr1_Record(CpeFsr1 *state, SDL_GPUCommandBuffer *cmd,
+    SDL_GPUTexture *input, Uint32 input_w, Uint32 input_h,
+    Uint32 output_w, Uint32 output_h, float sharpness_stops);
+// Caller retains device until destroyed, after outstanding commands retire.
+void CpeFsr1_Destroy(CpeFsr1 *state);
+#endif
diff --git a/psyz/src/platform/fsr1/generated/fsr1_shaders.h b/psyz/src/platform/fsr1/generated/fsr1_shaders.h
new file mode 100644
index 0000000000000000000000000000000000000000..7c22b809e03e79b9c0c1cfdaff8c5c0bda66fb98
--- /dev/null
+++ b/psyz/src/platform/fsr1/generated/fsr1_shaders.h
