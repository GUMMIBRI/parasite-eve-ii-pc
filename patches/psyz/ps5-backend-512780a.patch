diff --git a/psyz/include/psyz/hd_background.h b/psyz/include/psyz/hd_background.h
new file mode 100644
index 0000000000000000000000000000000000000000..4e57d126609554e4e640135a12161f355784f4cf
--- /dev/null
+++ b/psyz/include/psyz/hd_background.h
@@ -0,0 +1,45 @@
+/* MPL-2.0. Original still-image producer ownership contract. */
+#ifndef PSYZ_HD_BACKGROUND_H
+#define PSYZ_HD_BACKGROUND_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct PsyzHdBackgroundUpload {
+ uint64_t uploadFrameSerial; /* UNIQUE invocation, independent of decode generation */
+ uint64_t generation, sourceHash[2]; /* XXH3-128 low/high, RGB16 LE full rows */
+ uint64_t stripHash[2]; /* complete 16x240 column, only when stripWidth=16 */
+ unsigned stripWidth;
+ unsigned sourceWidth, sourceHeight, cropX, cropY, cropWidth, cropHeight;
+} PsyzHdBackgroundUpload;
+/* One event per actual displayUploadBackgroundImage invocation. Unknown still
+ * publishes a clear frame with unique serial and known=0. Serial0 is reserved
+ * exhausted/invalid and can NEVER admit wide. Values copied, never retained. */
+typedef struct PsyzHdBackgroundFrame {
+ uint64_t uploadFrameSerial,generation,sourceHash[2];
+ unsigned sourceWidth,sourceHeight,known;
+} PsyzHdBackgroundFrame;
+/* Renderer owns these neutral endpoints and callback/collector storage.
+ * No renderer-to-game unresolved references. Source may be known even with
+ * ordinary HD option Off; look up once if HD OR wide needs source ownership.
+ * Begin/End are synchronous render-thread notifications, NOT reentrant game
+ * calls or proof that any original native GPU copy succeeded.
+ * Existing SetHdBackgroundLookup(NULL)/native write/reset invalidation MUST
+ * invalidate any open frame collector/source admission as well. */
+void Psyz_GpuBackgroundFrameBegin(const PsyzHdBackgroundFrame *frame);
+void Psyz_GpuBackgroundFrameEnd(uint64_t uploadFrameSerial);
+
+typedef int (*PsyzHdBackgroundLookup)(const uint16_t *, int,int,int,int,
+                                      PsyzHdBackgroundUpload *);
+/* Renderer owns the callback slot; NULL retires it. Only query synchronously
+ * inside the exact LoadImage backend call, and consume only on accepted upload.
+ * Copy descriptor values; never retain a producer pointer. Native VRAM unchanged.
+ * Any other write/reset to destination must retire presentation associations. */
+void Psyz_GpuSetHdBackgroundLookup(PsyzHdBackgroundLookup lookup);
+/* Entry-invalidated receipt: true only for immediately preceding exact successful
+ * backend StoreImage, never merely the legacy public function's return value. */
+int Psyz_GpuLastReadbackAccepted(const void *pixels,int x,int y,int w,int h);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/psyz/include/psyz/hd_upload.h b/psyz/include/psyz/hd_upload.h
new file mode 100644
index 0000000000000000000000000000000000000000..271f3ed1d6c4b24c98b0c731ab8ec7e4981d5915
--- /dev/null
+++ b/psyz/include/psyz/hd_upload.h
@@ -0,0 +1,60 @@
+/* MPL-2.0. Independently authored accepted-upload provenance. No DuckStation code. */
+#ifndef PE2_HD_UPLOAD_H
+#define PE2_HD_UPLOAD_H
+#include <stdint.h>
+#include <SDL3/SDL.h>
+typedef struct Pe2HdUpload Pe2HdUpload;
+typedef struct {
+    unsigned mode,sw,sh,x,y,w,h,hi;
+    uint64_t texture,palette;
+    char name[256];
+}
+Pe2HdUploadIdentity;
+typedef struct {
+    unsigned x,y,w,h;
+    uint64_t generation,identity_key;
+}
+Pe2HdUploadMatch;
+Pe2HdUpload *Pe2HdUploadCreate(void);
+void Pe2HdUploadDestroy(Pe2HdUpload *state);
+void Pe2HdUploadReset(Pe2HdUpload *state);
+void Pe2HdUploadDirty(Pe2HdUpload *state,int x,int y,int w,int h);
+/* Consumed accepted raw upload only. Not enqueue-time or reconstructed RGBA. */
+int Pe2HdUploadAccept(Pe2HdUpload *state,int x,int y,int w,int h,const uint16_t *words);
+void Pe2HdUploadClearOwners(Pe2HdUpload *state);
+/* Only final packet descriptors from the actual player model producer. */
+int Pe2HdUploadRegisterOwner(Pe2HdUpload *state,unsigned page,unsigned clut);
+/* Strict texupload P4/P8 filename schema; zero palette minimum only. */
+int Pe2HdUploadParse(const char *basename,Pe2HdUploadIdentity *identity);
+/* Caller rejects texture windows/wrap. UV = original integer polygon corners.
+ * Zero means original fallback, including lost lineage/changed palette.
+ * Match is valid only until generation changes. No draw/mesh modification. */
+int Pe2HdUploadResolve(const Pe2HdUpload *state,const Pe2HdUploadIdentity *identity,unsigned page,unsigned clut,const unsigned char *uv,unsigned vertices,Pe2HdUploadMatch *match);
+int Pe2HdUploadMatchCurrent(const Pe2HdUpload *state,const Pe2HdUploadMatch *match);
+SDL_Surface *Pe2HdUploadLoad(const Pe2HdUpload *state,const char *root,const Pe2HdUploadIdentity *identity,const Pe2HdUploadMatch *match);
+/* Renderer-hook singleton: dormant until explicit host enable. All GPU hooks
+ * and matching must run on the same renderer thread, no callback locking. */
+Pe2HdUpload *Psyz_HdUploadState(void);
+int Psyz_HdUploadEnable(int enabled);
+typedef struct Pe2HdUploadIndex Pe2HdUploadIndex;
+Pe2HdUploadIndex *Pe2HdUploadIndexOpen(const char *external_index_path);
+void Pe2HdUploadIndexClose(Pe2HdUploadIndex *index);
+int Pe2HdUploadFind(const Pe2HdUpload *state,const Pe2HdUploadIndex *index,unsigned page,unsigned clut,const unsigned char *uv,unsigned vertices,Pe2HdUploadIdentity *identity,Pe2HdUploadMatch *match);
+uint64_t Pe2HdUploadGeneration(const Pe2HdUpload *state);
+int Psyz_GpuSetHdUploadCharacters(int enabled,const char *root);
+const char *Psyz_GpuHdUploadCharactersStatus(void);
+/* Bounded native model-packet provenance. Keys are opaque: only the game's
+ * live create/build/draw/retire producers supply them. Retained values are not
+ * dereferenced. Texture snapshots contain all original UV/page/CLUT values. */
+void Psyz_HdModelCreate(const void *model);
+void Psyz_HdModelRetire(const void *model,int destroy);
+void Psyz_HdModelBuild(const void *model,const void *source,const void *buffer,unsigned halfBytes,unsigned half);
+void Psyz_HdModelDraw(const void *model,const void *source,const void *buffer,unsigned halfBytes,unsigned half);
+void Psyz_HdModelRegister(const void *model,const void *payload,unsigned payloadBytes,unsigned vertices,unsigned gouraud,unsigned page,unsigned clut,const unsigned char uv[8]);
+void Psyz_HdModelCopyPacket(const void *from,const void *to);
+void Psyz_HdModelResetQueued(void);
+void Psyz_HdModelResetAll(int destroy);
+void Psyz_HdModelConsumePacket(const void *packet);
+int Psyz_HdModelPacketCurrent(const void *packet,unsigned code,unsigned page,unsigned clut,const unsigned char *uv,unsigned vertices);
+int Pe2HdUploadFindPacket(const Pe2HdUpload *state,const Pe2HdUploadIndex *index,const void *packet,unsigned code,unsigned page,unsigned clut,const unsigned char *uv,unsigned vertices,Pe2HdUploadIdentity *identity,Pe2HdUploadMatch *match);
+#endif
