diff --git a/psyz/src/platform/shaders/pe2_background.frag.glsl b/psyz/src/platform/shaders/pe2_background.frag.glsl
new file mode 100644
index 0000000000000000000000000000000000000000..4b5ceee04956fe974fcf75d8a2dfb9cb7afce902
--- /dev/null
+++ b/psyz/src/platform/shaders/pe2_background.frag.glsl
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: MPL-2.0
+// Presentation-only exact-source still replacement. Native mask bits survive.
+#version 450
+layout(set=2,binding=0) uniform sampler2D replacement;
+layout(set=2,binding=1) uniform sampler2D native_vram;
+layout(set=3,binding=0,std140) uniform BackgroundParameters {
+    vec4 destination; // scaled x,y,w,h
+    vec4 source;      // normalized x,y,w,h in the replacement
+    vec4 scale;       // internal scale, unused
+} parameters;
+layout(location=0) out vec4 output_color;
+void main() {
+    vec2 local=(gl_FragCoord.xy-parameters.destination.xy)/parameters.destination.zw;
+    vec2 uv=parameters.source.xy+local*parameters.source.zw;
+    ivec2 native_coordinate=ivec2(floor(gl_FragCoord.xy/parameters.scale.x));
+    output_color=vec4(texture(replacement,uv).rgb,texelFetch(native_vram,native_coordinate,0).a);
+}
