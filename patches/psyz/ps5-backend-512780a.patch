+        if(f->style!=style||f->foreground!=foreground||!PlexCapMetricSame(f,metrics,count)||
+           f->region.page!=region.page||f->region.clut!=region.clut||f->region.u!=region.u||f->region.v!=region.v||
+           f->region.w!=region.w||f->region.h!=region.h)continue;
+        int same=1;for(unsigned j=0;j<2;++j)if(f->identity.texture[j]!=identity.texture[j]||f->identity.palette[j]!=identity.palette[j])same=0;
