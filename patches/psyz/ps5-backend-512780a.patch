+    if(m->canvasW<428||m->canvasW>640||m->canvasH!=240||m->centreY||m->centreW!=320||m->centreH!=240||
+       m->centreX<54||m->centreX>m->canvasW-320||m->canvasW-m->centreX-320<54||!m->scale||m->scale>8||
+       !m->provenance[0]||!memchr(m->provenance,0,sizeof m->provenance)||
