@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: MIT
+ * Native presentation policy, independent of emulated VRAM and window mode. */
+#ifndef PSYZ_MOVIE_POLICY_H
+#define PSYZ_MOVIE_POLICY_H
+#include <SDL3/SDL_gpu.h>
+#include <stdint.h>
+
+enum { PSYZ_MOVIE_ORIGINAL=0, PSYZ_MOVIE_GENTLE=1,
+       PSYZ_MOVIE_STRONGER=2, PSYZ_MOVIE_BLOCK_SMOOTHING=3 };
+enum { PSYZ_MOVIE_FRAME_ORIGINAL_BLURRED=0, PSYZ_MOVIE_FRAME_FILL=1 };
+void Psyz_VideoSetMovieCleanup(int mode);
+int Psyz_VideoGetMovieCleanup(void);
+const char *Psyz_VideoMovieCleanupStatus(void);
+void Psyz_VideoSetMovieFraming(int mode);
+int Psyz_VideoGetMovieFraming(void);
+void Psyz_VideoSetGameplayFill(int enabled);
+int Psyz_VideoGetGameplayFill(void);
+
+/* Static renderer-owned storage; Init allocates nothing. Only one renderer
+ * instance owns these presentation settings. Destroy after normal GPU retirement. */
+typedef struct {
+    SDL_GPUDevice *device;
+    void *cleanup;
+    uint64_t option_revision;
+    uint32_t movie_serial;
+    Uint32 logical_w, logical_h;
+    int seen_movie, failed;
+} PsyzMoviePolicy;
+typedef struct {
+    SDL_GPUBlitRegion source;
+    SDL_Rect destination;
+    Uint32 texture_w, texture_h;
+    int blurred_sides, cleanup_recorded;
+} PsyzMoviePresentation;
+void Psyz_MoviePolicyInit(PsyzMoviePolicy *state, SDL_GPUDevice *device);
+void Psyz_MoviePolicyDestroy(PsyzMoviePolicy *state);
+/* Actual movie activity/serial come from PE2's decoded-frame lifecycle. Do not
+ * infer them from texture size, RGB24, screen content or selected movie mode.
+ * Texture extents describe the actual source allocation, not the crop. logical
+ * dimensions are the decoded frame's authored dimensions. debug VRAM bypasses
+ * this entire policy at the renderer callsite. No render/copy pass may be open.
+ * Record before backdrop, upscale/filter and host overlay; never write the
+ * returned presentation texture back into VRAM/readback or save-state paths. */
+PsyzMoviePresentation Psyz_MoviePolicyPresent(PsyzMoviePolicy *state,
+    SDL_GPUCommandBuffer *command, SDL_GPUBlitRegion source,
+    Uint32 texture_w, Uint32 texture_h, int actual_movie, uint32_t movie_serial,
+    Uint32 logical_w, Uint32 logical_h, int viewport_w, int viewport_h,
+    SDL_Rect original_destination);
+/* Failed command submission/retirement latches original until a fresh movie
+ * serial or explicit cleanup choice. This never submits, waits or retries. */
+void Psyz_MoviePolicySubmissionFailed(PsyzMoviePolicy *state);
+#endif
