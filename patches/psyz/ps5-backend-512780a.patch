+}
+static int PlexCapMetricQuad(const PlexMark *mark,unsigned left,unsigned top,unsigned right,unsigned bottom)
+{
+    PlexCapMetric *f=PlexCapMetricFind(mark->atlas_key);
+    if(!f||Psyz_VideoGetInternalResolution()<=1||mark->cell>=f->count||!f->supported[mark->cell]||
+       !Psyz_FontIdentityValidate(&f->token)||mark->foreground!=f->foreground)return 0;
+    const PsyzCapFontMetric *m=&f->metrics[mark->cell];
+    return left==m->u&&top==m->v&&right==m->u+m->width&&bottom==m->v+m->height;
+}
+#endif
diff --git a/psyz/src/platform/pe2_font_profiles.h b/psyz/src/platform/pe2_font_profiles.h
new file mode 100644
index 0000000000000000000000000000000000000000..be37156ea2bb4275965948d0755f47d95ce08531
--- /dev/null
+++ b/psyz/src/platform/pe2_font_profiles.h
@@ -0,0 +1,22 @@
+/* MPL-2.0 profile routing, adapted from MIT PE1 Build17
+ * PeFont_TrueTypeData. Font bytes retain SIL OFL1.1 (see adjacent notices).
+ * No game glyph data, resource identities or private bindings are included. */
+#ifndef PE2_FONT_PROFILES_H
+#define PE2_FONT_PROFILES_H
+#include <psyz/font_profiles.h>
+#ifdef PE2_PS5_HOST
+#include "../../../../../src/port/ui/fonts/chakra_petch_bold.ttf.inc"
+#include "../../../../../src/port/ui/fonts/atkinson_hyperlegible_regular.ttf.inc"
+#endif
+static const unsigned char *PlexProfileData(unsigned style) {
+    if (style==PSYZ_FONT_PLEX) return ibm_plex_sans_ttf;
+#ifdef PE2_PS5_HOST
+    if (style==PSYZ_FONT_RETRO) return chakra_petch_bold_ttf;
+    if (style==PSYZ_FONT_ATKINSON) return atkinson_hyperlegible_regular_ttf;
+#endif
+    return NULL;
+}
+static uint64_t PlexProfileKey(unsigned style,int hud) {
+    return UINT64_C(0x504532464f4e5400) | ((uint64_t)!!hud<<4) | style;
+}
+#endif
diff --git a/psyz/src/platform/pe2_hd_model.h b/psyz/src/platform/pe2_hd_model.h
new file mode 100644
index 0000000000000000000000000000000000000000..729f3c815ce120c542ecfda35eb8bdc3a9ac8b4f
--- /dev/null
+++ b/psyz/src/platform/pe2_hd_model.h
@@ -0,0 +1,129 @@
+/* MPL-2.0. Original bounded by-value model and copied GPU-packet provenance.
+ * Included once by pe2_hd_upload.c. No retained model/source/buffer dereference. */
+#ifdef PE2_PS5_HOST
+#define HD_MODEL_COUNT 128u
+#define HD_MODEL_PACKETS 8192u
+#define HD_MODEL_QUEUED 4096u
+#define HD_MODEL_PROBES 16u
+typedef struct {
+    const void *key,*source,*buffer;
+    unsigned halfBytes,building;
+    uint64_t generation[2];
+    unsigned char ready[2],blocked[2];
+} HdModelOwner;
+typedef struct {
+    const void *packet;
+    uint64_t generation;
+    unsigned short owner;
+    unsigned char half,vertices,gouraud,uv[8];
+    unsigned short page,clut;
+} HdModelPacket;
+static HdModelOwner hd_model_owners[HD_MODEL_COUNT];
+static HdModelPacket hd_model_packets[HD_MODEL_PACKETS],hd_model_queued[HD_MODEL_QUEUED];
+static uint64_t hd_model_generation;
+static unsigned HdModelHash(const void *p,unsigned mask){uintptr_t x=(uintptr_t)p;x^=x>>17;x*=UINT64_C(0x9e3779b97f4a7c15);x^=x>>29;return (unsigned)x&mask;}
+static HdModelOwner *HdModelOwnerFind(const void *key){for(unsigned i=0;i<HD_MODEL_COUNT;++i)if(hd_model_owners[i].key==key)return &hd_model_owners[i];return NULL;}
+static uint64_t HdModelNext(void){return hd_model_generation==UINT64_MAX?0:++hd_model_generation;}
+static int HdModelLive(const HdModelPacket *p){
+    if(!p->packet||!p->generation||p->owner>=HD_MODEL_COUNT||p->half>1)return 0;
+    const HdModelOwner *o=&hd_model_owners[p->owner];
+    return o->key&&!o->blocked[p->half]&&o->generation[p->half]==p->generation;
+}
+/* Probe a fixed number even through empty slots; stale records can be recycled
+ * without breaking an open-address chain. Capacity/collision failures decline. */
+static HdModelPacket *HdModelFind(HdModelPacket *table,unsigned count,const void *key,int insert){
+    unsigned at=HdModelHash(key,count-1);HdModelPacket *freeSlot=NULL;
+    for(unsigned i=0;i<HD_MODEL_PROBES;++i,at=(at+1)&(count-1)){
+        HdModelPacket *p=&table[at];
+        if(p->packet==key)return p;
+        if(!freeSlot&&!HdModelLive(p))freeSlot=p;
+    }
+    return insert?freeSlot:NULL;
+}
+void Psyz_HdModelCreate(const void *model){
+    if(!model)return;HdModelOwner *o=HdModelOwnerFind(model);
+    if(!o)for(unsigned i=0;i<HD_MODEL_COUNT;++i)if(!hd_model_owners[i].key){o=&hd_model_owners[i];break;}
+    if(o){memset(o,0,sizeof(*o));o->key=model;}
+}
+void Psyz_HdModelRetire(const void *model,int destroy){
+    HdModelOwner *o=HdModelOwnerFind(model);if(!o)return;
+    o->generation[0]=o->generation[1]=0;o->ready[0]=o->ready[1]=0;
+    o->buffer=NULL;o->source=NULL;o->halfBytes=0;
+    if(destroy)memset(o,0,sizeof(*o));
+}
+static int HdModelRange(const void *buffer,unsigned halfBytes,unsigned half,uintptr_t *first,uintptr_t *last){
+    uintptr_t b=(uintptr_t)buffer;
+    if(!b||!halfBytes||half>1||halfBytes>65535u||b>UINTPTR_MAX-(uintptr_t)halfBytes*2)return 0;
+    *first=b+(uintptr_t)halfBytes*half;*last=*first+halfBytes;return 1;
+}
+void Psyz_HdModelBuild(const void *model,const void *source,const void *buffer,unsigned halfBytes,unsigned half){
+    HdModelOwner *o=HdModelOwnerFind(model);uintptr_t first,last;
+    if(!o)return;
+    if(!source||!HdModelRange(buffer,halfBytes,half,&first,&last)){Psyz_HdModelRetire(model,0);return;}
+    if(o->source!=source||o->buffer!=buffer||o->halfBytes!=halfBytes){Psyz_HdModelRetire(model,0);o->source=source;o->buffer=buffer;o->halfBytes=halfBytes;}
+    o->building=half;o->ready[half]=0;o->blocked[half]=0;o->generation[half]=HdModelNext();
+    if(!o->generation[half])o->blocked[half]=1;
+}
+void Psyz_HdModelDraw(const void *model,const void *source,const void *buffer,unsigned halfBytes,unsigned half){
+    HdModelOwner *o=HdModelOwnerFind(model);
+    if(!o||half>1)return;
+    if(o->source!=source||o->buffer!=buffer||o->halfBytes!=halfBytes){Psyz_HdModelRetire(model,0);return;}
+    o->ready[half]=o->generation[half]&&!o->blocked[half];
+}
+void Psyz_HdModelRegister(const void *model,const void *payload,unsigned payloadBytes,unsigned vertices,unsigned gouraud,unsigned page,unsigned clut,const unsigned char uv[8]){
+    HdModelOwner *o=HdModelOwnerFind(model);uintptr_t first,last,p=(uintptr_t)payload;
+    if(!o||o->building>1||!uv)return;
+    unsigned half=o->building;
+    unsigned words=1+vertices*(2+gouraud)-gouraud;
+    if(!o->generation[half]||o->blocked[half])return;
+    if((vertices!=3&&vertices!=4)||gouraud>1||((page>>7)&3)>1||clut>32767||
+       payloadBytes!=words*4||!HdModelRange(o->buffer,o->halfBytes,half,&first,&last)||p<first||p-first<2*sizeof(uintptr_t)||p>last||payloadBytes>last-p||p%4){o->blocked[half]=1;o->ready[half]=0;return;}
+    HdModelPacket *entry=HdModelFind(hd_model_packets,HD_MODEL_PACKETS,payload,1);
+    if(!entry){o->blocked[half]=1;o->ready[half]=0;return;}
+    if(HdModelLive(entry)){
+        if(entry->owner!=(unsigned)(o-hd_model_owners)||entry->half!=half||entry->generation!=o->generation[half]||
+           entry->vertices!=vertices||entry->gouraud!=gouraud||entry->page!=(page&511)||entry->clut!=clut||memcmp(entry->uv,uv,vertices*2)){
+            HdModelOwner *previous=&hd_model_owners[entry->owner];previous->blocked[entry->half]=1;previous->ready[entry->half]=0;
+            o->blocked[half]=1;o->ready[half]=0;return;
+        }
+    }
+    *entry=(HdModelPacket){0};entry->packet=payload;entry->generation=o->generation[half];
+    entry->owner=(unsigned short)(o-hd_model_owners);entry->half=(unsigned char)half;
+    entry->vertices=(unsigned char)vertices;entry->gouraud=(unsigned char)gouraud;
+    entry->page=(unsigned short)(page&511);entry->clut=(unsigned short)clut;memcpy(entry->uv,uv,vertices*2);
+}
+void Psyz_HdModelCopyPacket(const void *from,const void *to){
+    if(!to)return;
+    HdModelPacket *old=HdModelFind(hd_model_queued,HD_MODEL_QUEUED,to,0);
+    if(old)memset(old,0,sizeof(*old));
+    HdModelPacket *source=HdModelFind(hd_model_packets,HD_MODEL_PACKETS,from,0);
+    if(!source||!HdModelLive(source)||!hd_model_owners[source->owner].ready[source->half])return;
+    HdModelPacket *target=HdModelFind(hd_model_queued,HD_MODEL_QUEUED,to,1);
+    if(target){*target=*source;target->packet=to;}
+}
+void Psyz_HdModelResetQueued(void){memset(hd_model_queued,0,sizeof(hd_model_queued));for(unsigned i=0;i<HD_MODEL_COUNT;++i)hd_model_owners[i].ready[0]=hd_model_owners[i].ready[1]=0;}
+void Psyz_HdModelResetAll(int destroy){
+    memset(hd_model_queued,0,sizeof(hd_model_queued));memset(hd_model_packets,0,sizeof(hd_model_packets));
+    for(unsigned i=0;i<HD_MODEL_COUNT;++i)if(hd_model_owners[i].key)Psyz_HdModelRetire(hd_model_owners[i].key,destroy);
+}
+void Psyz_HdModelConsumePacket(const void *packet){HdModelPacket *p=HdModelFind(hd_model_queued,HD_MODEL_QUEUED,packet,0);if(p)memset(p,0,sizeof(*p));}
+int Psyz_HdModelPacketCurrent(const void *packet,unsigned code,unsigned page,unsigned clut,const unsigned char *uv,unsigned vertices){
+    HdModelPacket *p=HdModelFind(hd_model_queued,HD_MODEL_QUEUED,packet,0);
+    if(!p)p=HdModelFind(hd_model_packets,HD_MODEL_PACKETS,packet,0);
+    if(!p||!uv||!HdModelLive(p)||!hd_model_owners[p->owner].ready[p->half]||
+       vertices!=p->vertices||clut!=p->clut||(page&511)!=p->page||
+       (code&~3u)!=(0x24u|(p->gouraud?0x10u:0)|(vertices==4?8u:0)))return 0;
+    return !memcmp(uv,p->uv,vertices*2);
+}
+#else
+void Psyz_HdModelCreate(const void *m){(void)m;}
+void Psyz_HdModelRetire(const void *m,int d){(void)m;(void)d;}
+void Psyz_HdModelBuild(const void*m,const void*s,const void*b,unsigned n,unsigned h){(void)m;(void)s;(void)b;(void)n;(void)h;}
+void Psyz_HdModelDraw(const void*m,const void*s,const void*b,unsigned n,unsigned h){(void)m;(void)s;(void)b;(void)n;(void)h;}
+void Psyz_HdModelRegister(const void*m,const void*p,unsigned n,unsigned v,unsigned g,unsigned t,unsigned c,const unsigned char u[8]){(void)m;(void)p;(void)n;(void)v;(void)g;(void)t;(void)c;(void)u;}
+void Psyz_HdModelCopyPacket(const void*f,const void*t){(void)f;(void)t;}
+void Psyz_HdModelResetQueued(void){}
+void Psyz_HdModelResetAll(int d){(void)d;}
+void Psyz_HdModelConsumePacket(const void*p){(void)p;}
+int Psyz_HdModelPacketCurrent(const void*p,unsigned c,unsigned t,unsigned l,const unsigned char*u,unsigned v){(void)p;(void)c;(void)t;(void)l;(void)u;(void)v;return 0;}
+#endif
diff --git a/psyz/src/platform/pe2_hd_render.h b/psyz/src/platform/pe2_hd_render.h
new file mode 100644
index 0000000000000000000000000000000000000000..1d7949c6ae4c025ea4dad0aba6b0473478d84f86
--- /dev/null
+++ b/psyz/src/platform/pe2_hd_render.h
@@ -0,0 +1,194 @@
+/* MPL-2.0. Optional immutable character surface atlas adapter.
+ * Included by sdl3_gpu.c after existing renderer/atlas helpers are declared. */
+#include <limits.h>
+#define PE2_HD_IMAGE_CAPACITY 128u
+#define PE2_HD_QUERY_CAPACITY 256u
+#define PE2_HD_IMAGE_BUDGET (16u * 1024u * 1024u)
+#define PE2_HD_RESERVED_ROWS 16u
+typedef struct {
+    char name[256];
+    unsigned x, y, w, h;
+    int logged, valid;
+} Pe2HdAtlasImage;
+typedef struct {
+    uint64_t generation;
+    unsigned page, clut, vertices;
+    unsigned char uv[8];
+    int matched;
+    Pe2HdUploadIdentity identity;
+    Pe2HdUploadMatch match;
+} Pe2HdDrawQuery;
+static Pe2HdUploadIndex *pe2_hd_index;
+static char pe2_hd_root[1024];
+static int pe2_hd_requested;
+static Pe2HdAtlasImage pe2_hd_images[PE2_HD_IMAGE_CAPACITY];
+static Pe2HdDrawQuery pe2_hd_queries[PE2_HD_QUERY_CAPACITY];
+static unsigned pe2_hd_image_count, pe2_hd_query_next, pe2_hd_image_bytes;
+static int pe2_hd_reserved;
+static unsigned pe2_hd_base, pe2_hd_cursor_x, pe2_hd_cursor_y, pe2_hd_row_height;
+static unsigned pe2_hd_queued;
+static unsigned pe2_hd_hit_log_budget = 16;
+static void Pe2HdRenderRetiredReset(void)
+{
+    /* Caller has retired old atlas readers through the existing room fence. */
+    memset(pe2_hd_images, 0, sizeof pe2_hd_images);
+    memset(pe2_hd_queries, 0, sizeof pe2_hd_queries);
+    pe2_hd_image_count = pe2_hd_query_next = pe2_hd_image_bytes = 0;
+    pe2_hd_reserved = 0;
+    pe2_hd_base = pe2_hd_cursor_x = pe2_hd_cursor_y = pe2_hd_row_height = 0;
+    Pe2HdUploadReset(Psyz_HdUploadState());
+}
+static void Pe2HdRenderQuit(void)
+{
+    Pe2HdUploadIndexClose(pe2_hd_index);
+    pe2_hd_index = NULL;
+    pe2_hd_requested = 0;
+    Pe2HdRenderRetiredReset();
+}
+int Psyz_GpuSetHdUploadCharacters(int enabled, const char *root)
+{
+    if (root && root[0] && strcmp(root, pe2_hd_root)) {
+        /* Do not reinterpret live immutable images as another pack. */
+        if (pe2_hd_image_count || strlen(root) >= sizeof pe2_hd_root) return -1;
+        char index_path[1200];
+        if (SDL_snprintf(index_path, sizeof index_path, "%s/upload-index.txt", root) >= (int)sizeof index_path) return -1;
+        Pe2HdUploadIndex *candidate = Pe2HdUploadIndexOpen(index_path);
+        if (!candidate) return -1;
+        Pe2HdUploadIndexClose(pe2_hd_index);
+        pe2_hd_index = candidate;
+        SDL_strlcpy(pe2_hd_root, root, sizeof pe2_hd_root);
+        memset(pe2_hd_queries, 0, sizeof pe2_hd_queries);
+    }
+    if (enabled && (!pe2_hd_index || !Psyz_HdUploadEnable(1))) return -1;
+    pe2_hd_requested = !!enabled;
+    /* Keep source provenance/immutable pixels during toggles. Cold launch is
+     * still required when enabling after source uploads have already passed. */
+    return 0;
+}
+const char *Psyz_GpuHdUploadCharactersStatus(void)
+{
+    if (!pe2_hd_requested) return "Off";
+    if (!pe2_hd_index) return "Pack unavailable";
+    if (UseSoftwareBackend()) return "Hardware renderer required";
+    if (!scaled_vram_render || internal_res <= 1) return "Needs render scale above 1x";
+    return pe2_hd_queued ? "Replacement polygons queued" : "Waiting for exact player upload match";
+}
+static Pe2HdAtlasImage *Pe2HdAtlasAdmit(const Pe2HdUploadIdentity *identity,
+                                      const Pe2HdUploadMatch *match)
+{
+    for (unsigned i = 0; i < pe2_hd_image_count; ++i) {
+        if (!strcmp(pe2_hd_images[i].name, identity->name))
+            return pe2_hd_images[i].valid ? &pe2_hd_images[i] : NULL;
+    }
+    if (pe2_hd_image_count == PE2_HD_IMAGE_CAPACITY) return NULL;
+    Pe2HdAtlasImage *image = &pe2_hd_images[pe2_hd_image_count++];
+    SDL_strlcpy(image->name, identity->name, sizeof image->name);
+    SDL_Surface *rgba = Pe2HdUploadLoad(Psyz_HdUploadState(), pe2_hd_root, identity, match);
+    if (!rgba) return NULL;
+    unsigned width = (unsigned)rgba->w, height = (unsigned)rgba->h;
+    unsigned aw = width + 4, ah = height + 4;
+    unsigned base = pe2_hd_base, sx = pe2_hd_cursor_x, sy = pe2_hd_cursor_y;
+    unsigned row_height = pe2_hd_row_height;
+    if (!pe2_hd_reserved) base = (sprite_atlas_cells + HD_ATLAS_COLUMNS - 1) / HD_ATLAS_COLUMNS * HD_ATLAS_COLUMNS;
+    unsigned cells = PE2_HD_RESERVED_ROWS * HD_ATLAS_COLUMNS;
+    if (sx + aw > HD_ATLAS_WIDTH) { sx = 0; sy += row_height; row_height = 0; }
+    size_t bytes = (size_t)aw * ah * 4;
+    if (base > HD_ATLAS_COLUMNS * HD_ATLAS_ROWS || cells > HD_ATLAS_COLUMNS * HD_ATLAS_ROWS - base ||
+        aw > HD_ATLAS_WIDTH || sy + ah > PE2_HD_RESERVED_ROWS * 68 || bytes > PE2_HD_IMAGE_BUDGET - pe2_hd_image_bytes) {
+        SDL_DestroySurface(rgba);
+        return NULL;
+    }
+    if (!sprite_atlas_texture) {
+        SDL_GPUTextureCreateInfo info = {.type=SDL_GPU_TEXTURETYPE_2D, .format=SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+            .usage=SDL_GPU_TEXTUREUSAGE_SAMPLER, .width=HD_ATLAS_WIDTH, .height=HD_ATLAS_HEIGHT,
+            .layer_count_or_depth=1, .num_levels=1};
+        sprite_atlas_texture = SDL_CreateGPUTexture(device, &info);
+    }
+    if (!sprite_atlas_sampler) {
+        SDL_GPUSamplerCreateInfo info = {.min_filter=SDL_GPU_FILTER_LINEAR, .mag_filter=SDL_GPU_FILTER_LINEAR,
+            .mipmap_mode=SDL_GPU_SAMPLERMIPMAPMODE_NEAREST, .address_mode_u=SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+            .address_mode_v=SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE, .address_mode_w=SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE};
+        sprite_atlas_sampler = SDL_CreateGPUSampler(device, &info);
+    }
+    SDL_GPUTransferBufferCreateInfo info = {.usage=SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD, .size=(Uint32)bytes};
+    SDL_GPUTransferBuffer *upload = sprite_atlas_texture && sprite_atlas_sampler ? SDL_CreateGPUTransferBuffer(device, &info) : NULL;
+    unsigned char *mapped = upload ? SDL_MapGPUTransferBuffer(device, upload, false) : NULL;
+    if (!mapped) {
+        if (upload) SDL_ReleaseGPUTransferBuffer(device, upload);
+        SDL_DestroySurface(rgba);
+        return NULL;
+    }
+    for (unsigned y = 0; y < ah; ++y) for (unsigned x = 0; x < aw; ++x) {
+        unsigned ix = x < 2 ? 0 : x - 2 >= width ? width - 1 : x - 2;
+        unsigned iy = y < 2 ? 0 : y - 2 >= height ? height - 1 : y - 2;
+        memcpy(mapped + ((size_t)y * aw + x) * 4,
+               (unsigned char *)rgba->pixels + (size_t)iy * rgba->pitch + ix * 4, 4);
+    }
+    SDL_UnmapGPUTransferBuffer(device, upload);
+    SDL_DestroySurface(rgba);
+    SDL_GPUCommandBuffer *cmd = AcquireCmd();
+    SDL_GPUCopyPass *copy = cmd ? SDL_BeginGPUCopyPass(cmd) : NULL;
+    if (!copy) { SDL_ReleaseGPUTransferBuffer(device, upload); return NULL; }
+    unsigned ax = sx, ay = base / HD_ATLAS_COLUMNS * 68 + sy;
+    SDL_GPUTextureTransferInfo from = {.transfer_buffer=upload, .pixels_per_row=aw, .rows_per_layer=ah};
+    SDL_GPUTextureRegion to = {.texture=sprite_atlas_texture, .x=ax, .y=ay, .w=aw, .h=ah, .d=1};
+    /* New immutable cells cannot overlap queued readers. Never flush/rebase
+     * vertex_cur while a primitive is being assembled. */
+    SDL_UploadToGPUTexture(copy, &from, &to, false);
+    SDL_EndGPUCopyPass(copy);
+    SDL_ReleaseGPUTransferBuffer(device, upload);
+    if (!pe2_hd_reserved) { sprite_atlas_cells = base + cells; pe2_hd_base = base; pe2_hd_reserved = 1; }
+    pe2_hd_cursor_x = sx + aw;
+    pe2_hd_cursor_y = sy;
+    pe2_hd_row_height = ah > row_height ? ah : row_height;
+    pe2_hd_image_bytes += (unsigned)bytes;
+    image->x = ax + 2; image->y = ay + 2;
+    image->w = width; image->h = height; image->valid = 1;
+    return image;
+}
+static void Pe2HdApplyPlayerSurface(Vertex *vertices, unsigned count, unsigned page, unsigned clut,const void *packet,unsigned code)
+{
+    Pe2HdUpload *state = Psyz_HdUploadState();
+    if (!pe2_hd_requested || !pe2_hd_index || !state || UseSoftwareBackend() ||
+        !scaled_vram_render || internal_res <= 1 || cur_twin != TWIN_PACK(255,255,0,0) ||
+        (count != 3 && count != 4)) return;
+    unsigned char uv[8] = {0};
+    for (unsigned i = 0; i < count; ++i) {
+        if (vertices[i].hd_uv[2] != 0 || vertices[i].u > 255 || vertices[i].v > 255) return;
+        uv[2*i] = vertices[i].u; uv[2*i+1] = vertices[i].v;
+    }
+    /* Authenticate the actual packet before cache lookup: a prior exact hash
+     * cannot turn an untagged UI/effect primitive into a model-owned draw. */
+    if(!Psyz_HdModelPacketCurrent(packet,code,page,clut,uv,count))return;
+    uint64_t generation = Pe2HdUploadGeneration(state);
+    Pe2HdDrawQuery *query = NULL;
+    for (unsigned i = 0; i < PE2_HD_QUERY_CAPACITY; ++i) {
+        Pe2HdDrawQuery *candidate = &pe2_hd_queries[i];
+        if (candidate->generation == generation && candidate->page == (page & 511) &&
+            candidate->clut == clut && candidate->vertices == count && !memcmp(candidate->uv, uv, sizeof uv)) {
+            query = candidate; break;
+        }
+    }
+    if (!query) {
+        query = &pe2_hd_queries[pe2_hd_query_next++ % PE2_HD_QUERY_CAPACITY];
+        memset(query, 0, sizeof(*query));
+        query->generation = generation; query->page = page & 511; query->clut = clut; query->vertices = count;
+        memcpy(query->uv, uv, sizeof uv);
+        query->matched = Pe2HdUploadFindPacket(state, pe2_hd_index,packet,code, page & 511, clut, uv, count, &query->identity, &query->match);
+    }
+    if (!query->matched) return;
+    Pe2HdAtlasImage *image = Pe2HdAtlasAdmit(&query->identity, &query->match);
+    if (!image) return;
+    for (unsigned i = 0; i < count; ++i) {
+        vertices[i].hd_uv[0] = (image->x + (vertices[i].u - query->match.x) * (float)image->w / query->match.w) / HD_ATLAS_WIDTH;
+        vertices[i].hd_uv[1] = (image->y + (vertices[i].v - query->match.y) * (float)image->h / query->match.h) / HD_ATLAS_HEIGHT;
+        vertices[i].hd_uv[2] = 5;
+    }
+    if (pe2_hd_queued != UINT_MAX) ++pe2_hd_queued;
+    if (!image->logged && pe2_hd_hit_log_budget) {
+        image->logged = 1;
+        --pe2_hd_hit_log_budget;
+        SDL_Log("[PE2 HD] exact-upload replacement polygon queued page=%u clut=%u file=%s vertices=%u original-word-authority=1 visible-pixels=human-unverified",
+                page & 511, clut, image->name, count);
+    }
+}
diff --git a/psyz/src/platform/pe2_hd_upload.c b/psyz/src/platform/pe2_hd_upload.c
new file mode 100644
index 0000000000000000000000000000000000000000..9e9b36ef76947da88e64104a37c7a5171e45cd9d
--- /dev/null
+++ b/psyz/src/platform/pe2_hd_upload.c
@@ -0,0 +1,417 @@
+/* MPL-2.0. Original native accepted-upload provenance and admission module.
+ * xxHash is BSD-2-Clause; its retained notice is in duck_xxhash.h.
+ * Filename/hash interoperability facts only; no DuckStation implementation. */
+#include <psyz/hd_upload.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <limits.h>
+#include "pe2_background_cpu.h"
+#define XXH_STATIC_LINKING_ONLY
+#define XXH_IMPLEMENTATION
+#include "duck_xxhash.h"
+#include "pe2_hd_model.h"
+#define UPLOAD_CAPACITY 256
+struct Upload {
+    unsigned x,y,w,h;
+    uint64_t hash;
+    int active;
+};
+struct Pe2HdUpload {
+    uint16_t words[1024*512];
+    unsigned char known[1024*512];
+    struct Upload uploads[UPLOAD_CAPACITY];
+    unsigned next;
+    unsigned short owners[128];
+    unsigned owner_count;
+    uint64_t generation;
+};
+static Pe2HdUpload *renderer_upload;
+Pe2HdUpload *Psyz_HdUploadState(void) {
+    return renderer_upload;
+}
+int Psyz_HdUploadEnable(int enabled) {
+    if(!enabled) {
+        Pe2HdUploadDestroy(renderer_upload);
+        renderer_upload=NULL;
+        return 1;
+    }
+    if(!renderer_upload)renderer_upload=Pe2HdUploadCreate();
+    return renderer_upload!=NULL;
+}
+Pe2HdUpload *Pe2HdUploadCreate(void) {
+    Pe2HdUpload*p=SDL_calloc(1,sizeof(*p));
+    if(p)p->generation=1;
+    return p;
+}
+void Pe2HdUploadDestroy(Pe2HdUpload*p) {
+    SDL_free(p);
+}
+void Pe2HdUploadReset(Pe2HdUpload*p) {
+    if(p) {
+        uint64_t g=p->generation;
+        memset(p,0,sizeof(*p));
+        p->generation=g==UINT64_MAX?UINT64_MAX:g+1;
+    }
+}
+static int bounds(int x,int y,int w,int h) {
+    return x>=0&&y>=0&&w>0&&h>0&&x<=1024-w&&y<=512-h;
+}
+static int overlap(unsigned x,unsigned y,unsigned w,unsigned h,const struct Upload*u) {
+    return x<u->x+u->w&&u->x<x+w&&y<u->y+u->h&&u->y<y+h;
+}
+void Pe2HdUploadDirty(Pe2HdUpload*p,int x,int y,int w,int h) {
+    if(!p||w<=0||h<=0)return;
+    /* Invalid/wrapped writes cannot establish a partial guessed provenance. */
+    if(!bounds(x,y,w,h)) {
+        Pe2HdUploadReset(p);
+        return;
+    }
+    if(p->generation==UINT64_MAX) {
+        memset(p->known,0,sizeof p->known);
+        memset(p->uploads,0,sizeof p->uploads);
+        return;
+    }
+    int affected = 0;
+    for (unsigned i = 0; i < UPLOAD_CAPACITY; ++i)
+        if (p->uploads[i].active && overlap(x, y, w, h, &p->uploads[i])) affected = 1;
+    for (unsigned i = 0; i < p->owner_count; ++i) {
+        unsigned page = p->owners[2*i], clut = p->owners[2*i+1];
+        struct Upload source = {(page & 15)*64, ((page >> 4)&1)*256,
+            ((page >> 7)&3) ? 128 : 64, 256, 0, 1};
+        struct Upload palette = {(clut & 63)*16, clut >> 6,
+            ((page >> 7)&3) ? 256 : 16, 1, 0, 1};
+        if (overlap(x,y,w,h,&source) || overlap(x,y,w,h,&palette)) affected = 1;
+    }
+    if (affected) ++p->generation;
+    for(int j=0;j<h;j++)memset(p->known+(size_t)(y+j)*1024+x,0,(size_t)w);
+    for(unsigned i=0;i<UPLOAD_CAPACITY;i++)if(p->uploads[i].active&&overlap(x,y,w,h,&p->uploads[i]))p->uploads[i].active=0;
+}
+static uint64_t hash_words(const uint16_t*words,unsigned stride,unsigned w,unsigned h) {
+    XXH3_state_t state;
+    XXH3_64bits_reset(&state);
+    unsigned char row[2048];
+    for(unsigned y=0;y<h;y++) {
+        for(unsigned x=0;x<w;x++) {
+            unsigned v=words[(size_t)y*stride+x];
+            row[x*2]=v;
+            row[x*2+1]=v>>8;
+        }
+        XXH3_64bits_update(&state,row,2*w);
+    }
+    return XXH3_64bits_digest(&state);
+}
+int Pe2HdUploadAccept(Pe2HdUpload*p,int x,int y,int w,int h,const uint16_t*words) {
+    if(!p||!words||!bounds(x,y,w,h)||p->generation==UINT64_MAX)return 0;
+    uint64_t previous_generation = p->generation;
+    Pe2HdUploadDirty(p,x,y,w,h);
+    if (p->generation == previous_generation && p->generation < UINT64_MAX) ++p->generation;
+    for(int j=0;j<h;j++) {
+        size_t at=(size_t)(y+j)*1024+x;
+        memcpy(p->words+at,words+(size_t)j*w,(size_t)w*2);
+        memset(p->known+at,1,(size_t)w);
+    }
+    struct Upload*u=&p->uploads[p->next];
+    *u=(struct Upload) {
+        x,y,w,h,hash_words(words,w,w,h),1
+    };
+    p->next=(p->next+1)%UPLOAD_CAPACITY;
+    return 1;
+}
+void Pe2HdUploadClearOwners(Pe2HdUpload*p) {
+    if(p) {
+        p->owner_count=0;
+        if(p->generation<UINT64_MAX)++p->generation;
+    }
+}
+int Pe2HdUploadRegisterOwner(Pe2HdUpload*p,unsigned page,unsigned clut) {
+    if(!p||page>511||clut>32767||((page>>7)&3)>1)return 0;
+    unsigned mode=(page>>7)&3;
+    if((clut&63)*16+(mode?256:16)>1024)return 0;
+    for(unsigned i=0;i<p->owner_count;i++)if(p->owners[2*i]==page&&p->owners[2*i+1]==clut)return 1;
+    if(p->owner_count==64)return 0;
+    p->owners[2*p->owner_count]=page;
+    p->owners[2*p->owner_count+1]=clut;
+    ++p->owner_count;
+    if (p->generation < UINT64_MAX) ++p->generation;
+    return 1;
+}
+/* Parse fixed-width hex and bounded decimal tokens independently. */
+static int number(const char**cursor,unsigned*out,char delimiter) {
+    const char*p=*cursor;
+    unsigned v=0,n=0;
+    while(*p>='0'&&*p<='9') {
+        if(++n>4)return 0;
+        v=v*10+(unsigned)(*p++-'0');
+    }
+    if(!n||*p++!=delimiter)return 0;
+    *out=v;
+    *cursor=p;
+    return 1;
+}
+static int hash_token(const char**cursor,uint64_t*out) {
+    const char*p=*cursor;
+    if(strlen(p)<17)return 0;
+    uint64_t v=0;
+    for(unsigned i=0;i<16;i++) {
+        unsigned c=(unsigned char)*p++,d;
+        if(c>='0'&&c<='9')d=c-'0';
+        else if(c>='a'&&c<='f')d=c-'a'+10;
+        else if(c>='A'&&c<='F')d=c-'A'+10;
+        else return 0;
+        v=(v<<4)|d;
+    }
+    if(*p++!='-')return 0;
+    *out=v;
+    *cursor=p;
+    return 1;
+}
+int Pe2HdUploadParse(const char*name,Pe2HdUploadIdentity*out) {
+    if(!name||!out)return 0;
+    size_t len=SDL_strnlen(name,256);
+    if(len>=256||len<20)return 0;
+    for(size_t i=0;i<len;i++) {
+        unsigned c=(unsigned char)name[i];
+        if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='-'||c=='_'||c=='.'))return 0;
+    }
+    if(strstr(name,".."))return 0;
+    Pe2HdUploadIdentity id= {
+        0
+    };
+    const char*p=name;
+    if(strncmp(p,"texupload-P",11))return 0;
+    p+=11;
+    if(*p=='4')id.mode=0;
+    else if(*p=='8')id.mode=1;
+    else return 0;
+    if(p[1]!='-')return 0;
+    p+=2;
+    unsigned low;
+    if(!hash_token(&p,&id.texture)||!hash_token(&p,&id.palette)||!number(&p,&id.sw,'x')||!number(&p,&id.sh,'-')||!number(&p,&id.x,'-')||!number(&p,&id.y,'-')||!number(&p,&id.w,'x')||!number(&p,&id.h,'-')||*p++!='P'||!number(&p,&low,'-')||!number(&p,&id.hi,'.')||strcmp(p,"png"))return 0;
+    unsigned factor=id.mode?2:4;
+    if(low||id.hi>=(id.mode?256:16)||!id.sw||id.sw>1024||!id.sh||id.sh>512||!id.w||!id.h||id.x+id.w>id.sw*factor||id.y+id.h>id.sh)return 0;
+    memcpy(id.name,name,len+1);
+    *out=id;
+    return 1;
+}
+static int Pe2HdUploadResolveOwned(const Pe2HdUpload*p,const Pe2HdUploadIdentity*id,unsigned page,unsigned clut,const unsigned char*uv,unsigned vertices,Pe2HdUploadMatch*out,int model_owned) {
+    if(!p||!id||!uv||!out||(vertices!=3&&vertices!=4)||p->generation==UINT64_MAX)return 0;
+    /* Revalidate all caller-provided metadata against the strict original name. */
+    Pe2HdUploadIdentity checked;
+    if(!Pe2HdUploadParse(id->name,&checked)||(checked.mode!=id->mode||checked.sw!=id->sw||checked.sh!=id->sh||checked.x!=id->x||checked.y!=id->y||checked.w!=id->w||checked.h!=id->h||checked.hi!=id->hi||checked.texture!=id->texture||checked.palette!=id->palette))return 0;
+    int owned=0;
+    for(unsigned i=0;i<p->owner_count;i++)if(p->owners[2*i]==page&&p->owners[2*i+1]==clut) {
+        owned=1;
+        break;
+    }
+    if((!owned&&!model_owned)||((page>>7)&3)!=id->mode)return 0;
+    unsigned factor=id->mode?2:4,px=(page&15)*64,py=((page>>4)&1)*256,cx=(clut&63)*16,cy=clut>>6;
+    if(cx+id->hi+1>1024||cy>=512)return 0;
+    for(unsigned i=0;i<=id->hi;i++)if(!p->known[cy*1024+cx+i])return 0;
+    if(hash_words(p->words+cy*1024+cx,1024,id->hi+1,1)!=id->palette)return 0;
+    int found=0;
+    Pe2HdUploadMatch result= {
+        0
+    };
+    for(unsigned k=0;k<UPLOAD_CAPACITY;k++) {
+        const struct Upload*u=&p->uploads[k];
+        if(!u->active||u->w!=id->sw||u->h!=id->sh||u->hash!=id->texture)continue;
+        int x=(int)u->x*(int)factor+(int)id->x-(int)px*(int)factor,y=(int)u->y+(int)id->y-(int)py;
+        if(x<0||y<0||x+(int)id->w>256||y+(int)id->h>256)continue;
+        int contained=1;
+        for(unsigned j=0;j<vertices;j++)if(uv[2*j]<x||uv[2*j]>=x+(int)id->w||uv[2*j+1]<y||uv[2*j+1]>=y+(int)id->h) {
+            contained=0;
+            break;
+        }
+        if(!contained)continue;
+        for(unsigned j=0;j<id->h&&contained;j++)for(unsigned i=0;i<id->w;i++) {
+            unsigned vx=u->x+(id->x+i)/factor,vy=u->y+id->y+j;
+            size_t at=vy*1024+vx;
+            unsigned value=(p->words[at]>>(((id->x+i)%factor)*(id->mode?8:4)))&(id->mode?255:15);
+            if(!p->known[at]||value>id->hi) {
+                contained=0;
+                break;
+            }
+        }
+        if(!contained)continue;
+        if(found)return 0;
+        found=1;
+        result=(Pe2HdUploadMatch) {
+            x,y,id->w,id->h,p->generation,XXH3_64bits(id->name,strlen(id->name))
+        };
+    }
+    if(!found)return 0;
+    *out=result;
+    return 1;
+}
+int Pe2HdUploadResolve(const Pe2HdUpload*p,const Pe2HdUploadIdentity*id,unsigned page,unsigned clut,const unsigned char*uv,unsigned vertices,Pe2HdUploadMatch*out){return Pe2HdUploadResolveOwned(p,id,page,clut,uv,vertices,out,0);}
+int Pe2HdUploadMatchCurrent(const Pe2HdUpload*p,const Pe2HdUploadMatch*m) {
+    return p&&m&&p->generation!=UINT64_MAX&&m->generation==p->generation;
+}
+static void SDLCALL DuckFreePngPixels(void *userdata,void *pixels) {
+    (void)userdata;
+    SDL_free(pixels);
+}
+static SDL_Surface *DuckLoadPngForward(const char *path,unsigned sourceW,unsigned sourceH) {
+    /* Exact admitted index dimensions, not arbitrary file dimensions, own
+     * the scale contract before any inflate/output allocation occurs. */
+    const Pe2RgbaPngContract contract={sourceW,sourceH,2048,1024,8};
+    Pe2RgbaPngPixels pixels={0};
+    if(!Pe2RgbaPngLoad(path,&contract,&pixels)) {
+        SDL_Log("[HD models] png-rejected stage=bounded-rgba-decode");
+        return NULL;
+    }
+    SDL_Surface *surface=SDL_CreateSurfaceFrom((int)pixels.width,(int)pixels.height,
+        SDL_PIXELFORMAT_RGBA32,pixels.rgba,(int)pixels.pitch);
+    if(!surface) { Pe2RgbaPngFree(&pixels);return NULL; }
+    /* CreateSurfaceFrom borrows the sole fixed-output allocation. The surface
+     * property owns it until destruction; SDL also invokes cleanup if setting
+     * the property fails, so failure below must not free it a second time. */
+    if(!SDL_SetPointerPropertyWithCleanup(SDL_GetSurfaceProperties(surface),
+        "pe2.safe_png.rgba",pixels.rgba,DuckFreePngPixels,NULL)) {
+        SDL_DestroySurface(surface);
+        return NULL;
+    }
+    return surface;
+}
+SDL_Surface *Pe2HdUploadLoad(const Pe2HdUpload*p,const char*root,const Pe2HdUploadIdentity*id,const Pe2HdUploadMatch*m) {
+    if(!Pe2HdUploadMatchCurrent(p,m)||!root||!root[0]||!id)return NULL;
+    Pe2HdUploadIdentity checked;
+    if(!Pe2HdUploadParse(id->name,&checked)||checked.w!=m->w||checked.h!=m->h||XXH3_64bits(checked.name,strlen(checked.name))!=m->identity_key)return NULL;
+    char path[1400];
+    if(SDL_snprintf(path,sizeof path,"%s/%s",root,checked.name)>=(int)sizeof path)return NULL;
+    return DuckLoadPngForward(path,checked.w,checked.h);
+}
+/* Transactional external filename-index admission, maximum45,000 records. */
+struct Pe2HdUploadIndex {
+    Pe2HdUploadIdentity *entries;
+    unsigned count;
+};
+static int compare_upload_identity(const void *left, const void *right)
+{
+    const Pe2HdUploadIdentity *a = left, *b = right;
+    if (a->texture < b->texture) return -1;
+    if (a->texture > b->texture) return 1;
+    return strcmp(a->name, b->name);
+}
+Pe2HdUploadIndex *Pe2HdUploadIndexOpen(const char *path) {
+    if (!path) return NULL;
+    SDL_IOStream *stream = SDL_IOFromFile(path, "rb");
+    if (!stream) return NULL;
+    Pe2HdUploadIndex *index = SDL_calloc(1, sizeof(*index));
+    if (!index) {
+        SDL_CloseIO(stream);
+        return NULL;
+    }
+    unsigned capacity = 0, length = 0;
+    char name[256];
+    unsigned char bytes[4096];
+    int valid = 1;
+    for (;;) {
+        size_t count = SDL_ReadIO(stream, bytes, sizeof(bytes));
+        if (!count) {
+            valid = SDL_GetIOStatus(stream) == SDL_IO_STATUS_EOF && length == 0;
+            break;
+        }
+        for (size_t i = 0; i < count; ++i) {
+            unsigned char c = bytes[i];
+            if (c == '\n') {
+                if (length && name[length - 1] == '\r') --length;
+                name[length] = 0;
+                Pe2HdUploadIdentity identity;
+                if (index->count == 45000 || !Pe2HdUploadParse(name, &identity)) {
+                    valid = 0;
+                    break;
+                }
+                if (index->count == capacity) {
+                    unsigned next = capacity ? capacity * 2 : 256;
+                    if (next > 45000) next = 45000;
+                    void *grown = SDL_realloc(index->entries, (size_t)next * sizeof(*index->entries));
+                    if (!grown) {
+                        valid = 0;
+                        break;
+                    }
+                    index->entries = grown;
+                    capacity = next;
+                }
+                index->entries[index->count++] = identity;
+                length = 0;
+            }
+            else {
+                if (!c || length == 255) {
+                    valid = 0;
+                    break;
+                }
+                name[length++] = c;
+            }
+        }
+        if (!valid) break;
+    }
+    if (!SDL_CloseIO(stream)) valid = 0;
+    if (!valid || !index->count) {
+        Pe2HdUploadIndexClose(index);
+        return NULL;
+    }
+    qsort(index->entries, index->count, sizeof(*index->entries), compare_upload_identity);
+    return index;
+}
+void Pe2HdUploadIndexClose(Pe2HdUploadIndex *index) {
+    if (index) {
+        SDL_free(index->entries);
+        SDL_free(index);
+    }
+}
+static int Pe2HdUploadFindOwned(const Pe2HdUpload *state, const Pe2HdUploadIndex *index,
+                    unsigned page, unsigned clut, const unsigned char *uv,
+                    unsigned vertices, Pe2HdUploadIdentity *identity,
+                    Pe2HdUploadMatch *match,int model_owned)
+{
+    if (!state || !index || !identity || !match || !uv || (vertices != 3 && vertices != 4)) return 0;
+    int owned = 0;
+    for (unsigned i = 0; i < state->owner_count; ++i)
+        if (state->owners[2*i] == page && state->owners[2*i+1] == clut) { owned = 1; break; }
+    if (!owned && !model_owned) return 0;
+    unsigned selected = UINT_MAX, best_area = UINT_MAX, examined = 0;
+    int ambiguous = 0;
+    Pe2HdUploadMatch best = {0};
+    /* Index is hash-sorted at admission: no full-pack scan per polygon.
+     * Repeated intact uploads of one identity share a bounded candidate range;
+     * Resolve still verifies the actual polygon's absolute source coverage. */
+    for (unsigned upload_slot = 0; upload_slot < UPLOAD_CAPACITY; ++upload_slot) {
+        const struct Upload *upload = &state->uploads[upload_slot];
+        if (!upload->active) continue;
+        int already_seen = 0;
+        for (unsigned previous = 0; previous < upload_slot; ++previous) {
+            const struct Upload *other = &state->uploads[previous];
+            if (other->active && other->hash == upload->hash && other->w == upload->w && other->h == upload->h) { already_seen = 1; break; }
+        }
+        if (already_seen) continue;
+        unsigned low = 0, high = index->count;
+        while (low < high) {
+            unsigned middle = low + (high - low) / 2;
+            if (index->entries[middle].texture < upload->hash) low = middle + 1;
+            else high = middle;
+        }
+        for (unsigned i = low; i < index->count && index->entries[i].texture == upload->hash; ++i) {
+            const Pe2HdUploadIdentity *entry = &index->entries[i];
+            if (entry->mode != ((page >> 7) & 3) || entry->sw != upload->w || entry->sh != upload->h) continue;
+            if (++examined > 1024) return 0;
+            Pe2HdUploadMatch candidate;
+            if (!Pe2HdUploadResolveOwned(state, entry, page, clut, uv, vertices, &candidate,model_owned)) continue;
+            unsigned area = entry->w * entry->h;
+            if (area < best_area) { selected = i; best_area = area; best = candidate; ambiguous = 0; }
+            else if (area == best_area && selected != i) ambiguous = 1;
+        }
+    }
+    if (selected == UINT_MAX || ambiguous) return 0;
+    *identity = index->entries[selected];
+    *match = best;
+    return 1;
+}
+
+int Pe2HdUploadFind(const Pe2HdUpload *state,const Pe2HdUploadIndex *index,unsigned page,unsigned clut,const unsigned char *uv,unsigned vertices,Pe2HdUploadIdentity *identity,Pe2HdUploadMatch *match){return Pe2HdUploadFindOwned(state,index,page,clut,uv,vertices,identity,match,0);}
+int Pe2HdUploadFindPacket(const Pe2HdUpload *state,const Pe2HdUploadIndex *index,const void *packet,unsigned code,unsigned page,unsigned clut,const unsigned char *uv,unsigned vertices,Pe2HdUploadIdentity *identity,Pe2HdUploadMatch *match){
+    if(!Psyz_HdModelPacketCurrent(packet,code,page,clut,uv,vertices))return 0;
+    return Pe2HdUploadFindOwned(state,index,page,clut,uv,vertices,identity,match,1);
+}
+uint64_t Pe2HdUploadGeneration(const Pe2HdUpload *state) { return state ? state->generation : 0; }
diff --git a/psyz/src/platform/pe2_hud_font.h b/psyz/src/platform/pe2_hud_font.h
new file mode 100644
index 0000000000000000000000000000000000000000..b389a020c412abdb2b99301f842ee6c0b693c146
--- /dev/null
+++ b/psyz/src/platform/pe2_hud_font.h
@@ -0,0 +1,143 @@
+/* MPL-2.0. Scoped HP/MP Plex placement in source-owned medium-font cells.
+ * IBM Plex/stb resources and their original notices remain in the host source. */
+#ifndef PE2_HUD_FONT_H
+#define PE2_HUD_FONT_H
+/* Each style owns a separate atlas; metric placement is unchanged. */
+enum { PLEX_HUD_GLYPHS = 11, PLEX_HUD_COLUMNS = 12, PLEX_HUD_ROWS = 2 };
+static const char plex_hud_characters[] = "/0123456789";
+static PsyzHudFontMetric plex_hud_metrics[4][PLEX_HUD_GLYPHS];
+
+static int PlexHudCell(unsigned character)
+{
+    if (character == '/') return 0;
+    return character >= '0' && character <= '9' ? (int)(character - '0' + 1) : -1;
+}
+
+static int PlexHudMetricsEqual(const PsyzHudFontMetric* metrics)
+{
+    for (unsigned i = 0; i < PLEX_HUD_GLYPHS; ++i) {
+        const PsyzHudFontMetric *a = &metrics[i], *b = &plex_hud_metrics[plex_font_styles[PSYZ_FONT_MENU]][i];
+        if (a->character != b->character || a->width != b->width || a->height != b->height ||
+            a->xOffset != b->xOffset || a->yOffset != b->yOffset || a->advance != b->advance) return 0;
+    }
+    return 1;
+}
+
+/* One scale and baseline for all digits/separators. The original cell is a
+ * crop, not the ink bounds: its transparent border may overlap the next cell.
+ * Reserve one pixel of pen advance and half a pixel inside each source crop. */
+static float PlexHudScale(const stbtt_fontinfo* font, const PsyzHudFontMetric* metrics)
+{
+    float scale = 1.0f;
+    for (unsigned i = 0; i < PLEX_HUD_GLYPHS; ++i) {
+        const PsyzHudFontMetric* m = &metrics[i];
+        int advance, bearing, x0, y0, x1, y1;
+        if (m->character != (unsigned char)plex_hud_characters[i] ||
+            m->width < 2 || m->width > 32 || m->height < 2 || m->height > 32 ||
+            m->advance < 2 || m->advance > 32 || m->xOffset < -16 || m->xOffset > 16 ||
+            m->yOffset < -16 || m->yOffset > 16 || !stbtt_FindGlyphIndex(font,m->character)) return 0;
+        stbtt_GetCodepointHMetrics(font,m->character,&advance,&bearing);
+        if (advance <= 0 || !stbtt_GetCodepointBox(font,m->character,&x0,&y0,&x1,&y1)) return 0;
+        float maximum = (m->advance - 1.0f) / (float)advance;
+        float top = (float)m->yOffset - (m->height - 1);
+        float bottom = (float)m->yOffset + 1.0f;
+        if (y1 > 0) maximum = SDL_min(maximum,(-top - 0.5f) / (float)y1);
+        if (y0 < 0) maximum = SDL_min(maximum,(bottom - 0.5f) / (float)-y0);
+        float leftDistance = advance * 0.5f - x0;
+        float rightDistance = x1 - advance * 0.5f;
+        if (leftDistance > 0)
+            maximum = SDL_min(maximum,(m->advance * 0.5f - m->xOffset - 0.5f) / leftDistance);
+        if (rightDistance > 0)
+            maximum = SDL_min(maximum,(m->xOffset + m->width - 0.5f - m->advance * 0.5f) / rightDistance);
+        if (!(maximum > 0)) return 0;
+        scale = SDL_min(scale,maximum);
+    }
+    return scale;
+}
+
+static int PlexHudRaster(SDL_Surface* surface, const stbtt_fontinfo* font,
+                         const PsyzHudFontMetric* metric, unsigned index, float scale)
+{
+    int advance, bearing, x0, y0, x1, y1;
+    stbtt_GetCodepointHMetrics(font,metric->character,&advance,&bearing);
+    float scaleX = scale * 64.0f / metric->width;
+    float scaleY = scale * 64.0f / metric->height;
+    float nativePenX = (metric->advance - advance * scale) * 0.5f;
+    float penX = (nativePenX - metric->xOffset) * 64.0f / metric->width;
+    float baseline = (metric->height - 1.0f - metric->yOffset) * 64.0f / metric->height;
+    if (!(penX >= 0 && penX < 64 && baseline >= 0 && baseline < 64)) return 0;
+    int penInteger = (int)penX, baselineInteger = (int)baseline;
+    float shiftX = penX - penInteger, shiftY = baseline - baselineInteger;
+    stbtt_GetCodepointBitmapBoxSubpixel(font,metric->character,scaleX,scaleY,shiftX,shiftY,&x0,&y0,&x1,&y1);
+    int width = x1-x0, height = y1-y0;
+    if (width <= 0 || height <= 0 || width > 64 || height > 64) return 0;
+    unsigned char bitmap[64*64] = {0}, coverage[64*64] = {0};
+    stbtt_MakeCodepointBitmapSubpixel(font,bitmap,width,height,64,scaleX,scaleY,shiftX,shiftY,metric->character);
+    for (int y = 0; y < height; ++y) for (int x = 0; x < width; ++x) {
+        int dx = penInteger+x0+x, dy = baselineInteger+y0+y;
+        if (dx >= 0 && dx < 64 && dy >= 0 && dy < 64) coverage[dy*64+dx] = bitmap[y*64+x];
+    }
+    int radiusX = (int)(24.0f/metric->width)+1;
+    int radiusY = (int)(24.0f/metric->height)+1;
+    for (unsigned outline = 0; outline < 2; ++outline) {
+        unsigned cell = index + outline*PLEX_HUD_GLYPHS;
+        unsigned ox = (cell%PLEX_HUD_COLUMNS)*68+2, oy = (cell/PLEX_HUD_COLUMNS)*68+2;
+        for (int y = 0; y < 64; ++y) for (int x = 0; x < 64; ++x) {
+            unsigned alpha = coverage[y*64+x];
+            if (outline) for (int dy = -radiusY; dy <= radiusY; ++dy)
+                for (int dx = -radiusX; dx <= radiusX; ++dx) {
+                    float nativeX = dx*metric->width/64.0f, nativeY = dy*metric->height/64.0f;
+                    int xx = x+dx, yy = y+dy;
+                    if (nativeX*nativeX+nativeY*nativeY <= 0.375f*0.375f &&
+                        xx >= 0 && xx < 64 && yy >= 0 && yy < 64)
+                        alpha = SDL_max(alpha,coverage[yy*64+xx]);
+                }
+            unsigned char* pixel = (unsigned char*)surface->pixels+(oy+y)*surface->pitch+(ox+x)*4;
+            pixel[0]=pixel[1]=pixel[2]=255;
+            pixel[3]=(unsigned char)alpha;
+        }
+    }
+    return 1;
+}
+
+int Psyz_GpuPreparePlexHud(const PsyzHudFontMetric* metrics, unsigned count, unsigned payloadBudget)
+{
+    if (!metrics || count != PLEX_HUD_GLYPHS || !payloadBudget || payloadBudget > 128 ||
+        !PlexBackendSupported() || !plex_font_styles[PSYZ_FONT_MENU] || !device || UseSoftwareBackend() ||
+        !PlexCapacity(plex_cap_reserved + payloadBudget)) return 0;
+    uint64_t key=PlexProfileKey(plex_font_styles[PSYZ_FONT_MENU],1);
+    const unsigned char *data=PlexProfileData(plex_font_styles[PSYZ_FONT_MENU]);
+    if (!data) return 0;
+    for (unsigned i = 0; i < sprite_atlas_count; ++i)
+        if (sprite_atlases[i].key == key) return PlexHudMetricsEqual(metrics);
+    stbtt_fontinfo font;
+    int offset = stbtt_GetFontOffsetForIndex(data,0);
+    if (offset < 0 || !stbtt_InitFont(&font,data,offset)) return 0;
+    float scale = PlexHudScale(&font,metrics);
+    if (!(scale > 0)) return 0;
+    SDL_Surface* surface = SDL_CreateSurface(PLEX_HUD_COLUMNS*68,PLEX_HUD_ROWS*68*2,SDL_PIXELFORMAT_RGBA32);
+    if (!surface) return 0;
+    SDL_memset(surface->pixels,0,(size_t)surface->pitch*surface->h);
+    for (unsigned i = 0; i < count; ++i) if (!PlexHudRaster(surface,&font,&metrics[i],i,scale)) {
+        SDL_DestroySurface(surface);
+        return 0;
+    }
+    if (LoadSpriteAtlasSurface(key,surface) != 1) return 0;
+    for (unsigned i = 0; i < count; ++i) plex_hud_metrics[plex_font_styles[PSYZ_FONT_MENU]][i] = metrics[i];
+    return PlexCapacity(plex_cap_reserved + payloadBudget);
+}
+
+void Psyz_GpuMarkPlexHud(const void* payload, unsigned character, int outline)
+{
+    PlexMark* mark = PlexLookup(payload,1);
+    if (!mark) return;
+    mark->packet=(const void*)1;
+    int cell=PlexHudCell(character);
+    if (!PlexBackendSupported() || !plex_font_styles[PSYZ_FONT_MENU] || cell < 0) return;
+    mark->packet=payload;
+    mark->cell=(unsigned)cell+(outline ? PLEX_HUD_GLYPHS : 0);
+    mark->kind=PLEX_KIND_HUD;
+    memcpy(mark->sprite_words,payload,sizeof mark->sprite_words);
+    mark->atlas_key=PlexProfileKey(plex_font_styles[PSYZ_FONT_MENU],1);
+}
+#endif
diff --git a/psyz/src/platform/pe2_menu_softness.h b/psyz/src/platform/pe2_menu_softness.h
new file mode 100644
index 0000000000000000000000000000000000000000..a65fdeeae81cd107f146d5c3ff69a0f7fbd6e777
--- /dev/null
+++ b/psyz/src/platform/pe2_menu_softness.h
@@ -0,0 +1,31 @@
+/* MPL-2.0. Presentation-only menu glyph underglow; no source metrics change. */
+#ifndef PE2_MENU_SOFTNESS_H
+#define PE2_MENU_SOFTNESS_H
+/* Existing fill and outline cells remain separate. Composite a low-opacity
+ * neutral off-white halo UNDER fill coverage, inside its authored glyph slot.
+ * Bounded binomial convolution never samples another cell or retail pixels. */
+static void Pe2MenuSoftenFill(SDL_Surface *surface)
+{
+    static const unsigned weight[9]={1,8,28,56,70,56,28,8,1};
+    for(unsigned cell=0;cell<95;++cell){
+        unsigned ox=(cell%16)*68+2,oy=(cell/16)*68+2;
+        unsigned char alpha[64*64];
+        for(unsigned y=0;y<64;++y)for(unsigned x=0;x<64;++x)
+            alpha[y*64+x]=*((unsigned char*)surface->pixels+(oy+y)*surface->pitch+(ox+x)*4+3);
+        for(int y=0;y<64;++y)for(int x=0;x<64;++x){
+            unsigned sum=0;
+            for(int j=-4;j<=4;++j)for(int i=-4;i<=4;++i)
+                if(x+i>=0&&x+i<64&&y+j>=0&&y+j<64)
+                    sum+=weight[i+4]*weight[j+4]*alpha[(y+j)*64+x+i];
+            unsigned a=alpha[y*64+x];
+            /* 28% peak halo; fill occludes halo rather than being blurred. */
+            unsigned halo=(sum*72u+8355840u)/16711680u;
+            halo=halo*(255u-a)/255u;
+            unsigned combined=a+halo;
+            unsigned char *pixel=(unsigned char*)surface->pixels+(oy+y)*surface->pitch+(ox+x)*4;
+            pixel[0]=pixel[1]=pixel[2]=(unsigned char)(combined?(a*255u+halo*196u)/combined:255u);
+            pixel[3]=(unsigned char)combined;
+        }
+    }
+}
+#endif
diff --git a/psyz/src/platform/pe2_movie_blur.h b/psyz/src/platform/pe2_movie_blur.h
new file mode 100644
index 0000000000000000000000000000000000000000..848be52f81cd68b76f8908f7383cbccaefedd89c
--- /dev/null
+++ b/psyz/src/platform/pe2_movie_blur.h
@@ -0,0 +1,199 @@
+/* SPDX-License-Identifier: MIT
+ * Adapted from the PE1 public native movie_blur.h graph. PE2 owns the movie
+ * lifecycle through completed display-movie frames and decoder stop paths. */
+#ifndef PE2_NATIVE_MOVIE_BLUR_H
+#define PE2_NATIVE_MOVIE_BLUR_H
+#include "movie_blur_shaders.h"
+
+static SDL_AtomicInt pe2_movie_active, pe2_movie_source_serial;
+static SDL_AtomicInt pe2_movie_frame_width,pe2_movie_frame_height;
+void Psyz_VideoSetMovieFrameSize(unsigned width,unsigned height)
+{
+    int valid=width>0&&width<=1024&&height>0&&height<=512;
+    SDL_SetAtomicInt(&pe2_movie_frame_width,valid?(int)width:0);
+    SDL_SetAtomicInt(&pe2_movie_frame_height,valid?(int)height:0);
+}
+static int pe2_movie_blur_requested = 1;
+static int pe2_movie_blur_failed, pe2_movie_blur_source;
+static unsigned pe2_movie_blur_logs;
+static SDL_GPUTexture *pe2_movie_blur_input, *pe2_movie_blur_temp, *pe2_movie_blur_output;
+static SDL_GPUGraphicsPipeline *pe2_movie_blur_pipeline;
+static SDL_GPUSampler *pe2_movie_blur_sampler;
+static Uint32 pe2_movie_blur_w, pe2_movie_blur_h;
+
+void Psyz_VideoSetMovieActive(int active)
+{
+    active = active != 0;
+    if (active && !SDL_GetAtomicInt(&pe2_movie_active))
+        SDL_AddAtomicInt(&pe2_movie_source_serial, 1);
+    SDL_SetAtomicInt(&pe2_movie_active, active);
+    if(!active)Psyz_VideoSetMovieFrameSize(0,0);
+}
+
+void Psyz_VideoSetMovieBlur(int enabled)
+{
+    if (pe2_movie_blur_requested != (enabled != 0)) {
+        pe2_movie_blur_requested = enabled != 0;
+        pe2_movie_blur_failed = 0;
+    }
+}
+
+static void Pe2MovieBlurDestroy(void)
+{
+    if (pe2_movie_blur_input) SDL_ReleaseGPUTexture(device, pe2_movie_blur_input);
+    if (pe2_movie_blur_temp) SDL_ReleaseGPUTexture(device, pe2_movie_blur_temp);
+    if (pe2_movie_blur_output) SDL_ReleaseGPUTexture(device, pe2_movie_blur_output);
+    if (pe2_movie_blur_pipeline) SDL_ReleaseGPUGraphicsPipeline(device, pe2_movie_blur_pipeline);
+    if (pe2_movie_blur_sampler) SDL_ReleaseGPUSampler(device, pe2_movie_blur_sampler);
+    pe2_movie_blur_input = pe2_movie_blur_temp = pe2_movie_blur_output = NULL;
+    pe2_movie_blur_pipeline = NULL;
+    pe2_movie_blur_sampler = NULL;
+    pe2_movie_blur_w = pe2_movie_blur_h = 0;
+    pe2_movie_blur_failed = 0;
+    SDL_SetAtomicInt(&pe2_movie_active, 0);
+}
+
+static bool Pe2MovieBlurPrepare(Uint32 w, Uint32 h)
+{
+    if (!w || !h || w > 256 || h > 256) return false;
+    if (!pe2_movie_blur_pipeline) {
+        SDL_GPUShaderCreateInfo shader = {0};
+        shader.code = cpe_fullscreen_vert;
+        shader.code_size = sizeof(cpe_fullscreen_vert);
+        shader.entrypoint = "main";
+        shader.format = SDL_GPU_SHADERFORMAT_SPIRV;
+        shader.stage = SDL_GPU_SHADERSTAGE_VERTEX;
+        SDL_GPUShader *vs = SDL_CreateGPUShader(device, &shader);
+        shader.code = cpe_movie_blur_frag;
+        shader.code_size = sizeof(cpe_movie_blur_frag);
+        shader.stage = SDL_GPU_SHADERSTAGE_FRAGMENT;
+        shader.num_samplers = 1;
+        shader.num_uniform_buffers = 1;
+        SDL_GPUShader *fs = SDL_CreateGPUShader(device, &shader);
+        if (vs && fs) {
+            SDL_GPUColorTargetDescription color = {0};
+            color.format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+            SDL_GPUGraphicsPipelineCreateInfo pipeline = {0};
+            pipeline.vertex_shader = vs;
+            pipeline.fragment_shader = fs;
+            pipeline.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
+            pipeline.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL;
+            pipeline.multisample_state.sample_count = SDL_GPU_SAMPLECOUNT_1;
+            pipeline.target_info.color_target_descriptions = &color;
+            pipeline.target_info.num_color_targets = 1;
+            pe2_movie_blur_pipeline = SDL_CreateGPUGraphicsPipeline(device, &pipeline);
+        }
+        if (vs) SDL_ReleaseGPUShader(device, vs);
+        if (fs) SDL_ReleaseGPUShader(device, fs);
+        if (!pe2_movie_blur_pipeline) return false;
+    }
+    if (!pe2_movie_blur_sampler) {
+        SDL_GPUSamplerCreateInfo sampler = {0};
+        sampler.min_filter = sampler.mag_filter = SDL_GPU_FILTER_LINEAR;
+        sampler.address_mode_u = sampler.address_mode_v = sampler.address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+        pe2_movie_blur_sampler = SDL_CreateGPUSampler(device, &sampler);
+        if (!pe2_movie_blur_sampler) return false;
+    }
+    if (pe2_movie_blur_w == w && pe2_movie_blur_h == h &&
+        pe2_movie_blur_input && pe2_movie_blur_temp && pe2_movie_blur_output) return true;
+    SDL_GPUTextureCreateInfo texture = {0};
+    texture.type = SDL_GPU_TEXTURETYPE_2D;
+    texture.format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+    texture.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER | SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;
+    texture.width = w;
+    texture.height = h;
+    texture.layer_count_or_depth = texture.num_levels = 1;
+    texture.sample_count = SDL_GPU_SAMPLECOUNT_1;
+    SDL_GPUTexture *a = SDL_CreateGPUTexture(device, &texture);
+    SDL_GPUTexture *b = SDL_CreateGPUTexture(device, &texture);
+    SDL_GPUTexture *c = SDL_CreateGPUTexture(device, &texture);
+    if (!a || !b || !c) {
+        if (a) SDL_ReleaseGPUTexture(device, a);
+        if (b) SDL_ReleaseGPUTexture(device, b);
+        if (c) SDL_ReleaseGPUTexture(device, c);
+        return false;
+    }
+    if (pe2_movie_blur_input) SDL_ReleaseGPUTexture(device, pe2_movie_blur_input);
+    if (pe2_movie_blur_temp) SDL_ReleaseGPUTexture(device, pe2_movie_blur_temp);
+    if (pe2_movie_blur_output) SDL_ReleaseGPUTexture(device, pe2_movie_blur_output);
+    pe2_movie_blur_input = a;
+    pe2_movie_blur_temp = b;
+    pe2_movie_blur_output = c;
+    pe2_movie_blur_w = w;
+    pe2_movie_blur_h = h;
+    return true;
+}
+
+static bool Pe2MovieBlurPass(SDL_GPUCommandBuffer *cmd, SDL_GPUTexture *source,
+                            SDL_GPUTexture *target, float x, float y, float dim)
+{
+    SDL_GPUColorTargetInfo color = {0};
+    color.texture = target;
+    color.load_op = SDL_GPU_LOADOP_DONT_CARE;
+    color.store_op = SDL_GPU_STOREOP_STORE;
+    color.cycle = true;
+    SDL_GPURenderPass *pass = SDL_BeginGPURenderPass(cmd, &color, 1, NULL);
+    if (!pass) return false;
+    SDL_BindGPUGraphicsPipeline(pass, pe2_movie_blur_pipeline);
+    SDL_GPUTextureSamplerBinding binding = {source, pe2_movie_blur_sampler};
+    SDL_BindGPUFragmentSamplers(pass, 0, &binding, 1);
+    const float parameters[4] = {x, y, dim, 0};
+    SDL_PushGPUFragmentUniformData(cmd, 0, parameters, sizeof(parameters));
+    SDL_DrawGPUPrimitives(pass, 3, 1, 0, 0);
+    SDL_EndGPURenderPass(pass);
+    return true;
+}
+
+static bool Pe2MovieBlurPresent(SDL_GPUCommandBuffer *cmd, SDL_GPUBlitRegion source,
+                               SDL_GPUTexture *swapchain, WndSize win, SDL_Rect center)
+{
+    if (!SDL_GetAtomicInt(&pe2_movie_active) || !pe2_movie_blur_requested ||
+        !cmd || !device || !source.texture || !swapchain || !source.w || !source.h ||
+        win.w <= 0 || win.h <= 0 || center.w <= 0 || center.h <= 0 ||
+        (center.x == 0 && center.y == 0 && center.w == win.w && center.h == win.h)) return false;
+    int serial = SDL_GetAtomicInt(&pe2_movie_source_serial);
+    if (serial != pe2_movie_blur_source) {
+        pe2_movie_blur_source = serial;
+        pe2_movie_blur_failed = 0;
+    }
+    if (pe2_movie_blur_failed) return false;
+    const float ratio = SDL_min(1.f, 256.f / (float)SDL_max(source.w, source.h));
+    const Uint32 w = SDL_max(1u, (Uint32)((float)source.w * ratio));
+    const Uint32 h = SDL_max(1u, (Uint32)((float)source.h * ratio));
+    if (!Pe2MovieBlurPrepare(w, h)) goto failed;
+    SDL_GPUBlitInfo compact = {0};
+    compact.source = source;
+    compact.destination.texture = pe2_movie_blur_input;
+    compact.destination.w = w;
+    compact.destination.h = h;
+    compact.filter = SDL_GPU_FILTER_LINEAR;
+    compact.load_op = SDL_GPU_LOADOP_DONT_CARE;
+    compact.cycle = true;
+    SDL_BlitGPUTexture(cmd, &compact);
+    if (!Pe2MovieBlurPass(cmd, pe2_movie_blur_input, pe2_movie_blur_temp, 1.f / (float)w, 0, 1) ||
+        !Pe2MovieBlurPass(cmd, pe2_movie_blur_temp, pe2_movie_blur_output, 0, 1.f / (float)h, .65f)) goto failed;
+    SDL_GPUBlitInfo background = {0};
+    background.source.texture = pe2_movie_blur_output;
+    background.source.w = w;
+    background.source.h = h;
+    if ((uint64_t)w * (Uint32)win.h > (uint64_t)h * (Uint32)win.w) {
+        background.source.w = SDL_max(1u, (Uint32)((uint64_t)h * (Uint32)win.w / (Uint32)win.h));
+        background.source.x = (w - background.source.w) / 2;
+    } else {
+        background.source.h = SDL_max(1u, (Uint32)((uint64_t)w * (Uint32)win.h / (Uint32)win.w));
+        background.source.y = (h - background.source.h) / 2;
+    }
+    background.destination.texture = swapchain;
+    background.destination.w = (Uint32)win.w;
+    background.destination.h = (Uint32)win.h;
+    background.load_op = SDL_GPU_LOADOP_CLEAR;
+    background.clear_color = (SDL_FColor){0, 0, 0, 1};
+    background.filter = SDL_GPU_FILTER_LINEAR;
+    SDL_BlitGPUTexture(cmd, &background);
+    return true; /* The untouched original center must use LOAD after this. */
+failed:
+    pe2_movie_blur_failed = 1;
+    if (pe2_movie_blur_logs++ < 16) WARNF("PE2 movie backdrop fallback: %s", SDL_GetError());
+    return false;
+}
+#endif
diff --git a/psyz/src/platform/pe2_movie_policy.c b/psyz/src/platform/pe2_movie_policy.c
new file mode 100644
index 0000000000000000000000000000000000000000..3e56816aef89bca2530925160cb27a27cefe7299
--- /dev/null
+++ b/psyz/src/platform/pe2_movie_policy.c
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: MIT
+ * PE2 policy adapter for retained PE1 Build17 MIT MovieCleanupPresent/provider.
+ * Lifecycle/crop ownership stays in the renderer; no game callbacks or guesses. */
+#include <psyz/movie_policy.h>
+#include "movie_cleanup/movie_cleanup.h"
+#include <limits.h>
+#include <string.h>
+
+static int cleanup_mode; /* Original unless the user selects a preset. */
+static int framing_mode; /* Original proportions with blurred sides. */
+static int gameplay_fill;
+static uint64_t cleanup_revision=1;
+static const char *cleanup_status="Original";
+
+void Psyz_VideoSetMovieCleanup(int mode)
+{
+    if (mode<PSYZ_MOVIE_ORIGINAL || mode>PSYZ_MOVIE_BLOCK_SMOOTHING) return;
+    if (mode!=cleanup_mode) {
+        cleanup_mode=mode;
+        if (++cleanup_revision==0) cleanup_revision=1;
+        cleanup_status=mode?"Waiting for a decoded movie":"Original";
+    }
+}
+int Psyz_VideoGetMovieCleanup(void) { return cleanup_mode; }
+const char *Psyz_VideoMovieCleanupStatus(void) { return cleanup_status; }
+void Psyz_VideoSetMovieFraming(int mode)
+{
+    if (mode==PSYZ_MOVIE_FRAME_ORIGINAL_BLURRED || mode==PSYZ_MOVIE_FRAME_FILL)
+        framing_mode=mode;
+}
+int Psyz_VideoGetMovieFraming(void) { return framing_mode; }
+void Psyz_VideoSetGameplayFill(int enabled) { gameplay_fill=!!enabled; }
+int Psyz_VideoGetGameplayFill(void) { return gameplay_fill; }
+
+void Psyz_MoviePolicyInit(PsyzMoviePolicy *s,SDL_GPUDevice *device)
+{
+    if (!s) return;
+    memset(s,0,sizeof(*s));
+    s->device=device;
+    cleanup_status=cleanup_mode?"Waiting for a decoded movie":"Original";
+}
+void Psyz_MoviePolicyDestroy(PsyzMoviePolicy *s)
+{
+    if (!s) return;
+    CpeMovieCleanup_Destroy((CpeMovieCleanup *)s->cleanup);
+    memset(s,0,sizeof(*s));
+    cleanup_status=cleanup_mode?"Waiting for a decoded movie":"Original";
+}
+void Psyz_MoviePolicySubmissionFailed(PsyzMoviePolicy *s)
+{
+    if (!s) return;
+    s->failed=1;
+    cleanup_status=cleanup_mode?"Original (movie processing unavailable)":"Original";
+}
+
+static SDL_Rect frame_destination(int movie,int width,int height,SDL_Rect original)
+{
+    if (width<=0 || height<=0) return original;
+    SDL_Rect result={0,0,width,height};
+    if (movie && framing_mode==PSYZ_MOVIE_FRAME_ORIGINAL_BLURRED) {
+        /* PS1 display proportions, independent of decoded pixel aspect. */
+        int64_t w=(int64_t)height*4/3;
+        if (w<=width) result.w=(int)w;
+        else result.h=(int)((int64_t)width*3/4);
+        result.x=(width-result.w)/2;
+        result.y=(height-result.h)/2;
+    } else if (!movie && !gameplay_fill) return original;
+    return result;
+}
+
+PsyzMoviePresentation Psyz_MoviePolicyPresent(PsyzMoviePolicy *s,
+    SDL_GPUCommandBuffer *command,SDL_GPUBlitRegion source,
+    Uint32 texture_w,Uint32 texture_h,int movie,uint32_t serial,
+    Uint32 logical_w,Uint32 logical_h,int viewport_w,int viewport_h,
+    SDL_Rect original_destination)
+{
+    PsyzMoviePresentation out={source,original_destination,texture_w,texture_h,0,0};
+    movie=!!movie;
+    out.destination=frame_destination(movie,viewport_w,viewport_h,original_destination);
+    out.blurred_sides=movie && framing_mode==PSYZ_MOVIE_FRAME_ORIGINAL_BLURRED &&
+        viewport_w>0 && viewport_h>0 && out.destination.w>0 && out.destination.h>0 &&
+        (out.destination.w<viewport_w || out.destination.h<viewport_h);
+    if (!movie) {
+        if (cleanup_mode) cleanup_status="Waiting for a decoded movie";
+        return out;
+    }
+    if (!cleanup_mode) { cleanup_status="Original"; return out; }
+    if (!s || !s->device) {
+        cleanup_status="Original (movie processing unavailable)";
+        return out;
+    }
+    if (!s->seen_movie || s->movie_serial!=serial || s->option_revision!=cleanup_revision) {
+        s->seen_movie=1;
+        s->movie_serial=serial;
+        s->option_revision=cleanup_revision;
+        s->failed=0;
+        s->logical_w=s->logical_h=0;
+        CpeMovieCleanup_ResetFailure((CpeMovieCleanup *)s->cleanup);
+    }
+    if (s->failed) {
+        cleanup_status="Original (movie processing unavailable)";
+        return out;
+    }
+    /* Subtraction checks avoid overflow; no unbounded or out-of-texture crop.
+     * Invalid metadata never invokes the GPU provider or changes source data. */
+    if (!command || !source.texture || source.mip_level || source.layer_or_depth_plane ||
+        !source.w || !source.h || !texture_w || !texture_h ||
+        source.x>texture_w || source.y>texture_h ||
+        source.w>texture_w-source.x || source.h>texture_h-source.y ||
+        !logical_w || !logical_h || logical_w>1024 || logical_h>512) {
+        cleanup_status="Original (movie source unavailable)";
+        return out;
+    }
+    /* One output extent per movie/explicit retry epoch. Malformed fluctuating
+     * metadata cannot drive repeated per-frame resource replacement. */
+    if (s->logical_w && (s->logical_w!=logical_w || s->logical_h!=logical_h)) {
+        Psyz_MoviePolicySubmissionFailed(s);
+        return out;
+    }
+    s->logical_w=logical_w;
+    s->logical_h=logical_h;
+    if (!s->cleanup) s->cleanup=CpeMovieCleanup_Create(s->device);
+    if (!s->cleanup) { Psyz_MoviePolicySubmissionFailed(s); return out; }
+    SDL_GPUBlitRegion processed=CpeMovieCleanup_Apply((CpeMovieCleanup *)s->cleanup,
+        command,source,true,logical_w,logical_h,cleanup_mode);
+    if (processed.texture==source.texture) {
+        Psyz_MoviePolicySubmissionFailed(s);
+        return out;
+    }
+    out.source=processed;
+    out.texture_w=logical_w;
+    out.texture_h=logical_h;
+    out.cleanup_recorded=1;
+    cleanup_status="Movie processing recorded";
+    return out;
+}
diff --git a/psyz/src/platform/pe2_present_fsr1.h b/psyz/src/platform/pe2_present_fsr1.h
new file mode 100644
index 0000000000000000000000000000000000000000..b7373d28e1b8a2c9409656946bba5c0e9d5f4277
--- /dev/null
+++ b/psyz/src/platform/pe2_present_fsr1.h
@@ -0,0 +1,99 @@
+/* PE2 native presentation adapter derived from accepted PE1 Build17
+ * present_fsr1.h. Include once after renderer's SDL_GPUDevice *device.
+ * Renderer thread only; call outside active render/copy passes. */
+#include <stdint.h>
+#include <psyz/fsr1.h>
+#include "fsr1/cpe_fsr1.h"
+static CpeFsr1 *pe2_fsr1_state;
+static SDL_GPUTexture *pe2_fsr1_input;
+static Uint32 pe2_fsr1_iw, pe2_fsr1_ih;
+static int pe2_fsr1_requested, pe2_fsr1_sharpness = 1;
+static int pe2_fsr1_failed, pe2_fsr1_effective;
+static const char *pe2_fsr1_reason = "off";
+void Psyz_VideoSetFsr1(int enabled, int sharpness) {
+    enabled = enabled != 0;
+    sharpness = SDL_clamp(sharpness, 0, 2);
+    if (enabled != pe2_fsr1_requested || sharpness != pe2_fsr1_sharpness) {
+        pe2_fsr1_failed = 0;
+        pe2_fsr1_effective = enabled ? 1 : 0;
+        pe2_fsr1_reason = enabled ? "awaiting-presentation" : "off";
+    }
+    pe2_fsr1_requested = enabled;
+    pe2_fsr1_sharpness = sharpness;
+}
+int Psyz_VideoGetFsr1Requested(void) { return pe2_fsr1_requested; }
+int Psyz_VideoGetFsr1Sharpness(void) { return pe2_fsr1_sharpness; }
+int Psyz_VideoGetFsr1Status(void) { return pe2_fsr1_effective; }
+const char *Psyz_VideoGetFsr1Reason(void) { return pe2_fsr1_reason; }
+static void Pe2Fsr1Status(const char *reason, int recorded) {
+    pe2_fsr1_reason = reason;
+    pe2_fsr1_effective = !pe2_fsr1_requested ? 0 :
+        pe2_fsr1_failed ? 3 : recorded ? 2 : 1;
+}
+/* Wire to every failed command submission/fence acquisition/wait. A failed
+ * frame must not leave a previously recorded result reported as effective. */
+static void Pe2Fsr1Failure(void) {
+    pe2_fsr1_failed = 1;
+    Pe2Fsr1Status("original-gpu-failure-latched", 0);
+}
+static SDL_GPUBlitRegion Pe2Fsr1Present(SDL_GPUCommandBuffer *cmd,
+    SDL_GPUBlitRegion src, SDL_Rect dst) {
+    if (!pe2_fsr1_requested) { Pe2Fsr1Status("off", 0); return src; }
+    if (pe2_fsr1_failed) { Pe2Fsr1Status("original-error-latched", 0); return src; }
+    if (!device || !cmd || !src.texture || dst.w <= 0 || dst.h <= 0 || !src.w || !src.h) {
+        Pe2Fsr1Status("original-invalid-input", 0); return src;
+    }
+    if (src.w > (Uint32)dst.w || src.h > (Uint32)dst.h) {
+        Pe2Fsr1Status("original-downscale", 0); return src;
+    }
+    if (src.w > 8192 || src.h > 8192 || dst.w > 8192 || dst.h > 8192 ||
+        (uint64_t)src.w * src.h * 4 + (uint64_t)dst.w * dst.h * 16 > 160u * 1024u * 1024u) {
+        Pe2Fsr1Status("original-budget", 0); return src;
+    }
+    if (!pe2_fsr1_state) {
+        pe2_fsr1_state = CpeFsr1_Create(device);
+        if (!pe2_fsr1_state) {
+            pe2_fsr1_failed = 1; Pe2Fsr1Status("original-pipeline-failed", 0); return src;
+        }
+        CpeFsr1_SetEnabled(pe2_fsr1_state, true);
+    }
+    if (!pe2_fsr1_input || pe2_fsr1_iw != src.w || pe2_fsr1_ih != src.h) {
+        SDL_GPUTextureCreateInfo t = {0};
+        t.type = SDL_GPU_TEXTURETYPE_2D;
+        t.format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+        t.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER | SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;
+        t.width = src.w; t.height = src.h; t.layer_count_or_depth = 1;
+        t.num_levels = 1; t.sample_count = SDL_GPU_SAMPLECOUNT_1;
+        SDL_GPUTexture *replacement = SDL_CreateGPUTexture(device, &t);
+        if (!replacement) {
+            pe2_fsr1_failed = 1; Pe2Fsr1Status("original-input-allocation-failed", 0); return src;
+        }
+        /* SDL defers release until its recorded references retire; texture
+         * cycling below protects reuse while prior frames remain in flight. */
+        if (pe2_fsr1_input) SDL_ReleaseGPUTexture(device, pe2_fsr1_input);
+        pe2_fsr1_input = replacement; pe2_fsr1_iw = src.w; pe2_fsr1_ih = src.h;
+    }
+    /* Compact crop prevents EASU gathers sampling neighboring VRAM pages. */
+    SDL_GPUBlitInfo crop = {0};
+    crop.source = src;
+    crop.destination = (SDL_GPUBlitRegion){.texture=pe2_fsr1_input,.w=src.w,.h=src.h};
+    crop.load_op = SDL_GPU_LOADOP_DONT_CARE;
+    crop.filter = SDL_GPU_FILTER_NEAREST; crop.cycle = true;
+    SDL_BlitGPUTexture(cmd, &crop);
+    SDL_GPUTexture *filtered = CpeFsr1_Record(pe2_fsr1_state, cmd, pe2_fsr1_input,
+        src.w, src.h, (Uint32)dst.w, (Uint32)dst.h, (float)pe2_fsr1_sharpness);
+    if (!filtered) {
+        pe2_fsr1_failed = 1; Pe2Fsr1Status("original-filter-failed", 0); return src;
+    }
+    Pe2Fsr1Status("EASU+RCAS-recorded", 1);
+    return (SDL_GPUBlitRegion){.texture=filtered,.w=(Uint32)dst.w,.h=(Uint32)dst.h};
+}
+static void Pe2Fsr1Destroy(void) {
+    /* Caller MUST successfully retire outstanding GPU work before this hook,
+     * and retain the same device until both provider and input are released. */
+    if (pe2_fsr1_input) SDL_ReleaseGPUTexture(device, pe2_fsr1_input);
+    pe2_fsr1_input = NULL; pe2_fsr1_iw = pe2_fsr1_ih = 0;
+    CpeFsr1_Destroy(pe2_fsr1_state); pe2_fsr1_state = NULL;
+    pe2_fsr1_failed = 0;
+    Pe2Fsr1Status(pe2_fsr1_requested ? "awaiting-presentation" : "off", 0);
+}
diff --git a/psyz/src/platform/pe2_presentation_stats.h b/psyz/src/platform/pe2_presentation_stats.h
new file mode 100644
index 0000000000000000000000000000000000000000..bf64e26393504b04dd8be6dd08b5a67bf9ae88f8
--- /dev/null
+++ b/psyz/src/platform/pe2_presentation_stats.h
@@ -0,0 +1,34 @@
+/* MPL-2.0. Policy adapted from PE1 Build17 accepted-display counters.
+ * Included after renderer state; no new command buffers or simulation clocks. */
+#ifndef PE2_PRESENTATION_STATS_IMPL_H
+#define PE2_PRESENTATION_STATS_IMPL_H
+#include <psyz/presentation_stats.h>
+static uint64_t pe2_presented_total,pe2_presented_mid,pe2_present_window_frames;
+static Uint64 pe2_present_window_ns,pe2_present_last_ns;
+static float pe2_presented_fps;
+int Psyz_GpuPresentationStatsVisible(void) {
+ return !ws_capture_active&&!hidden_gpu_renderer&&!headless_renderer&&!debug_show_vram;
+}
+static void Pe2RecordAcceptedPresent(int interpolated) {
+ Uint64 now=SDL_GetTicksNS();
+ if(pe2_presented_total!=UINT64_MAX)++pe2_presented_total;
+ if(interpolated&&pe2_presented_mid!=UINT64_MAX)++pe2_presented_mid;
+ if(!pe2_present_last_ns||now<pe2_present_last_ns||now-pe2_present_last_ns>2000000000ULL) {
+  pe2_present_window_ns=now;pe2_present_window_frames=0;pe2_presented_fps=0;
+ } else {
+  ++pe2_present_window_frames;
+  Uint64 elapsed=now-pe2_present_window_ns;
+  if(elapsed>=1000000000ULL) {
+   pe2_presented_fps=(float)((double)pe2_present_window_frames*1000000000.0/(double)elapsed);
+   pe2_present_window_frames=0;pe2_present_window_ns=now;
+  }
+ }
+ pe2_present_last_ns=now;
+}
+uint64_t Psyz_GpuGetPresentedFrameCount(void){return pe2_presented_total;}
+uint64_t Psyz_GpuGetAcceptedInterpolatedFrameCount(void){return pe2_presented_mid;}
+float Psyz_GpuGetPresentedFps(void) {
+ Uint64 now=SDL_GetTicksNS();
+ return !pe2_present_last_ns||now<pe2_present_last_ns||now-pe2_present_last_ns>2000000000ULL?0:pe2_presented_fps;
+}
+#endif
diff --git a/psyz/src/platform/pe2_shadow_metadata.h b/psyz/src/platform/pe2_shadow_metadata.h
new file mode 100644
index 0000000000000000000000000000000000000000..44d950c55ea967836cb1d9d98276a8a4487053f3
--- /dev/null
+++ b/psyz/src/platform/pe2_shadow_metadata.h
@@ -0,0 +1,79 @@
+/* MPL-2.0. Original bounded metadata implementation; no game/private data. */
+#ifndef PE2_SHADOW_METADATA_H
+#define PE2_SHADOW_METADATA_H
+#include <psyz/shadow_metadata.h>
+enum { SHADOW_RECORDS=4 };
+typedef struct { uintptr_t payload; PsyzShadowBatch batch; } ShadowRecord;
+static ShadowRecord shadow_records[SHADOW_RECORDS];
+static int shadow_mode;
+static uint64_t shadow_epoch;
+static const char *shadow_status="Off";
+static SDL_GPUCommandBuffer *shadow_credit_command;
+static uint64_t shadow_credit_failure;
+static uint64_t shadow_command_generation,shadow_credit_generation;
+static unsigned shadow_credit;
+static int shadow_credit_owned;
+static int shadow_flush_success;
+static void ShadowClearCredit(void) {
+    shadow_credit=0;shadow_credit_owned=0;shadow_credit_command=NULL;shadow_credit_generation=0;
+}
+static void ShadowInvalidate(void) {
+    memset(shadow_records,0,sizeof(shadow_records));ShadowClearCredit();
+    shadow_status=shadow_mode?"Original (renderer reset or failure)":"Off";
+}
+int Psyz_GpuGetShadowMode(void) { return shadow_mode; }
+const char *Psyz_GpuShadowStatus(void) { return shadow_status; }
+void Psyz_GpuShadowBeginEpoch(uint64_t epoch) {
+    if(epoch==UINT64_MAX)epoch=0;
+    if(epoch!=shadow_epoch || !epoch) {
+        memset(shadow_records,0,sizeof(shadow_records));shadow_epoch=epoch;
+        shadow_status=shadow_mode==PSYZ_SHADOW_RAW_PEAK_EXPERIMENTAL?"Waiting for experimental source-peak shadow":
+            shadow_mode?"Waiting for supported modulated shadow":"Off";
+    }
+}
+int Psyz_GpuShadowRegister(const void *payload,const PsyzShadowBatch *batch) {
+    if(!shadow_mode||!payload||!batch||!shadow_epoch||batch->epoch!=shadow_epoch||
+       !batch->count||batch->count>PSYZ_SHADOW_RUN_LIMIT)return 0;
+    uint32_t now[9];memcpy(now,payload,sizeof now);
+    if(memcmp(now,batch->packet,sizeof now)||((now[4]>>16)&0x60)!=0x40)return 0;
+    unsigned code=now[0]>>24;
+    if(code==0x2f) {
+        /* Authoritative raw ownership comes from the exact original body,
+         * never from caller bool or fake shade-valid state. CPU capture has
+         * no intensity proof here; only traversal may derive effective shade. */
+        if(shadow_mode!=PSYZ_SHADOW_RAW_PEAK_EXPERIMENTAL||batch->sourceRaw!=1||
+           batch->sourcePolicy!=PSYZ_SHADOW_SOURCE_RAW_PEAK||batch->shadeValid||batch->shade||
+           ((now[4]>>16)&0x180))return 0;
+    } else if(code==0x2e) {
+        unsigned shade=now[0]&255;
+        if(batch->sourceRaw||batch->sourcePolicy!=PSYZ_SHADOW_SOURCE_CONSTANT||
+           !batch->shadeValid||!batch->shade||batch->shade>24||!shade||
+           ((now[0]>>8)&255)!=shade||((now[0]>>16)&255)!=shade||
+           batch->shade!=(shade/3>24?24:shade/3))return 0;
+    } else return 0;
+    for(unsigned r=0;r<batch->count;++r) {
+        const int16_t *q=batch->xy[r];
+        for(unsigned v=0;v<8;++v) if(q[v]<-1024||q[v]>1023)return 0;
+        int64_t a=(int64_t)(q[2]-q[0])*(q[5]-q[1])-(int64_t)(q[3]-q[1])*(q[4]-q[0]);
+        int64_t b=(int64_t)(q[6]-q[2])*(q[5]-q[3])-(int64_t)(q[7]-q[3])*(q[4]-q[2]);
+        if(!a||!b||(a>0)!=(b>0))return 0;
+    }
+    for(unsigned i=0;i<SHADOW_RECORDS;++i) if(shadow_records[i].payload==(uintptr_t)payload)
+        shadow_records[i].payload=0;
+    for(unsigned i=0;i<SHADOW_RECORDS;++i) if(!shadow_records[i].payload) {
+        shadow_records[i].payload=(uintptr_t)payload;shadow_records[i].batch=*batch;return 1;
+    }
+    shadow_status="Original (shadow metadata budget)";return 0;
+}
+static void ShadowCopy(const void *from,const void *to) {
+    ShadowRecord value={0};
+    for(unsigned i=0;i<SHADOW_RECORDS;++i) {
+        if(shadow_records[i].payload==(uintptr_t)from) {value=shadow_records[i];shadow_records[i].payload=0;}
+        if(shadow_records[i].payload==(uintptr_t)to) shadow_records[i].payload=0;
+    }
+    if(!value.payload)return;
+    for(unsigned i=0;i<SHADOW_RECORDS;++i) if(!shadow_records[i].payload) {
+        value.payload=(uintptr_t)to;shadow_records[i]=value;return;
+    }
+}
+#endif
diff --git a/psyz/src/platform/pe2_shadow_render.h b/psyz/src/platform/pe2_shadow_render.h
new file mode 100644
index 0000000000000000000000000000000000000000..e93e5601ef6fcbe441cace57fd17797ffd3398e2
--- /dev/null
+++ b/psyz/src/platform/pe2_shadow_render.h
@@ -0,0 +1,139 @@
+/* MPL-2.0. Original packet-local fixed-budget GPU queue adapter. Geometry/
+ * strength policy follows the explicitly MIT PE1 planar shadow reference;
+ * source proof is independently bound to actual PE2 original texture words. */
+#ifndef PE2_SHADOW_RENDER_H
+#define PE2_SHADOW_RENDER_H
+void Psyz_GpuSetShadowMode(int mode) {
+    if(mode<PSYZ_SHADOW_OFF||mode>PSYZ_SHADOW_RAW_PEAK_EXPERIMENTAL||mode==shadow_mode)return;
+    shadow_mode=mode;ShadowInvalidate();
+    Psyz_FontIdentityCaptureEnable(device&&is_platform_init_successful);
+}
+static int ShadowSourceConstant(const uint32_t packet[9],unsigned *sample_u,unsigned *sample_v) {
+    unsigned page=packet[4]>>16,clut=packet[2]>>16;
+    if(page&~0x1ffu||((page>>5)&3)!=2||cur_twin!=TWIN_PACK(255,255,0,0))return 0;
+    unsigned left=255,right=0,top=255,bottom=0;
+    for(unsigned i=0;i<4;++i) {
+        unsigned uv=packet[2+i*2],u=uv&255,v=(uv>>8)&255;
+        if(u<left)left=u;if(u>right)right=u;if(v<top)top=v;if(v>bottom)bottom=v;
+    }
+    uint16_t first=0;
+    for(unsigned y=top;y<=bottom;++y)for(unsigned x=left;x<=right;++x) {
+        uint16_t word;
+        if(!Psyz_FontIdentitySample(page,clut,x,y,&word))return 0;
+        unsigned r=word&31,g=(word>>5)&31,b=(word>>10)&31;
+        if(!(word&0x8000)||r<8||r!=g||g!=b)return 0;
+        if(x==left&&y==top)first=word;else if(word!=first)return 0;
+    }
+    /* Actual original first UV is equivalent only after the full bounds are
+     * proven constant. No center, palette average or generic-white shortcut. */
+    *sample_u=packet[2]&255;*sample_v=(packet[2]>>8)&255;return 1;
+}
+/* Experimental PE2-only raw policy. Every actual packed texel and referenced
+ * CLUT word must be upload-known over the exact original canonical rectangle.
+ * Transparent word0 is retained as source proof, not converted to opacity.
+ * Visible color/non-STP words reject the entire source. Peak is a measured
+ * authored channel value; no representative UV, averaging or white is assumed. */
+static int ShadowSourceRawPeak(const uint32_t packet[9],unsigned *shade) {
+    unsigned page=packet[4]>>16,clut=packet[2]>>16;
+    if(!shade||packet[0]>>24!=0x2f||page&~0x1ffu||page&0x180u||
+       ((page>>5)&3)!=2||cur_twin!=TWIN_PACK(255,255,0,0))return 0;
+    unsigned u[4],v[4];
+    for(unsigned i=0;i<4;++i){u[i]=packet[2+i*2]&255;v[i]=(packet[2+i*2]>>8)&255;}
+    if(u[0]>=u[1]||v[0]>=v[2]||u[2]!=u[0]||u[3]!=u[1]||v[1]!=v[0]||v[3]!=v[2])return 0;
+    unsigned peak=0;
+    for(unsigned y=v[0];y<=v[2];++y)for(unsigned x=u[0];x<=u[1];++x) {
+        uint16_t word;
+        if(!Psyz_FontIdentitySample(page,clut,x,y,&word))return 0;
+        if(!word)continue;
+        unsigned r=word&31,g=(word>>5)&31,b=(word>>10)&31;
+        if(!(word&0x8000)||r!=g||g!=b)return 0;
+        if(r>peak)peak=r;
+    }
+    if(!peak)return 0;
+    /* Explicit RGB555->8-bit bit replication is part of this experimental
+     * policy. Apply peak exactly once as flat tint, never sample/multiply it
+     * a second time through a textured carrier. */
+    unsigned peak8=(peak<<3)|(peak>>2);
+    *shade=peak8/3;if(*shade>24)*shade=24;
+    return *shade!=0;
+}
+static int ShadowTryDraw(u_long *payload,int words) {
+    PsyzShadowBatch batch={0};
+    for(unsigned i=0;i<SHADOW_RECORDS;++i)if(shadow_records[i].payload==(uintptr_t)payload) {
+        batch=shadow_records[i].batch;shadow_records[i].payload=0;break;
+    }
+    if(batch.count)shadow_status="Original (shadow admission unavailable)";
+    if(!batch.count||!shadow_mode||batch.epoch!=shadow_epoch||words<9)return 0;
+    for(unsigned i=0;i<9;++i)if((uint64_t)payload[i]!=batch.packet[i])return 0;
+    if(!device||!vtx_transfer||!vbuf||!ibuf||!vram_render||!vram_sample||!blend_sample||
+       shadow_credit_owned||pe2_bg_failure_serial==UINT64_MAX||shadow_command_generation==UINT64_MAX)return 0;
+    unsigned vertices=batch.count*6,indices=vertices;
+    if(vertices>MAX_VERTEX_COUNT||indices>MAX_INDEX_COUNT)return 0;
+    uint64_t before=pe2_bg_failure_serial;
+    /* Complete preceding geometry before reserving this one owned batch. */
+    Draw_FlushBuffer();
+    if(n_vertices||n_indices||before!=pe2_bg_failure_serial)return 0;
+    unsigned u=0,v=0,effective_shade=batch.shade;
+    int raw_peak=batch.sourceRaw==1&&batch.sourcePolicy==PSYZ_SHADOW_SOURCE_RAW_PEAK;
+    if(raw_peak) {
+        if(shadow_mode!=PSYZ_SHADOW_RAW_PEAK_EXPERIMENTAL||batch.shadeValid||batch.shade||
+           !ShadowSourceRawPeak(batch.packet,&effective_shade)) {
+            shadow_status="Original (experimental raw source proof unavailable)";return 0;
+        }
+    } else if(batch.sourceRaw||batch.sourcePolicy!=PSYZ_SHADOW_SOURCE_CONSTANT||
+              !ShadowSourceConstant(batch.packet,&u,&v)) {
+        shadow_status="Original (source texture is not proven constant)";return 0;
+    }
+    unsigned targets=(scaled_vram_render?2u:1u)+
+        (interpolation_enabled&&interpolated_vram&&interpolated_scale==internal_res?1u:0u);
+    unsigned descriptors=batch.count*12u*targets;
+    /* SDL backends without the optional global rollover limit still receive
+     * this fixed conservative per-shadow command cap. */
+    unsigned budget=command_descriptor_limit?command_descriptor_limit:1024u;
+    if(descriptors>budget) {
+        shadow_status="Original (whole shadow exceeds draw budget)";return 0;
+    }
+    if(command_descriptors>budget-descriptors) {
+        if(!SubmitCmd()||before!=pe2_bg_failure_serial)return 0;
+    }
+    SDL_GPUCommandBuffer *command=ReserveDrawDescriptors(descriptors);
+    if(!command||before!=pe2_bg_failure_serial||shadow_command_generation==UINT64_MAX)return 0;
+    shadow_credit_command=command;shadow_credit_failure=before;shadow_credit_generation=shadow_command_generation;
+    shadow_credit=descriptors;shadow_credit_owned=1;shadow_flush_success=0;
+    /* No fallible operation or per-primitive flush remains before the complete
+     * batch is copied into already-reserved fixed CPU vertex/index arrays. */
+    static const unsigned corners[6]={0,1,2,1,3,2};
+    Vertex pending[PSYZ_SHADOW_RUN_LIMIT*6];
+    memset(pending,0,vertices*sizeof(*pending));
+    for(unsigned r=0;r<batch.count;++r)for(unsigned j=0;j<6;++j) {
+        Vertex *out=&pending[r*6+j];unsigned corner=corners[j];
+        out->x=batch.xy[r][corner*2];out->y=batch.xy[r][corner*2+1];
+        out->u=u;out->v=v;out->r=out->g=out->b=(unsigned char)effective_shade;out->a=0x80;
+        out->pgxp_pos[2]=-1.0f;
+    }
+    for(unsigned i=0;i<vertices;i+=3)SetPolygonAttributes(pending+i);
+    unsigned page=batch.packet[4]>>16;
+    if(raw_peak)page|=TPAGE_NOTEXTURE;
+    if(CanPolyDither(false,!raw_peak,true))page|=TPAGE_DITHER;
+    for(unsigned i=0;i<vertices;++i) {
+        SET_TC(&pending[i],page|TPAGE_POLYGON,batch.packet[2]>>16);
+        index_cur[i]=(unsigned short)i;
+    }
+    memcpy(vertex_cur,pending,vertices*sizeof(*pending));
+    /* Shadow run geometry is source-owned but not a separately matched model
+     * interpolation packet. Preserve interpolation policy without borrowing
+     * the original blob packet's motion identity. */
+    const void *old_packet=interpolation_packet_current;interpolation_packet_current=NULL;
+    Draw_EnqueueBuffer((int)vertices,(int)indices);
+    interpolation_packet_current=old_packet;batch_has_texture=!raw_peak;
+    Draw_FlushBuffer();
+    int accepted=before==pe2_bg_failure_serial&&shadow_flush_success;
+    ShadowClearCredit();
+    shadow_status=accepted?(raw_peak?"Experimental source-peak silhouette queued (unconfirmed)":
+        "Shadow replacement queued (not visually confirmed)"):
+        "Shadow queue failed (original GPU submission unavailable)";
+    /* CPU admission committed the whole replacement. Never enqueue the blob
+     * after a partly recorded GPU command batch and darken it twice. */
+    return 1;
+}
+#endif
diff --git a/psyz/src/platform/pe2_ui_font.h b/psyz/src/platform/pe2_ui_font.h
new file mode 100644
index 0000000000000000000000000000000000000000..3089cdc6f5693159c6074364f2b4de23b3bd3e03
--- /dev/null
+++ b/psyz/src/platform/pe2_ui_font.h
@@ -0,0 +1,171 @@
+/* MPL-2.0. Producer-owned PE2 UI face metrics + accepted original ink.
+ * Replacement styles Plex, Retro and Atkinson. No embedded source pixels/private bindings. */
+#ifndef PE2_UI_FONT_H
+#define PE2_UI_FONT_H
+/* Up to three faces/three styles/two source generations. Immutable atlas keys
+ * are never recycled; exhaustion leaves original presentation. */
+enum { UI_FACE_GLYPHS=95, UI_FACE_RECORDS=18, UI_FACE_PAGE=31, UI_FACE_FILL=0x7ffd };
+typedef struct {
+    unsigned face,style;
+    uint64_t key;
+    PsyzUiFontMetric metrics[UI_FACE_GLYPHS];
+    PsyzFontToken tokens[3];
+    PsyzFontIdentity identities[3];
+    unsigned char supported[UI_FACE_GLYPHS];
+} PlexUiFace;
+static PlexUiFace plex_ui_faces[UI_FACE_RECORDS];
+static unsigned plex_ui_face_count;
+static PlexUiFace *plex_ui_prepared[3];
+static uint64_t plex_ui_face_serial=1;
+static int PlexUiFaceLive(const PlexUiFace *f)
+{
+    return f && Psyz_FontIdentityValidate(&f->tokens[0]) &&
+        Psyz_FontIdentityValidate(&f->tokens[1]) && Psyz_FontIdentityValidate(&f->tokens[2]);
+}
+static int PlexUiFaceEqual(const PlexUiFace *f,const PsyzUiFontMetric *m)
+{
+    for(unsigned i=0;i<UI_FACE_GLYPHS;++i){const PsyzUiFontMetric *a=&f->metrics[i],*b=&m[i];
+        if(a->character!=b->character||a->u!=b->u||a->v!=b->v||a->width!=b->width||a->height!=b->height||
+           a->xOffset!=b->xOffset||a->yOffset!=b->yOffset||a->advance!=b->advance||a->advanceY!=b->advanceY||a->leftKerningClass!=b->leftKerningClass||a->rightKerningClass!=b->rightKerningClass)return 0;
+    }return 1;
+}
+static int PlexUiFaceInk(const PsyzUiFontMetric *m,int bounds[4])
+{
+    bounds[0]=m->width;bounds[1]=m->height;bounds[2]=bounds[3]=-1;
+    for(int y=0;y<m->height;++y)for(int x=0;x<m->width;++x){uint16_t word;
+        if(!Psyz_FontIdentitySample(UI_FACE_PAGE,UI_FACE_FILL,m->u+x,m->v+y,&word))return 0;
+        /* Real fill CLUT: nonzero words are visible original fill coverage. */
+        if(word){bounds[0]=SDL_min(bounds[0],x);bounds[1]=SDL_min(bounds[1],y);
+            bounds[2]=SDL_max(bounds[2],x);bounds[3]=SDL_max(bounds[3],y);}
+    }return bounds[2]>=bounds[0]&&bounds[3]>=bounds[1];
+}
+static int PlexUiFaceRaster(SDL_Surface *surface,const stbtt_fontinfo *font,
+                            const PsyzUiFontMetric *m,unsigned index,float nativeScaleY)
+{
+    int ink[4],fx0,fy0,fx1,fy1;
+    if(m->character==' ')return 1;
+    if(!PlexUiFaceInk(m,ink)||!stbtt_GetCodepointBox(font,m->character,&fx0,&fy0,&fx1,&fy1)||fx1<=fx0)return 0;
+    /* Actual source fill interval, not the crop width or TTF advance. Quarter
+     * native pixel on both sides reserves the original contour/spacing. */
+    float nativeScaleX=(ink[2]-ink[0]+0.5f)/(fx1-fx0);
+    float sx=nativeScaleX*64.0f/m->width,sy=nativeScaleY*64.0f/m->height;
+    float left=(ink[0]+0.25f)*64.0f/m->width;
+    float baseline=(m->height-1.0f-m->yOffset)*64.0f/m->height;
+    int x0,y0,x1,y1;
+    stbtt_GetCodepointBitmapBox(font,m->character,sx,sy,&x0,&y0,&x1,&y1);
+    int width=x1-x0,height=y1-y0;
+    if(width<=0||height<=0||width>64||height>64)return 0;
+    /* Position bitmap by its actual scaled bearing and shared native baseline.
+     * Exact bounded containment: unsupported glyph stays original, never clips. */
+    int dx=(int)SDL_ceilf(left),dy=(int)SDL_roundf(baseline)+y0;
+    float right=(ink[2]+0.75f)*64.0f/m->width;
+    if(dx<1||dy<1||dx+width>63||dy+height>63||dx+width>right+0.001f)return 0;
+    unsigned char bitmap[64*64]={0};
+    stbtt_MakeCodepointBitmap(font,bitmap,width,height,64,sx,sy,m->character);
+    for(unsigned outline=0;outline<2;++outline){unsigned cell=index+outline*95;
+        unsigned ox=(cell%16)*68+2,oy=(cell/16)*68+2;
+        for(int y=0;y<64;++y)for(int x=0;x<64;++x){unsigned alpha=0;
+            int xx=x-dx,yy=y-dy;
+            if(xx>=0&&yy>=0&&xx<width&&yy<height)alpha=bitmap[yy*64+xx];
+            /* Half-atlas-pixel contour stays in the proven original ink slot. */
+            if(outline&&x>=ink[0]*64/m->width&&x<(ink[2]+1)*64/m->width)
+                for(int j=-1;j<=1;++j)for(int i=-1;i<=1;++i){int bx=xx+i,by=yy+j;
+                    if(bx>=0&&by>=0&&bx<width&&by<height)alpha=SDL_max(alpha,bitmap[by*64+bx]);}
+            unsigned char *pixel=(unsigned char*)surface->pixels+(oy+y)*surface->pitch+(ox+x)*4;
+            pixel[0]=pixel[1]=pixel[2]=255;pixel[3]=(unsigned char)alpha;
+        }
+    }return 1;
+}
+int Psyz_GpuPreparePlexUiFace(unsigned face,const PsyzUiFontMetric *metrics,unsigned count)
+{
+    if(face>=3)return 0;
+    plex_ui_prepared[face]=NULL;
+    unsigned style=plex_font_styles[PSYZ_FONT_MENU];
+    if(!metrics||count!=UI_FACE_GLYPHS||style<PSYZ_FONT_PLEX||style>PSYZ_FONT_ATKINSON||
+        !PlexBackendSupported()||!device||UseSoftwareBackend()||Psyz_VideoGetInternalResolution()<=1)return 0;
+    for(unsigned n=0;n<plex_ui_face_count;++n){PlexUiFace *f=&plex_ui_faces[n];
+        if(f->face==face&&f->style==style&&PlexUiFaceEqual(f,metrics)&&PlexUiFaceLive(f))
+            for(unsigned i=0;i<sprite_atlas_count;++i)if(sprite_atlases[i].key==f->key){plex_ui_prepared[face]=f;return 1;}
+    }
+    PlexUiFace pending={0};pending.face=face;pending.style=style;
+    unsigned left=256,top=256,right=0,bottom=0;
+    for(unsigned i=0;i<count;++i){const PsyzUiFontMetric *m=&metrics[i];
+        if(m->character!=i+32)return 0;
+        pending.metrics[i]=*m;
+        if(!m->width&&!m->height)continue; /* Explicit absent small-face cell. */
+        if(m->width<=0||m->height<=0||m->width>64||m->height>64||m->u>255||m->v>255||
+           m->u+(unsigned)m->width>256||m->v+(unsigned)m->height>256||
+           m->xOffset< -64||m->xOffset>64||m->yOffset< -64||m->yOffset>64||m->advance< -64||m->advance>128)return 0;
+        left=SDL_min(left,m->u);top=SDL_min(top,m->v);
+        right=SDL_max(right,m->u+m->width);bottom=SDL_max(bottom,m->v+m->height);
+    }
+    if(right<=left||bottom<=top)return 0;
+    for(unsigned i=0;i<3;++i){PsyzFontRegion region={UI_FACE_PAGE,UI_FACE_FILL+i,left,top,right-left,bottom-top};
+        if(!Psyz_FontIdentityAcquire(&region,&pending.identities[i],&pending.tokens[i]))return 0;
+    }
+    /* Same actual bytes may be uploaded again with a new lifetime token. Rebind
+     * only identical immutable metrics+texture+all CLUT hashes, never a pointer.
+     * Already queued marks retain their old token and therefore fall back. */
+    for(unsigned n=0;n<plex_ui_face_count;++n){PlexUiFace *f=&plex_ui_faces[n];
+        if(f->face!=face||f->style!=style||!PlexUiFaceEqual(f,metrics))continue;
+        int same=1;
+        for(unsigned i=0;i<3;++i)for(unsigned j=0;j<2;++j)
+            if(f->identities[i].texture[j]!=pending.identities[i].texture[j]||
+               f->identities[i].palette[j]!=pending.identities[i].palette[j])same=0;
+        if(same)for(unsigned i=0;i<sprite_atlas_count;++i)if(sprite_atlases[i].key==f->key){
+            for(unsigned j=0;j<3;++j)f->tokens[j]=pending.tokens[j];
+            plex_ui_prepared[face]=f;return 1;
+        }
+    }
+    if(plex_ui_face_count>=UI_FACE_RECORDS||plex_ui_face_serial>UINT16_MAX)return 0;
+    const unsigned char *data=PlexProfileData(style);stbtt_fontinfo font;
+    if(!data)return 0;int offset=stbtt_GetFontOffsetForIndex(data,0);
+    if(offset<0||!stbtt_InitFont(&font,data,offset))return 0;
+    /* Actual original H fill establishes a single native cap-height scale.
+     * All glyphs share that Y scale and the original pen baseline; a glyph
+     * that cannot fit its authored crop is unsupported for the whole run. */
+    int ink[4],x0,y0,x1,y1;const PsyzUiFontMetric *cap=&metrics['H'-32];
+    if(!PlexUiFaceInk(cap,ink)||!stbtt_GetCodepointBox(&font,'H',&x0,&y0,&x1,&y1)||y1<=y0)return 0;
+    float scale=(ink[3]-ink[1]+0.5f)/(y1-y0);
+    SDL_Surface *surface=SDL_CreateSurface(16*68,12*68*2,SDL_PIXELFORMAT_RGBA32);
+    if(!surface)return 0;
+    SDL_memset(surface->pixels,0,(size_t)surface->pitch*surface->h);
+    for(unsigned i=0;i<count;++i)if(metrics[i].width&&metrics[i].height)
+        pending.supported[i]=(unsigned char)PlexUiFaceRaster(surface,&font,&metrics[i],i,scale);
+#ifdef PE2_NATIVE_Q12
+    Pe2MenuSoftenFill(surface);
+#endif
+    pending.key=UINT64_C(0x5045325549460000)|plex_ui_face_serial++;
+    if(!PlexUiFaceLive(&pending)){SDL_DestroySurface(surface);return 0;}
+    if(LoadSpriteAtlasSurface(pending.key,surface)!=1)return 0;
+    plex_ui_faces[plex_ui_face_count]=pending;plex_ui_prepared[face]=&plex_ui_faces[plex_ui_face_count++];
+    return 1;
+}
+int Psyz_GpuPreparePlexUiFaceBudget(unsigned payloadBudget)
+{ return payloadBudget && payloadBudget<=8192 && PlexCapacity(plex_cap_reserved+payloadBudget); }
+int Psyz_GpuPlexUiFaceSupports(unsigned face,unsigned character)
+{
+    if(face>=3||character<32||character>126)return 0;
+    PlexUiFace *f=plex_ui_prepared[face];
+    return Psyz_VideoGetInternalResolution()>1&&PlexUiFaceLive(f)&&f->style==plex_font_styles[PSYZ_FONT_MENU]&&f->supported[character-32];
+}
+void Psyz_GpuMarkPlexUiFace(const void *payload,unsigned character,int outline,unsigned face)
+{
+    PlexMark *mark=PlexLookup(payload,1);if(!mark)return;mark->packet=(const void*)1;
+    if(!Psyz_GpuPlexUiFaceSupports(face,character))return;
+    PlexUiFace *f=plex_ui_prepared[face];mark->packet=payload;mark->kind=PLEX_KIND_UI_FACE;
+    mark->cell=character-32+(outline?95:0);mark->atlas_key=f->key;mark->token=f->tokens[0];
+}
+static int PlexUiFacePacket(const PlexMark *mark,const u_long *packet,int length,unsigned page)
+{
+    if(Psyz_VideoGetInternalResolution()<=1||!Psyz_FontIdentityValidate(&mark->token)||length<4||(packet[0]>>24&~3u)!=0x64||(page&0x19f)!=UI_FACE_PAGE)return 0;
+    for(unsigned i=0;i<plex_ui_face_count;++i){const PlexUiFace *f=&plex_ui_faces[i];
+        if(f->key!=mark->atlas_key)continue;
+        unsigned cell=mark->cell%95;if(!PlexUiFaceLive(f)||!f->supported[cell])return 0;
+        const PsyzUiFontMetric *m=&f->metrics[cell];unsigned clut=packet[2]>>16;
+        return (packet[2]&255)==m->u&&((packet[2]>>8)&255)==m->v&&
+            (packet[3]&65535)==(unsigned)m->width&&(packet[3]>>16)==(unsigned)m->height&&
+            clut>=UI_FACE_FILL&&clut<=UI_FACE_FILL+2;
+    }return 0;
+}
+#endif
diff --git a/psyz/src/platform/pe2_wide_background_bind.h b/psyz/src/platform/pe2_wide_background_bind.h
new file mode 100644
index 0000000000000000000000000000000000000000..f2588c2253cbb8bcd09fca5a583c73d78d73d491
--- /dev/null
+++ b/psyz/src/platform/pe2_wide_background_bind.h
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: MPL-2.0
+ * Renderer-private bounded immutable art/stage transaction. Included after HD helpers. */
+#include "pe2_wide_background_gpu.h"
+static struct {
+    SDL_GPUTexture *art,*stage;
+    Pe2WideGpu *gpu;
+    Pe2WideManifest manifest;
+    uint64_t hash[2],generation,failureSerial;
+    unsigned scale,artW,artH;
+    int attempted,ready;
+} pe2_wide_cache;
+static void Pe2WideRelease(void)
+{
+    /* Caller has retired GPU readers or is terminating the device. */
+    if(pe2_wide_cache.art)SDL_ReleaseGPUTexture(device,pe2_wide_cache.art);
+    if(pe2_wide_cache.stage)SDL_ReleaseGPUTexture(device,pe2_wide_cache.stage);
+    Pe2WideGpuDestroy(pe2_wide_cache.gpu);
+    memset(&pe2_wide_cache,0,sizeof pe2_wide_cache);
+}
+static int Pe2WidePrepare(const Pe2BackgroundFrameReceipt *frame)
+{
+    if(pe2_wide_cache.attempted && pe2_wide_cache.generation==frame->generation &&
+       pe2_wide_cache.scale==internal_res && !memcmp(pe2_wide_cache.hash,frame->sourceHash,16))
+        return pe2_wide_cache.ready && pe2_wide_cache.failureSerial==pe2_bg_failure_serial;
+    /* One source-bound cache, including negative entries. Never free in-flight readers. */
+    Draw_FlushBuffer();
+    if((pending_cmd&&!SubmitCmd())||!SDL_WaitForGPUIdle(device)){Pe2BackgroundFailure();return 0;}
+    Pe2WideRelease();
+    pe2_wide_cache.attempted=1;pe2_wide_cache.generation=frame->generation;
+    pe2_wide_cache.scale=internal_res;memcpy(pe2_wide_cache.hash,frame->sourceHash,16);
+    Pe2WideAsset image={0};
+    if(!Pe2WideLoad(pe2_bg_root,frame->sourceHash,320,240,&image))return 0;
+    unsigned sw=320u*internal_res,sh=240u*internal_res;
+    if((uint64_t)sw*sh*4+image.image.bytes>64u*1024u*1024u){Pe2WideFree(&image);return 0;}
+    SDL_GPUTextureCreateInfo t={0};t.type=SDL_GPU_TEXTURETYPE_2D;
+    t.format=SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;t.layer_count_or_depth=t.num_levels=1;
+    t.width=image.image.width;t.height=image.image.height;t.usage=SDL_GPU_TEXTUREUSAGE_SAMPLER;
+    pe2_wide_cache.art=SDL_CreateGPUTexture(device,&t);
+    t.width=sw;t.height=sh;t.usage=SDL_GPU_TEXTUREUSAGE_SAMPLER|SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;
+    pe2_wide_cache.stage=SDL_CreateGPUTexture(device,&t);
+    SDL_GPUShaderCreateInfo v={0};v.code=cpe_fullscreen_vert;v.code_size=sizeof cpe_fullscreen_vert;
+    v.entrypoint="main";v.format=SDL_GPU_SHADERFORMAT_SPIRV;v.stage=SDL_GPU_SHADERSTAGE_VERTEX;
+    SDL_GPUShader *vs=SDL_CreateGPUShader(device,&v);
+    if(vs){pe2_wide_cache.gpu=Pe2WideGpuCreate(device,vs,t.format);SDL_ReleaseGPUShader(device,vs);}
+    SDL_GPUTransferBufferCreateInfo u={.usage=SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,.size=(Uint32)image.image.bytes};
+    SDL_GPUTransferBuffer *upload=SDL_CreateGPUTransferBuffer(device,&u);
+    void *map=upload?SDL_MapGPUTransferBuffer(device,upload,false):NULL;
+    int good=map&&pe2_wide_cache.art&&pe2_wide_cache.stage&&pe2_wide_cache.gpu;
+    if(good)memcpy(map,image.image.rgba,image.image.bytes);
+    if(map)SDL_UnmapGPUTransferBuffer(device,upload);
+    SDL_GPUCommandBuffer *cmd=good?AcquireCmd():NULL;
+    SDL_GPUCopyPass *copy=cmd?SDL_BeginGPUCopyPass(cmd):NULL;
+    if(copy){SDL_GPUTextureTransferInfo from={.transfer_buffer=upload,.pixels_per_row=image.image.width,.rows_per_layer=image.image.height};
+        SDL_GPUTextureRegion to={.texture=pe2_wide_cache.art,.w=image.image.width,.h=image.image.height,.d=1};
+        SDL_UploadToGPUTexture(copy,&from,&to,false);SDL_EndGPUCopyPass(copy);
+        pe2_wide_cache.manifest=image.manifest;pe2_wide_cache.artW=image.image.width;pe2_wide_cache.artH=image.image.height;
+    }
+    if(upload)SDL_ReleaseGPUTransferBuffer(device,upload);
+    Pe2WideFree(&image);
+    if(!copy){Pe2BackgroundFailure();return 0;}
+    pe2_wide_cache.failureSerial=pe2_bg_failure_serial;pe2_wide_cache.ready=1;return 1;
+}
+static int Pe2WideCommit(const Pe2BackgroundFrameReceipt *frame)
+{
+    /* Version1 accepts only the existing centred/no-field policy. Moving-room
+     * offsets cannot be inferred from a full source or from requested wide. */
+    if(!widescreen||!ws_centred||ws_field||!pe2_bg_root_selected||!pe2_bg_root[0]||UseSoftwareBackend()||
+       !device||!scaled_vram_render||internal_res<2||internal_res>16||
+       display_rgb24||display_size.x!=320||display_size.y!=240||display_area.x!=0||
+       frame->failureSerial!=pe2_bg_failure_serial)return 0;
+    for(unsigned i=0;i<2;i++)if(ws_picture[i].y==(int)frame->nativeY &&
+       (ws_picture[i].shift||ws_picture[i].field||ws_picture[i].ex!=0||ws_picture[i].ey!=0))return 0;
+    uint64_t failure=pe2_bg_failure_serial;
+    if(!Pe2WidePrepare(frame)||failure!=pe2_bg_failure_serial)return 0;
+    Pe2WideScene scene={0};memcpy(scene.sourceHash,frame->sourceHash,16);
+    scene.sourceGeneration=frame->generation;scene.uploadFrameSerial=scene.nativeCompleteSerial=frame->uploadFrameSerial;
+    scene.nativeColumnMask=frame->columnMask;scene.capabilities=PE2_WIDE_REQUIRED_FLAGS;
+    scene.sourceW=scene.cropW=scene.displayW=320;scene.sourceH=scene.cropH=scene.displayH=240;
+    scene.internalScale=internal_res;scene.nativeY=frame->nativeY;
+    scene.nativeTextureW=VRAM_W;scene.nativeTextureH=VRAM_H;
+    scene.targetTextureW=320u*internal_res;scene.targetTextureH=240u*internal_res;
+    scene.artTextureW=pe2_wide_cache.artW;scene.artTextureH=pe2_wide_cache.artH;
+    scene.backendSqueeze=WS_SQUEEZE;scene.gameAspect=4.0f/3.0f;scene.presentViewHalf=213;
+    Pe2WideGpuParameters parameters;
+    if(!Pe2WideBuildParameters(&pe2_wide_cache.manifest,&scene,&parameters))return 0;
+    SDL_GPUTexture *targets[2]={scaled_vram_render,interpolated_scale==internal_res?interpolated_vram:NULL};
+    SDL_GPUCommandBuffer *cmd=ReserveDrawDescriptors(4);
+    if(!cmd||failure!=pe2_bg_failure_serial)return 0;
+    if(!Pe2WideGpuRecord(pe2_wide_cache.gpu,cmd,pe2_wide_cache.stage,pe2_wide_cache.art,vram_render,&pe2_wide_cache.manifest,&scene)){
+        Pe2BackgroundFailure();return 0;}
+    /* All fallible allocations/pass creation completed on PRIVATE stage. Blits
+     * are SDL void recording operations; asynchronous failures hit native latch. */
+    pe2_wide_touched=1;pe2_wide_native_fallback=1;
+    Pe2BackgroundCleanBankClear(frame->nativeY);
+    for(unsigned i=0;i<2;i++)if(targets[i]){
+        SDL_GPUBlitInfo blit={0};blit.source.texture=pe2_wide_cache.stage;
+        blit.source.w=320u*internal_res;blit.source.h=240u*internal_res;
+        blit.destination.texture=targets[i];blit.destination.y=frame->nativeY*internal_res;
+        blit.destination.w=blit.source.w;blit.destination.h=blit.source.h;
+        blit.load_op=SDL_GPU_LOADOP_LOAD;blit.filter=SDL_GPU_FILTER_NEAREST;
+        SDL_BlitGPUTexture(cmd,&blit);
+    }
+    if(failure!=pe2_bg_failure_serial || !Pe2BackgroundDrawLayoutAdmit(frame,pe2_bg_native_epoch,failure,1))return -1;
+    pe2_wide_native_fallback=0;return 1;
+}
+
+const char *Psyz_GpuWideBackgroundStatus(void)
+{
+    if(!widescreen)return "Original";
+    return WidescreenPresentReady()&&!Pe2WideNativePresentation()?"On (matched art)":"Requested (Original fallback)";
+}
diff --git a/psyz/src/platform/pe2_wide_background_cpu.c b/psyz/src/platform/pe2_wide_background_cpu.c
new file mode 100644
index 0000000000000000000000000000000000000000..40f60ec625731b24bf7cc927a213703aa2b5c623
--- /dev/null
+++ b/psyz/src/platform/pe2_wide_background_cpu.c
@@ -0,0 +1,91 @@
+/* PE2 optional source-bound outpaint contract. No artwork is bundled/generated.
+ * Uses existing bounded PNG decoder and existing byte-identity hash service. */
