+    s=line(&lines);if(!s||strcmp(s,"mapping centred-squeeze-3-4"))return 0;
+    s=line(&lines);if(!s||strcmp(s,"opaque 1"))return 0;
+    s=line(&lines);if(!s||strcmp(s,"end")||lines.next!=lines.end)return 0;
