+}
+static Pe2BackgroundRecord *Pe2BackgroundImage(const uint64_t hash[2],unsigned w,unsigned h)
+{
+    for(unsigned i=0;i<pe2_bg_count;i++){
+        Pe2BackgroundRecord *r=&pe2_bg_records[i];
+        if(r->hash[0]==hash[0]&&r->hash[1]==hash[1]&&r->source_w==w&&r->source_h==h)return r;
+    }
+    if(pe2_bg_count==PE2_BG_RECORDS)return NULL;
+    Pe2BackgroundRecord *r=&pe2_bg_records[pe2_bg_count++];
+    r->hash[0]=hash[0];r->hash[1]=hash[1];r->source_w=w;r->source_h=h;
+    Pe2BackgroundPixels image={0};
+    const int loaded=Pe2BackgroundLoad(pe2_bg_root,hash,w,h,&image);
+    static unsigned lookupLogCount;
+    if(lookupLogCount<24){
+        ++lookupLogCount;
+        const char *result="loaded";
+        int error=0;
+        if(!loaded){
+            char filename[1100];
+            int n=SDL_snprintf(filename,sizeof filename,
+                "%s/vram-write-%016llX%016llX.png",pe2_bg_root,
+                (unsigned long long)hash[1],(unsigned long long)hash[0]);
+            if(n<0 || n>=(int)sizeof filename) result="invalid path";
+            else {
+                errno=0;
+                FILE *probe=fopen(filename,"rb");
+                error=errno;
+                if(probe){ fclose(probe); result="decoder rejected or allocation failed"; }
+                else if(error==ENOENT) result="missing";
+                else result="open failed";
+            }
+        }
+        SDL_Log("PE2 HD still %ux%u key=%016llX%016llX root=%s result=%s errno=%d",
+                w,h,(unsigned long long)hash[1],(unsigned long long)hash[0],
+                pe2_bg_root,result,error);
+    }
